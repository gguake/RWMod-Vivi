<?xml version="1.0" encoding="UTF-8"?>
<Defs>
  <HediffDef Name="VV_ScentBase" Abstract="True">
    <hediffClass>VVRace.Hediff_FloralScent</hediffClass>
    <defaultLabelColor>(0.95, 0.75, 1)</defaultLabelColor>
    <isBad>false</isBad>
    <priceImpact>false</priceImpact>
    <scenarioCanAdd>false</scenarioCanAdd>
    <everCurableByItem>false</everCurableByItem>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-2.4</severityPerDay>
        <showHoursToRecover>true</showHoursToRecover>
      </li>
      <li Class="HediffCompProperties_DisappearsOnDeath" />
    </comps>
  </HediffDef>

  <HediffDef ParentName="VV_ScentBase">
    <defName>VV_Scent_Shockerbud</defName>
    <label>scent: shockerbud</label>
    <description>The tingling floral scent of a shockerbud. Sharpens reflexes in melee.</description>
    <descriptionHyperlinks>
      <ThingDef>VV_Shockerbud</ThingDef>
    </descriptionHyperlinks>
    <comps>
      <li Class="HediffCompProperties_Effecter">
        <stateEffecter>VV_ScentAura_Shockerbud</stateEffecter>
        <severityIndices>2~4</severityIndices>
      </li>
    </comps>
    <stages>
      <li>
        <label>faint</label>
        <statOffsets>
          <MeleeDodgeChance>2</MeleeDodgeChance>
          <MeleeHitChance>0.8</MeleeHitChance>
        </statOffsets>
      </li>
      <li>
        <label>subtle</label>
        <minSeverity>0.2</minSeverity>
        <statOffsets>
          <MeleeDodgeChance>4</MeleeDodgeChance>
          <MeleeHitChance>1.6</MeleeHitChance>
        </statOffsets>
      </li>
      <li>
        <label>moderate</label>
        <minSeverity>0.4</minSeverity>
        <statOffsets>
          <MeleeDodgeChance>6</MeleeDodgeChance>
          <MeleeHitChance>2.4</MeleeHitChance>
        </statOffsets>
      </li>
      <li>
        <label>rich</label>
        <minSeverity>0.6</minSeverity>
        <statOffsets>
          <MeleeDodgeChance>8</MeleeDodgeChance>
          <MeleeHitChance>3.2</MeleeHitChance>
        </statOffsets>
      </li>
      <li>
        <label>intense</label>
        <minSeverity>0.8</minSeverity>
        <statOffsets>
          <MeleeDodgeChance>10</MeleeDodgeChance>
          <MeleeHitChance>4</MeleeHitChance>
        </statOffsets>
        <capMods>
          <li><capacity>Manipulation</capacity><postFactor>1.05</postFactor></li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <HediffDef ParentName="VV_ScentBase">
    <defName>VV_Scent_Thunderpetals</defName>
    <label>scent: thunderpetals</label>
    <description>The electric floral scent of thunderpetals. Heightens focus and steadies the aim.</description>
    <descriptionHyperlinks>
      <ThingDef>VV_Thunderpetals</ThingDef>
    </descriptionHyperlinks>
    <comps>
      <li Class="HediffCompProperties_Effecter">
        <stateEffecter>VV_ScentAura_Thunderpetals</stateEffecter>
        <severityIndices>2~4</severityIndices>
      </li>
    </comps>
    <stages>
      <li>
        <label>faint</label>
        <statOffsets>
          <ShootingAccuracyPawn>0.8</ShootingAccuracyPawn>
          <RangedCooldownFactor>-0.02</RangedCooldownFactor>
        </statOffsets>
      </li>
      <li>
        <label>subtle</label>
        <minSeverity>0.2</minSeverity>
        <statOffsets>
          <ShootingAccuracyPawn>1.6</ShootingAccuracyPawn>
          <RangedCooldownFactor>-0.04</RangedCooldownFactor>
        </statOffsets>
      </li>
      <li>
        <label>moderate</label>
        <minSeverity>0.4</minSeverity>
        <statOffsets>
          <ShootingAccuracyPawn>2.4</ShootingAccuracyPawn>
          <RangedCooldownFactor>-0.06</RangedCooldownFactor>
        </statOffsets>
      </li>
      <li>
        <label>rich</label>
        <minSeverity>0.6</minSeverity>
        <statOffsets>
          <ShootingAccuracyPawn>3.2</ShootingAccuracyPawn>
          <RangedCooldownFactor>-0.08</RangedCooldownFactor>
        </statOffsets>
      </li>
      <li>
        <label>intense</label>
        <minSeverity>0.8</minSeverity>
        <statOffsets>
          <ShootingAccuracyPawn>4</ShootingAccuracyPawn>
          <RangedCooldownFactor>-0.1</RangedCooldownFactor>
        </statOffsets>
        <capMods>
          <li><capacity>Consciousness</capacity><postFactor>1.05</postFactor></li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <HediffDef ParentName="VV_ScentBase">
    <defName>VV_Scent_Waterdrops</defName>
    <label>scent: waterdrops</label>
    <description>The clear floral scent of waterdrops. Washes away toxins and protects the body from fire.</description>
    <descriptionHyperlinks>
      <ThingDef>VV_Waterdrops</ThingDef>
    </descriptionHyperlinks>
    <comps>
      <li Class="HediffCompProperties_Effecter">
        <stateEffecter>VV_ScentAura_Waterdrops</stateEffecter>
        <severityIndices>2~4</severityIndices>
      </li>
    </comps>
    <stages>
      <li>
        <label>faint</label>
        <statOffsets>
          <ToxicResistance>0.2</ToxicResistance>
        </statOffsets>
        <statFactors>
          <Flammability>0.8</Flammability>
        </statFactors>
      </li>
      <li>
        <label>subtle</label>
        <minSeverity>0.2</minSeverity>
        <statOffsets>
          <ToxicResistance>0.4</ToxicResistance>
        </statOffsets>
        <statFactors>
          <Flammability>0.6</Flammability>
        </statFactors>
      </li>
      <li>
        <label>moderate</label>
        <minSeverity>0.4</minSeverity>
        <statOffsets>
          <ToxicResistance>0.6</ToxicResistance>
        </statOffsets>
        <statFactors>
          <Flammability>0.4</Flammability>
        </statFactors>
      </li>
      <li>
        <label>rich</label>
        <minSeverity>0.6</minSeverity>
        <statOffsets>
          <ToxicResistance>0.8</ToxicResistance>
        </statOffsets>
        <statFactors>
          <Flammability>0.2</Flammability>
        </statFactors>
      </li>
      <li>
        <label>intense</label>
        <minSeverity>0.8</minSeverity>
        <statOffsets>
          <ToxicResistance>1.0</ToxicResistance>
        </statOffsets>
        <statFactors>
          <Flammability>0</Flammability>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

  <HediffDef ParentName="VV_ScentBase">
    <defName>VV_Scent_Radiantflower</defName>
    <label>scent: radiantflower</label>
    <description>The warm floral scent of a radiantflower. Calms the mind and speeds natural healing.</description>
    <descriptionHyperlinks>
      <ThingDef>VV_Radiantflower</ThingDef>
    </descriptionHyperlinks>
    <comps>
      <li Class="HediffCompProperties_Effecter">
        <stateEffecter>VV_ScentAura_Radiantflower</stateEffecter>
        <severityIndices>2~4</severityIndices>
      </li>
    </comps>
    <stages>
      <li>
        <label>faint</label>
        <statOffsets>
          <MentalBreakThreshold>-0.02</MentalBreakThreshold>
        </statOffsets>
        <statFactors>
          <InjuryHealingFactor>1.06</InjuryHealingFactor>
        </statFactors>
      </li>
      <li>
        <label>subtle</label>
        <minSeverity>0.2</minSeverity>
        <statOffsets>
          <MentalBreakThreshold>-0.04</MentalBreakThreshold>
        </statOffsets>
        <statFactors>
          <InjuryHealingFactor>1.12</InjuryHealingFactor>
        </statFactors>
      </li>
      <li>
        <label>moderate</label>
        <minSeverity>0.4</minSeverity>
        <statOffsets>
          <MentalBreakThreshold>-0.06</MentalBreakThreshold>
        </statOffsets>
        <statFactors>
          <InjuryHealingFactor>1.18</InjuryHealingFactor>
        </statFactors>
      </li>
      <li>
        <label>rich</label>
        <minSeverity>0.6</minSeverity>
        <statOffsets>
          <MentalBreakThreshold>-0.08</MentalBreakThreshold>
        </statOffsets>
        <statFactors>
          <InjuryHealingFactor>1.24</InjuryHealingFactor>
        </statFactors>
      </li>
      <li>
        <label>intense</label>
        <minSeverity>0.8</minSeverity>
        <statOffsets>
          <MentalBreakThreshold>-0.1</MentalBreakThreshold>
        </statOffsets>
        <statFactors>
          <InjuryHealingFactor>1.3</InjuryHealingFactor>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

  <HediffDef ParentName="VV_ScentBase">
    <defName>VV_Scent_Richflower</defName>
    <label>scent: richflower</label>
    <description>The bountiful floral scent of a richflower. Invigorates work and slows hunger.</description>
    <descriptionHyperlinks>
      <ThingDef>VV_Richflower</ThingDef>
    </descriptionHyperlinks>
    <comps>
      <li Class="HediffCompProperties_Effecter">
        <stateEffecter>VV_ScentAura_Richflower</stateEffecter>
        <severityIndices>2~4</severityIndices>
      </li>
    </comps>
    <stages>
      <li>
        <label>faint</label>
        <statOffsets>
          <WorkSpeedGlobal>0.02</WorkSpeedGlobal>
        </statOffsets>
        <hungerRateFactor>0.98</hungerRateFactor>
      </li>
      <li>
        <label>subtle</label>
        <minSeverity>0.2</minSeverity>
        <statOffsets>
          <WorkSpeedGlobal>0.04</WorkSpeedGlobal>
        </statOffsets>
        <hungerRateFactor>0.96</hungerRateFactor>
      </li>
      <li>
        <label>moderate</label>
        <minSeverity>0.4</minSeverity>
        <statOffsets>
          <WorkSpeedGlobal>0.06</WorkSpeedGlobal>
        </statOffsets>
        <hungerRateFactor>0.94</hungerRateFactor>
      </li>
      <li>
        <label>rich</label>
        <minSeverity>0.6</minSeverity>
        <statOffsets>
          <WorkSpeedGlobal>0.08</WorkSpeedGlobal>
        </statOffsets>
        <hungerRateFactor>0.92</hungerRateFactor>
      </li>
      <li>
        <label>intense</label>
        <minSeverity>0.8</minSeverity>
        <statOffsets>
          <WorkSpeedGlobal>0.1</WorkSpeedGlobal>
        </statOffsets>
        <hungerRateFactor>0.9</hungerRateFactor>
      </li>
    </stages>
  </HediffDef>

  <HediffDef ParentName="VV_ScentBase">
    <defName>VV_Scent_Starlitflower</defName>
    <label>scent: starlitflower</label>
    <description>The tranquil floral scent of a starlitflower. Eases pain, brings restful sleep, and helps the body withstand vacuum.</description>
    <descriptionHyperlinks>
      <ThingDef>VV_Starlitflower</ThingDef>
    </descriptionHyperlinks>
    <comps>
      <li Class="HediffCompProperties_Effecter">
        <stateEffecter>VV_ScentAura_Starlitflower</stateEffecter>
        <severityIndices>2~4</severityIndices>
      </li>
    </comps>
    <stages>
      <li>
        <label>faint</label>
        <statOffsets>
          <PainShockThreshold>0.01</PainShockThreshold>
          <RestRateMultiplier>0.03</RestRateMultiplier>
          <VacuumResistance MayRequire="Ludeon.RimWorld.Odyssey">0.2</VacuumResistance>
        </statOffsets>
      </li>
      <li>
        <label>subtle</label>
        <minSeverity>0.2</minSeverity>
        <statOffsets>
          <PainShockThreshold>0.02</PainShockThreshold>
          <RestRateMultiplier>0.06</RestRateMultiplier>
          <VacuumResistance MayRequire="Ludeon.RimWorld.Odyssey">0.4</VacuumResistance>
        </statOffsets>
      </li>
      <li>
        <label>moderate</label>
        <minSeverity>0.4</minSeverity>
        <statOffsets>
          <PainShockThreshold>0.03</PainShockThreshold>
          <RestRateMultiplier>0.09</RestRateMultiplier>
          <VacuumResistance MayRequire="Ludeon.RimWorld.Odyssey">0.6</VacuumResistance>
        </statOffsets>
      </li>
      <li>
        <label>rich</label>
        <minSeverity>0.6</minSeverity>
        <statOffsets>
          <PainShockThreshold>0.04</PainShockThreshold>
          <RestRateMultiplier>0.12</RestRateMultiplier>
          <VacuumResistance MayRequire="Ludeon.RimWorld.Odyssey">0.8</VacuumResistance>
        </statOffsets>
      </li>
      <li>
        <label>intense</label>
        <minSeverity>0.8</minSeverity>
        <statOffsets>
          <PainShockThreshold>0.05</PainShockThreshold>
          <RestRateMultiplier>0.15</RestRateMultiplier>
          <VacuumResistance MayRequire="Ludeon.RimWorld.Odyssey">0.95</VacuumResistance>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <HediffDef ParentName="VV_ScentBase">
    <defName>VV_Scent_EmberBloom</defName>
    <label>scent: emberbloom</label>
    <description>The softly smoldering floral scent of an emberbloom. Wards off cold and strengthens the immune system.</description>
    <descriptionHyperlinks>
      <ThingDef>VV_EmberBloom</ThingDef>
    </descriptionHyperlinks>
    <comps>
      <li Class="HediffCompProperties_Effecter">
        <stateEffecter>VV_ScentAura_EmberBloom</stateEffecter>
        <severityIndices>2~4</severityIndices>
      </li>
    </comps>
    <stages>
      <li>
        <label>faint</label>
        <statOffsets>
          <ComfyTemperatureMin>-2</ComfyTemperatureMin>
          <ImmunityGainSpeed>0.04</ImmunityGainSpeed>
        </statOffsets>
      </li>
      <li>
        <label>subtle</label>
        <minSeverity>0.2</minSeverity>
        <statOffsets>
          <ComfyTemperatureMin>-4</ComfyTemperatureMin>
          <ImmunityGainSpeed>0.08</ImmunityGainSpeed>
        </statOffsets>
      </li>
      <li>
        <label>moderate</label>
        <minSeverity>0.4</minSeverity>
        <statOffsets>
          <ComfyTemperatureMin>-6</ComfyTemperatureMin>
          <ImmunityGainSpeed>0.12</ImmunityGainSpeed>
        </statOffsets>
      </li>
      <li>
        <label>rich</label>
        <minSeverity>0.6</minSeverity>
        <statOffsets>
          <ComfyTemperatureMin>-8</ComfyTemperatureMin>
          <ImmunityGainSpeed>0.16</ImmunityGainSpeed>
        </statOffsets>
      </li>
      <li>
        <label>intense</label>
        <minSeverity>0.8</minSeverity>
        <statOffsets>
          <ComfyTemperatureMin>-10</ComfyTemperatureMin>
          <ImmunityGainSpeed>0.2</ImmunityGainSpeed>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <HediffDef ParentName="VV_ScentBase">
    <defName>VV_Scent_FrostBloom</defName>
    <label>scent: frostbloom</label>
    <description>The cold floral scent of a frostbloom. Wards off heat and makes the body tire more slowly.</description>
    <descriptionHyperlinks>
      <ThingDef>VV_FrostBloom</ThingDef>
    </descriptionHyperlinks>
    <comps>
      <li Class="HediffCompProperties_Effecter">
        <stateEffecter>VV_ScentAura_FrostBloom</stateEffecter>
        <severityIndices>2~4</severityIndices>
      </li>
    </comps>
    <stages>
      <li>
        <label>faint</label>
        <statOffsets>
          <ComfyTemperatureMax>2</ComfyTemperatureMax>
        </statOffsets>
        <statFactors>
          <RestFallRateFactor>0.97</RestFallRateFactor>
        </statFactors>
      </li>
      <li>
        <label>subtle</label>
        <minSeverity>0.2</minSeverity>
        <statOffsets>
          <ComfyTemperatureMax>4</ComfyTemperatureMax>
        </statOffsets>
        <statFactors>
          <RestFallRateFactor>0.94</RestFallRateFactor>
        </statFactors>
      </li>
      <li>
        <label>moderate</label>
        <minSeverity>0.4</minSeverity>
        <statOffsets>
          <ComfyTemperatureMax>6</ComfyTemperatureMax>
        </statOffsets>
        <statFactors>
          <RestFallRateFactor>0.91</RestFallRateFactor>
        </statFactors>
      </li>
      <li>
        <label>rich</label>
        <minSeverity>0.6</minSeverity>
        <statOffsets>
          <ComfyTemperatureMax>8</ComfyTemperatureMax>
        </statOffsets>
        <statFactors>
          <RestFallRateFactor>0.88</RestFallRateFactor>
        </statFactors>
      </li>
      <li>
        <label>intense</label>
        <minSeverity>0.8</minSeverity>
        <statOffsets>
          <ComfyTemperatureMax>10</ComfyTemperatureMax>
        </statOffsets>
        <statFactors>
          <RestFallRateFactor>0.85</RestFallRateFactor>
        </statFactors>
      </li>
    </stages>
  </HediffDef>
</Defs>
