<?xml version="1.0" encoding="UTF-8"?>
<Defs>
  <HediffDef Name="VV_ScentBase" Abstract="True">
    <hediffClass>VVRace.Hediff_FloralScent</hediffClass>
    <defaultLabelColor>(0.95, 0.75, 1)</defaultLabelColor>
    <isBad>false</isBad>
    <priceImpact>false</priceImpact>
    <scenarioCanAdd>false</scenarioCanAdd>
    <everCurableByItem>false</everCurableByItem>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-2.4</severityPerDay>
        <showHoursToRecover>true</showHoursToRecover>
      </li>
      <li Class="HediffCompProperties_DisappearsOnDeath" />
    </comps>
  </HediffDef>

  <HediffDef ParentName="VV_ScentBase">
    <defName>VV_Scent_Shockerbud</defName>
    <label>scent: shockerbud</label>
    <description>The tingling floral scent of a shockerbud. Sharpens reflexes in melee.</description>
    <descriptionHyperlinks>
      <ThingDef>VV_Shockerbud</ThingDef>
    </descriptionHyperlinks>
    <stages>
      <li>
        <statOffsets>
          <MeleeDodgeChance>10</MeleeDodgeChance>
          <MeleeHitChance>4</MeleeHitChance>
        </statOffsets>
        <capMods>
          <li><capacity>Manipulation</capacity><postFactor>1.05</postFactor></li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <HediffDef ParentName="VV_ScentBase">
    <defName>VV_Scent_Thunderpetals</defName>
    <label>scent: thunderpetals</label>
    <description>The electric floral scent of thunderpetals. Heightens focus and steadies the aim.</description>
    <descriptionHyperlinks>
      <ThingDef>VV_Thunderpetals</ThingDef>
    </descriptionHyperlinks>
    <stages>
      <li>
        <statOffsets>
          <ShootingAccuracyPawn>4</ShootingAccuracyPawn>
          <RangedCooldownFactor>-0.1</RangedCooldownFactor>
        </statOffsets>
        <capMods>
          <li><capacity>Consciousness</capacity><postFactor>1.05</postFactor></li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <HediffDef ParentName="VV_ScentBase">
    <defName>VV_Scent_Waterdrops</defName>
    <label>scent: waterdrops</label>
    <description>The clear floral scent of waterdrops. Washes away toxins and protects the body from fire.</description>
    <descriptionHyperlinks>
      <ThingDef>VV_Waterdrops</ThingDef>
    </descriptionHyperlinks>
    <stages>
      <li>
        <statOffsets>
          <ToxicResistance>1.0</ToxicResistance>
        </statOffsets>
        <statFactors>
          <Flammability>0</Flammability>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

  <HediffDef ParentName="VV_ScentBase">
    <defName>VV_Scent_Radiantflower</defName>
    <label>scent: radiantflower</label>
    <description>The warm floral scent of a radiantflower. Calms the mind and speeds natural healing.</description>
    <descriptionHyperlinks>
      <ThingDef>VV_Radiantflower</ThingDef>
    </descriptionHyperlinks>
    <stages>
      <li>
        <statOffsets>
          <MentalBreakThreshold>-0.1</MentalBreakThreshold>
        </statOffsets>
        <statFactors>
          <InjuryHealingFactor>1.3</InjuryHealingFactor>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

  <HediffDef ParentName="VV_ScentBase">
    <defName>VV_Scent_Richflower</defName>
    <label>scent: richflower</label>
    <description>The bountiful floral scent of a richflower. Invigorates work and slows hunger.</description>
    <descriptionHyperlinks>
      <ThingDef>VV_Richflower</ThingDef>
    </descriptionHyperlinks>
    <stages>
      <li>
        <statOffsets>
          <WorkSpeedGlobal>0.1</WorkSpeedGlobal>
        </statOffsets>
        <hungerRateFactor>0.9</hungerRateFactor>
      </li>
    </stages>
  </HediffDef>

  <HediffDef ParentName="VV_ScentBase">
    <defName>VV_Scent_Starlitflower</defName>
    <label>scent: starlitflower</label>
    <description>The tranquil floral scent of a starlitflower. Eases pain, brings restful sleep, and helps the body withstand vacuum.</description>
    <descriptionHyperlinks>
      <ThingDef>VV_Starlitflower</ThingDef>
    </descriptionHyperlinks>
    <stages>
      <li>
        <statOffsets>
          <PainShockThreshold>0.05</PainShockThreshold>
          <RestRateMultiplier>0.15</RestRateMultiplier>
          <VacuumResistance MayRequire="Ludeon.RimWorld.Odyssey">0.95</VacuumResistance>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <HediffDef ParentName="VV_ScentBase">
    <defName>VV_Scent_EmberBloom</defName>
    <label>scent: emberbloom</label>
    <description>The softly smoldering floral scent of an emberbloom. Wards off cold and strengthens the immune system.</description>
    <descriptionHyperlinks>
      <ThingDef>VV_EmberBloom</ThingDef>
    </descriptionHyperlinks>
    <stages>
      <li>
        <statOffsets>
          <ComfyTemperatureMin>-10</ComfyTemperatureMin>
          <ImmunityGainSpeed>0.2</ImmunityGainSpeed>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <HediffDef ParentName="VV_ScentBase">
    <defName>VV_Scent_FrostBloom</defName>
    <label>scent: frostbloom</label>
    <description>The cold floral scent of a frostbloom. Wards off heat and makes the body tire more slowly.</description>
    <descriptionHyperlinks>
      <ThingDef>VV_FrostBloom</ThingDef>
    </descriptionHyperlinks>
    <stages>
      <li>
        <statOffsets>
          <ComfyTemperatureMax>10</ComfyTemperatureMax>
        </statOffsets>
        <statFactors>
          <RestFallRateFactor>0.85</RestFallRateFactor>
        </statFactors>
      </li>
    </stages>
  </HediffDef>
</Defs>
