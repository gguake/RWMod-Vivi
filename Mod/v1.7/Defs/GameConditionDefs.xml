<?xml version="1.0" encoding="UTF-8"?>
<Defs>
  <GameConditionDef>
    <defName>VV_EverflowerWeatherControl</defName>
    <conditionClass>GameCondition_ForceWeather</conditionClass>
    <label>forced weather</label>
    <description>everflower is forcing the weather.</description>
    <canBePermanent>false</canBePermanent>
    <natural>false</natural>
  </GameConditionDef>

  <!-- 불길한 정적 -->
  <GameConditionDef>
    <defName>VV_OminousSilence</defName>
    <conditionClass>GameCondition</conditionClass>
    <label>ominous silence</label>
    <description>A psychic wave rolling in from afar is blocking the everflower's bloom. Something is approaching, following the waves of the flower's shade.</description>
    <natural>false</natural>
    <displayOnUI>true</displayOnUI>
    <preventIncidents>false</preventIncidents>
    <canBePermanent>false</canBePermanent>
  </GameConditionDef>

  <!-- 금빛 꽃가루 안개 -->
  <GameConditionDef>
    <defName>VV_GoldenBloom</defName>
    <conditionClass>VVRace.GameCondition_GoldenBloom</conditionClass>
    <label>golden pollen mist</label>
    <description>The everflower's golden pollen mist covers the area. Fire cannot spread, ranged accuracy is slightly reduced, and all arcane plants gain unlimited mana.</description>
    <weatherDef>VV_GoldenBloomMist</weatherDef>
    <natural>false</natural>
    <displayOnUI>false</displayOnUI>

    <canBePermanent>false</canBePermanent>
    <showPermanentInTooltip>false</showPermanentInTooltip>
    <preventIncidents>false</preventIncidents>
  </GameConditionDef>

  <!-- 아스포델 강림 -->
  <GameConditionDef>
    <defName>VV_ApocryphaPresence</defName>
    <conditionClass>GameCondition</conditionClass>
    <label>Asphodel's presence</label>
    <description>Asphodel's psychic wave suppresses the area around the everflower.</description>
    <natural>false</natural>
    <displayOnUI>false</displayOnUI>
    <preventIncidents>true</preventIncidents>
    <canBePermanent>true</canBePermanent>
    <showPermanentInTooltip>false</showPermanentInTooltip>
  </GameConditionDef>
</Defs>
