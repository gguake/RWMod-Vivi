<?xml version="1.0" encoding="UTF-8"?>
<Defs>

  <!-- 몰락한 여제 1페이즈 음악 -->
  <SongDef>
    <defName>VV_TheFallenQueen</defName>
    <clipPath>Songs/VV_TheFallenQueen</clipPath>
    <volume>1.25</volume>
    <commonality>0</commonality>
  </SongDef>

  <!-- 몰락한 여제 2페이즈 음악 -->
  <SongDef>
    <defName>VV_TheFallenQueen_Phase2</defName>
    <clipPath>Songs/VV_TheFallenQueen_Phase2</clipPath>
    <volume>1.25</volume>
    <commonality>0</commonality>
  </SongDef>

  <!-- 아스포델 1페이즈 음악 재생 -->
  <MusicSequenceDef>
    <defName>VV_ApocryphaBound</defName>
    <song>VV_TheFallenQueen</song>
    <loop>true</loop>
    <canBeInterrupted>false</canBeInterrupted>
    <fadeoutLastSongDuration>3</fadeoutLastSongDuration>
    <overrideFadeout>5</overrideFadeout>
    <pausedVolumeFactor>0.5</pausedVolumeFactor>
  </MusicSequenceDef>

  <!-- 아스포델 2페이즈 음악 재생 -->
  <MusicSequenceDef>
    <defName>VV_ApocryphaUnbound</defName>
    <song>VV_TheFallenQueen_Phase2</song>
    <loop>true</loop>
    <canBeInterrupted>false</canBeInterrupted>
    <fadeoutLastSongDuration>0.25</fadeoutLastSongDuration>
    <overrideFadeout>5</overrideFadeout>
    <pausedVolumeFactor>0.5</pausedVolumeFactor>
  </MusicSequenceDef>

  <!-- 아스포델 1페이즈 음악 전환 -->
  <MusicTransitionDef>
    <defName>VV_ApocryphaBound</defName>
    <workerType>VVRace.MusicTransition_ApocryphaBound</workerType>
    <sequence>VV_ApocryphaBound</sequence>
    <overridesInterruptions>true</overridesInterruptions>
    <priority>1100</priority>
  </MusicTransitionDef>

  <!-- 아스포델 2페이즈 음악 전환 -->
  <MusicTransitionDef>
    <defName>VV_ApocryphaUnbound</defName>
    <workerType>VVRace.MusicTransition_ApocryphaUnbound</workerType>
    <sequence>VV_ApocryphaUnbound</sequence>
    <overridesInterruptions>true</overridesInterruptions>
    <priority>1101</priority>
  </MusicTransitionDef>
</Defs>
