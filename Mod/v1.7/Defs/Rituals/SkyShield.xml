<?xml version="1.0" encoding="UTF-8"?>
<Defs>
  <!-- 하늘 방패 의식 -->
  <PreceptDef ParentName="VV_EverflowerRitualPreceptBase">
    <defName>VV_SkyShield</defName>
    <label>sky shield ritual</label>
    <description>Raises a wide shield over the everflower that covers the sky. Blocks enemy bombardment.</description>
    <ritualPatternBase>VV_SkyShield</ritualPatternBase>
    <iconPath>UI/Commands/VV_SkyShield</iconPath>
    <displayOrderInImpact>992</displayOrderInImpact>
    <displayOrderInIssue>992</displayOrderInIssue>
  </PreceptDef>

  <!-- 하늘 방패 의식 구성 -->
  <RitualPatternDef ParentName="VV_EverflowerRitualPatternBase">
    <defName>VV_SkyShield</defName>
    <ritualBehavior>VV_SkyShield</ritualBehavior>
    <ritualOutcomeEffect>VV_SkyShield</ritualOutcomeEffect>
    <ritualObligationTargetFilter>VV_SkyShield</ritualObligationTargetFilter>
    <iconPathOverride>UI/Commands/VV_SkyShield</iconPathOverride>
  </RitualPatternDef>

  <!-- 하늘 방패 의식 진행 -->
  <RitualBehaviorDef ParentName="VV_EverflowerRitualBehaviorBase">
    <defName>VV_SkyShield</defName>
  </RitualBehaviorDef>

  <!-- 하늘 방패 의식 결과 -->
  <RitualOutcomeEffectDef ParentName="VV_EverflowerRitualOutcomeBase" Class="VVRace.RitualOutcomeEffectDef_SkyShield">
    <defName>VV_SkyShield</defName>
    <description>The better the ritual quality, the longer the shield lasts.\n\nAll everflower rituals share a cooldown.</description>
    <workerClass>VVRace.RitualOutcomeEffectWorker_SkyShield</workerClass>
    <effecter>VV_Effecter_SkyShieldComplete</effecter>
    <shieldDef>VV_SkyShield</shieldDef>
    <durationTicksByQuality>
      <points>
        <li>(0, 60000)</li>
        <li>(3, 180000)</li>
      </points>
    </durationTicksByQuality>
  </RitualOutcomeEffectDef>

  <!-- 하늘 방패 의식 대상 -->
  <RitualObligationTargetFilterDef Class="VVRace.RitualObligationTargetFilterDef_EverflowerRitual">
    <defName>VV_SkyShield</defName>
    <workerClass>VVRace.RitualObligationTargetWorker_EverflowerRitual</workerClass>
    <requiredAttunementLevel>6</requiredAttunementLevel>
  </RitualObligationTargetFilterDef>
</Defs>
