<?xml version="1.0" encoding="UTF-8"?>
<Defs>

  <!-- 영원꽃 만개 의식 -->
  <PreceptDef ParentName="VV_EverflowerRitualPreceptBase">
    <defName>VV_GrandAttunement</defName>
    <label>everflower full bloom ritual</label>
    <description>Begins the final bloom of the everflower enshrined on the altar. The resonator becomes fully assimilated with the everflower for a while and cannot act.</description>
    <ritualPatternBase>VV_GrandAttunement</ritualPatternBase>
    <iconPath>UI/Commands/VV_GrandAttunement</iconPath>
    <displayOrderInImpact>1001</displayOrderInImpact>
    <displayOrderInIssue>1001</displayOrderInIssue>
  </PreceptDef>

  <!-- 영원꽃 만개 의식 구성 -->
  <RitualPatternDef ParentName="VV_EverflowerRitualPatternBase">
    <defName>VV_GrandAttunement</defName>
    <ritualBehavior>VV_GrandAttunement</ritualBehavior>
    <ritualOutcomeEffect>VV_GrandAttunement</ritualOutcomeEffect>
    <ritualObligationTargetFilter>VV_GrandAttunement</ritualObligationTargetFilter>
    <iconPathOverride>UI/Commands/VV_GrandAttunement</iconPathOverride>
  </RitualPatternDef>

  <!-- 영원꽃 만개 의식 진행 -->
  <RitualBehaviorDef ParentName="VV_EverflowerRitualBehaviorBase">
    <defName>VV_GrandAttunement</defName>
    <durationTicks>2500</durationTicks>
    <workerClass>VVRace.RitualBehaviorWorker_GrandAttunement</workerClass>
  </RitualBehaviorDef>

  <!-- 영원꽃 만개 의식 결과 -->
  <RitualOutcomeEffectDef ParentName="VV_EverflowerRitualOutcomeBase">
    <defName>VV_GrandAttunement</defName>
    <description>The better the ritual quality, the shorter the condensation period. Everflower rituals cannot be performed during mana condensation.\n\nAll everflower rituals share a cooldown.</description>
    <workerClass>VVRace.RitualOutcomeEffectWorker_GrandAttunement</workerClass>
    <effecter>VV_Effecter_GrandAttunementComplete</effecter>
    <comps Inherit="False">
      <li Class="RitualOutcomeComp_PawnStatScaled">
        <label>{PAWN_labelShort}'s psychic sensitivity</label>
        <labelAbstract>resonator's psychic sensitivity</labelAbstract>
        <roleId>resonator</roleId>
        <statDef>PsychicSensitivity</statDef>
        <curve>
          <points>
            <li>(0.5, 0.0)</li>
            <li>(1.5, 1.0)</li>
            <li>(2.5, 2.0)</li>
            <li>(4.0, 4.0)</li>
            <li>(6.0, 6.0)</li>
            <li>(9.0, 8.0)</li>
          </points>
        </curve>
      </li>
      <li Class="RitualOutcomeComp_ParticipantCount">
        <label>participant count</label>
        <curve>
          <points>
            <li>(0,  0.0)</li>
            <li>(4,  0.5)</li>
            <li>(10, 1.0)</li>
            <li>(20, 2.0)</li>
          </points>
        </curve>
      </li>
    </comps>
  </RitualOutcomeEffectDef>

  <!-- 영원꽃 만개 의식 대상 -->
  <RitualObligationTargetFilterDef Class="VVRace.RitualObligationTargetFilterDef_EverflowerRitual">
    <defName>VV_GrandAttunement</defName>
    <workerClass>VVRace.RitualObligationTargetWorker_EverflowerRitual</workerClass>
    <requiredAttunementLevel>4</requiredAttunementLevel>
    <maxAttunementLevel>4</maxAttunementLevel>
    <requiresAltar>true</requiresAltar>
    <startsEndingQuest>true</startsEndingQuest>
  </RitualObligationTargetFilterDef>
</Defs>
