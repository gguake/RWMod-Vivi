<?xml version="1.0" encoding="UTF-8"?>
<Defs>
  <!-- 꽃의 대지 의식 -->
  <PreceptDef ParentName="VV_EverflowerRitualPreceptBase">
    <defName>VV_FlowerLand</defName>
    <label>land of flowers ritual</label>
    <description>Blesses the ground at the chosen spot, enriching it and bringing flowers into bloom.</description>
    <preceptClass>VVRace.Precept_RitualFlowerLand</preceptClass>
    <ritualPatternBase>VV_FlowerLand</ritualPatternBase>
    <iconPath>UI/Commands/VV_FlowerLand</iconPath>
    <displayOrderInImpact>991</displayOrderInImpact>
    <displayOrderInIssue>991</displayOrderInIssue>
  </PreceptDef>

  <!-- 꽃의 대지 의식 구성 -->
  <RitualPatternDef ParentName="VV_EverflowerRitualPatternBase">
    <defName>VV_FlowerLand</defName>
    <ritualBehavior>VV_FlowerLand</ritualBehavior>
    <ritualOutcomeEffect>VV_FlowerLand</ritualOutcomeEffect>
    <ritualObligationTargetFilter>VV_FlowerLand</ritualObligationTargetFilter>
    <iconPathOverride>UI/Commands/VV_FlowerLand</iconPathOverride>
  </RitualPatternDef>

  <!-- 꽃의 대지 의식 진행 -->
  <RitualBehaviorDef ParentName="VV_EverflowerRitualBehaviorBase">
    <defName>VV_FlowerLand</defName>
  </RitualBehaviorDef>

  <!-- 꽃의 대지 의식 결과 -->
  <RitualOutcomeEffectDef ParentName="VV_EverflowerRitualOutcomeBase" Class="VVRace.RitualOutcomeEffectDef_FlowerLand">
    <defName>VV_FlowerLand</defName>
    <description>When the ritual completes, the ground around the chosen spot turns into rich soil and fully bloomed vivia flowers spring up.\n\nAll everflower rituals share a cooldown.</description>
    <workerClass>VVRace.RitualOutcomeEffectWorker_FlowerLand</workerClass>
    <effecter>VV_Effecter_FlowerLandComplete</effecter>
    <radius>6.6</radius>
    <terrain>SoilRich</terrain>
    <areaEffecter>VV_Effecter_FlowerLandBloom</areaEffecter>
  </RitualOutcomeEffectDef>

  <!-- 꽃의 대지 의식 대상 -->
  <RitualObligationTargetFilterDef Class="VVRace.RitualObligationTargetFilterDef_EverflowerRitual">
    <defName>VV_FlowerLand</defName>
    <workerClass>VVRace.RitualObligationTargetWorker_EverflowerRitual</workerClass>
    <requiredAttunementLevel>6</requiredAttunementLevel>
  </RitualObligationTargetFilterDef>
</Defs>
