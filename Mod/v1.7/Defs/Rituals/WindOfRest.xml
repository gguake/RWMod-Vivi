<?xml version="1.0" encoding="UTF-8"?>
<Defs>
  <!-- 안식의 바람 의식 -->
  <PreceptDef ParentName="VV_EverflowerRitualPreceptBase">
    <defName>VV_WindOfRest</defName>
    <label>wind of rest ritual</label>
    <description>Calls up a mystical wind that purifies pollution and chaos, cleansing genetic instability and scaria from every creature in the area and purifying titanic hornets.</description>
    <ritualPatternBase>VV_WindOfRest</ritualPatternBase>
    <iconPath>UI/Commands/VV_WindOfRest</iconPath>
    <displayOrderInImpact>993</displayOrderInImpact>
    <displayOrderInIssue>993</displayOrderInIssue>
  </PreceptDef>

  <!-- 안식의 바람 의식 구성 -->
  <RitualPatternDef ParentName="VV_EverflowerRitualPatternBase">
    <defName>VV_WindOfRest</defName>
    <ritualBehavior>VV_WindOfRest</ritualBehavior>
    <ritualOutcomeEffect>VV_WindOfRest</ritualOutcomeEffect>
    <ritualObligationTargetFilter>VV_WindOfRest</ritualObligationTargetFilter>
    <iconPathOverride>UI/Commands/VV_WindOfRest</iconPathOverride>
  </RitualPatternDef>

  <!-- 안식의 바람 의식 진행 -->
  <RitualBehaviorDef ParentName="VV_EverflowerRitualBehaviorBase">
    <defName>VV_WindOfRest</defName>
  </RitualBehaviorDef>

  <!-- 안식의 바람 의식 결과 -->
  <RitualOutcomeEffectDef ParentName="VV_EverflowerRitualOutcomeBase">
    <defName>VV_WindOfRest</defName>
    <description>When the ritual completes, genetic instability and scaria are cured throughout the area. Titanic hornets are purified and vanish.\n\nAll everflower rituals share a cooldown.</description>
    <workerClass>VVRace.RitualOutcomeEffectWorker_WindOfRest</workerClass>
    <effecter>VV_Effecter_WindOfRestComplete</effecter>
  </RitualOutcomeEffectDef>

  <!-- 안식의 바람 의식 대상 -->
  <RitualObligationTargetFilterDef Class="VVRace.RitualObligationTargetFilterDef_EverflowerRitual">
    <defName>VV_WindOfRest</defName>
    <workerClass>VVRace.RitualObligationTargetWorker_EverflowerRitual</workerClass>
    <requiredAttunementLevel>6</requiredAttunementLevel>
  </RitualObligationTargetFilterDef>
</Defs>
