<?xml version="1.0" encoding="UTF-8"?>
<Defs>
  <!-- 생명의 회귀 -->
  <PreceptDef ParentName="VV_EverflowerRitualPreceptBase">
    <defName>VV_ReturnOfLife</defName>
    <label>return of life</label>
    <description>Restores a body to an ancient fairy vivi freed from Asphodel.</description>
    <ritualPatternBase>VV_ReturnOfLife</ritualPatternBase>
    <iconPath>UI/Commands/VV_ReturnOfLife</iconPath>
    <displayOrderInImpact>995</displayOrderInImpact>
    <displayOrderInIssue>995</displayOrderInIssue>
  </PreceptDef>

  <!-- 생명의 회귀 구성 -->
  <RitualPatternDef ParentName="VV_EverflowerRitualPatternBase">
    <defName>VV_ReturnOfLife</defName>
    <ritualBehavior>VV_ReturnOfLife</ritualBehavior>
    <ritualOutcomeEffect>VV_ReturnOfLife</ritualOutcomeEffect>
    <ritualObligationTargetFilter>VV_ReturnOfLife</ritualObligationTargetFilter>
    <iconPathOverride>UI/Commands/VV_ReturnOfLife</iconPathOverride>
  </RitualPatternDef>

  <!-- 생명의 회귀 진행 -->
  <RitualBehaviorDef ParentName="VV_EverflowerRitualBehaviorBase">
    <defName>VV_ReturnOfLife</defName>
    <stages Inherit="False">
      <li>
        <defaultDuty>Spectate</defaultDuty>
        <showProgressBar>false</showProgressBar>
        <endTriggers>
          <li Class="StageEndTrigger_RolesArrived">
            <roleIds>
              <li>resonator</li>
            </roleIds>
          </li>
        </endTriggers>
        <roleBehaviors>
          <li>
            <roleId>resonator</roleId>
            <dutyDef>ArriveToCell</dutyDef>
            <customPositions>
              <li Class="RitualPosition_PreferredAdjacentCellCardinal">
                <faceThing>true</faceThing>
              </li>
            </customPositions>
          </li>
        </roleBehaviors>
      </li>
      <li>
        <defaultDuty>SpectateCircle</defaultDuty>
        <spectateDistanceOverride>4~6</spectateDistanceOverride>
        <visualEffectDef>VV_Defairyfication</visualEffectDef>
        <endTriggers>
          <li Class="StageEndTrigger_DurationPercentage">
            <percentage>1</percentage>
          </li>
        </endTriggers>
        <roleBehaviors>
          <li>
            <roleId>resonator</roleId>
            <dutyDef>Idle</dutyDef>
            <customPositions>
              <li Class="RitualPosition_PreferredAdjacentCellCardinal">
                <faceThing>true</faceThing>
              </li>
            </customPositions>
          </li>
        </roleBehaviors>
      </li>
    </stages>
  </RitualBehaviorDef>

  <!-- 생명의 회귀 결과 -->
  <RitualOutcomeEffectDef ParentName="VV_EverflowerRitualOutcomeBase">
    <defName>VV_ReturnOfLife</defName>
    <description>When the ritual completes, an ancient adult vivi with random genes joins the colony.\n\nAll everflower rituals share a cooldown.</description>
    <workerClass>VVRace.RitualOutcomeEffectWorker_ReturnOfLife</workerClass>
    <effecter>VV_Effecter_ReturnOfLifeComplete</effecter>
  </RitualOutcomeEffectDef>

  <!-- 생명의 회귀 대상 -->
  <RitualObligationTargetFilterDef Class="VVRace.RitualObligationTargetFilterDef_EverflowerRitual">
    <defName>VV_ReturnOfLife</defName>
    <workerClass>VVRace.RitualObligationTargetWorker_EverflowerRitual</workerClass>
    <requiredAttunementLevel>6</requiredAttunementLevel>
  </RitualObligationTargetFilterDef>
</Defs>
