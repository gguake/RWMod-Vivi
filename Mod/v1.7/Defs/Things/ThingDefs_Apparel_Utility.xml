<?xml version="1.0" encoding="UTF-8"?>
<Defs>
  <ThingDef Abstract="True" Name="VV_UtilityApparelBase" ParentName="ApparelNoQualityBase">
    <thingCategories>
      <li>VV_ViviTool</li>
    </thingCategories>

    <statBases>
      <ArmorRating_Sharp>0</ArmorRating_Sharp>
      <ArmorRating_Blunt>0</ArmorRating_Blunt>
      <ArmorRating_Heat>0</ArmorRating_Heat>
      <Insulation_Cold>0</Insulation_Cold>
      <Insulation_Heat>0</Insulation_Heat>
    </statBases>
    <apparel>
      <wornGraphicData>
        <renderUtilityAsPack>true</renderUtilityAsPack>
        <north>
          <offset>(0,-0.15)</offset>
        </north>
        <south>
          <offset>(0,-0.15)</offset>
        </south>
        <east>
          <offset>(-0.25,-0.1)</offset>
          <thin><offset>(0.05,0)</offset></thin>
          <hulk><offset>(-0.15,0)</offset></hulk>
          <fat> <offset>(-0.20,0)</offset></fat>
        </east>
        <west>
          <offset>(0.25,-0.1)</offset>
          <thin><offset>(-0.05,0)</offset></thin>
          <hulk><offset>(0.15,0)</offset></hulk>
          <fat> <offset>(0.20,0)</offset></fat>
        </west>
        <male>  <scale>(1.0,1.0)</scale></male>
        <female><scale>(1.0,1.0)</scale></female>
        <thin>  <scale>(1.0,1.0)</scale></thin>
        <hulk>  <scale>(1.2,1.2)</scale></hulk>
        <fat>   <scale>(1.2,1.2)</scale></fat>
      </wornGraphicData>

      <countsAsClothingForNudity>false</countsAsClothingForNudity>
      <careIfWornByCorpse>false</careIfWornByCorpse>
      <careIfDamaged>false</careIfDamaged>
      <wearPerDay>0</wearPerDay>

      <bodyPartGroups>
        <li>Waist</li>
      </bodyPartGroups>
      <layers>
        <li>Belt</li>
      </layers>
      <tags>
        <li>VV_ViviApparel</li>
      </tags>
      <developmentalStageFilter>Child, Adult</developmentalStageFilter>
      <canBeDesiredForIdeo>false</canBeDesiredForIdeo>
    </apparel>

    <tradeTags Inherit="False">
      <li>VV_ViviApparel</li>
    </tradeTags>
  </ThingDef>

  <!-- VV_StrawTool -->
  <ThingDef ParentName="VV_UtilityApparelBase">
    <defName>VV_StrawTool</defName>
    <label>vivi straw</label>
    <description>A large straw that Vivis use to collect honey more efficiently. Humans can also use it to collect honey.</description>
    <graphicData>
      <texPath>Things/Apparel/Straw/VV_Straw</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>

    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <WorkToMake>1500</WorkToMake>
      <Mass>0.1</Mass>
      <Flammability>0.4</Flammability>
      <EquipDelay>0.5</EquipDelay>
    </statBases>

    <equippedStatOffsets>
      <VV_HoneyGatherSpeed>0.5</VV_HoneyGatherSpeed>
      <VV_HoneyGatherYield>1.0</VV_HoneyGatherYield>
    </equippedStatOffsets>
    
    <apparel>
      <wornGraphicPath>Things/Apparel/Straw/VV_Straw</wornGraphicPath>
    </apparel>

    <costStuffCount>35</costStuffCount>
    <stuffCategories>
      <li>VV_Wax</li>
      <li>Woody</li>
    </stuffCategories>
    <recipeMaker>
      <recipeUsers>
        <li>CraftingSpot</li>
        <li>ElectricSmithy</li>
        <li>FueledSmithy</li>
      </recipeUsers>
      <researchPrerequisites>
        <li>VV_Tools</li>
      </researchPrerequisites>
      <displayPriority>-500</displayPriority>
    </recipeMaker>
  </ThingDef>

  <!-- VV_MultiuseBrushTool -->
  <ThingDef ParentName="VV_UtilityApparelBase">
    <defName>VV_MultiuseBrushTool</defName>
    <label>vivi multiuse brush</label>
    <description>A large brush that can be used for cleaning pollen or collecting material precisely from plants. It's also very helpful when smoothing rough surfaces, and humans can use it too.</description>
    <graphicData>
      <texPath>Things/Apparel/MultiuseBrush/VV_MultiuseBrush</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
    </graphicData>

    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <WorkToMake>1800</WorkToMake>
      <Mass>0.3</Mass>
      <Flammability>0.4</Flammability>
      <EquipDelay>0.5</EquipDelay>
    </statBases>

    <equippedStatOffsets>
      <CleaningSpeed>0.5</CleaningSpeed>
      <SmoothingSpeed>0.5</SmoothingSpeed>
      <VV_PlantGatherSpeed>0.25</VV_PlantGatherSpeed>
      <VV_PlantGatherYield>0.25</VV_PlantGatherYield>
    </equippedStatOffsets>
    
    <apparel>
      <wornGraphicPath>Things/Apparel/MultiuseBrush/VV_MultiuseBrush</wornGraphicPath>
    </apparel>

    <costStuffCount>45</costStuffCount>
    <stuffCategories>
      <li>VV_Wax</li>
      <li>Woody</li>
    </stuffCategories>
    <recipeMaker>
      <recipeUsers>
        <li>CraftingSpot</li>
        <li>ElectricSmithy</li>
        <li>FueledSmithy</li>
      </recipeUsers>
      <researchPrerequisites>
        <li>VV_Tools</li>
      </researchPrerequisites>
      <displayPriority>-501</displayPriority>
    </recipeMaker>
  </ThingDef>

  <!-- VV_ArcaneFloralPerfume -->
  <ThingDef ParentName="VV_UtilityApparelBase">
    <defName>VV_ArcaneFloralPerfume</defName>
    <label>arcane floral perfume</label>
    <description>A perfume bottle that holds the scents of arcane flowers. Once charged with pollen, it can collect and store a scent from an arcane flower.
\nA collected scent can be sprayed up to five times, granting its fragrance to everyone nearby. Only one arcane floral scent can take effect at a time.</description>
    <thingClass>VVRace.Apparel_ScentBottle</thingClass>
    <graphicData>
      <texPath>Things/Item/Equipment/VV_PerfumeA</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
    </graphicData>

    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <WorkToMake>3500</WorkToMake>
      <Mass>0.1</Mass>
      <Flammability>0.5</Flammability>
      <EquipDelay>1.0</EquipDelay>
    </statBases>

    <costList>
      <VV_Viviwax>40</VV_Viviwax>
      <VV_LivingLeaf>20</VV_LivingLeaf>
    </costList>

    <comps>
      <li Class="VVRace.CompProperties_ScentBottle">
        <pollenDef>VV_Pollen</pollenDef>
        <pollenCostPerCharge>200</pollenCostPerCharge>
        <gatherTicks>1500</gatherTicks>
        <loadTicks>150</loadTicks>
        <maxSprays>5</maxSprays>

        <filledGraphicPath>Things/Item/Equipment/VV_PerfumeB</filledGraphicPath>
        <emptyWornGraphicPath>Things/Apparel/Perfume/VV_PerfumeA</emptyWornGraphicPath>
        <filledWornGraphicPath>Things/Apparel/Perfume/VV_PerfumeB</filledWornGraphicPath>
      </li>
      <li Class="VVRace.CompProperties_ScentVerbOwner" />
    </comps>

    <verbs>
      <li Class="VVRace.VerbProperties_SprayScent">
        <label>spray scent</label>
        <violent>false</violent>
        <range>4.9</range>
        <warmupTime>0.5</warmupTime>
        <drawAimPie>false</drawAimPie>
        <defaultCooldownTime>0</defaultCooldownTime>
        <hasStandardCommand>true</hasStandardCommand>
        <targetable>false</targetable>
        <nonInterruptingSelfCast>true</nonInterruptingSelfCast>
        <onlyManualCast>true</onlyManualCast>
        <requireLineOfSight>false</requireLineOfSight>
        <ai_IsWeapon>false</ai_IsWeapon>
        <targetParams>
          <canTargetSelf>true</canTargetSelf>
          <canTargetLocations>false</canTargetLocations>
          <canTargetPawns>false</canTargetPawns>
          <canTargetBuildings>false</canTargetBuildings>
        </targetParams>
        <commandIcon>UI/Commands/VV_SprayScent</commandIcon>
      </li>
    </verbs>

    <apparel>
      <wornGraphicData Inherit="False">
        <renderUtilityAsPack>false</renderUtilityAsPack>
      </wornGraphicData>
      <renderNodeProperties>
        <li Class="RPEF.PawnRenderNodeProperties_BodyTypeDrawData">
          <nodeClass>VVRace.PawnRenderNode_ScentBottle</nodeClass>
          <workerClass>VVRace.PawnRenderNodeWorker_ScentBottle</workerClass>
          <bodyTypeDrawData>
            <Male>
              <dataEast><offset>(0,0,0)</offset></dataEast>
              <dataSouth><offset>(0,0,0)</offset></dataSouth>
              <dataNorth><offset>(0,0,0)</offset></dataNorth>
            </Male>
            <Female>
              <dataEast><offset>(0,0,0)</offset></dataEast>
              <dataSouth><offset>(0,0,0)</offset></dataSouth>
              <dataNorth><offset>(0,0,0)</offset></dataNorth>
            </Female>
            <Hulk>
              <dataEast><offset>(0,0,-0.2)</offset></dataEast>
              <dataSouth><offset>(-0.15,0,-0.2)</offset></dataSouth>
              <dataNorth><offset>(0.15,0,-0.1)</offset></dataNorth>
              <scale>1.2</scale>
            </Hulk>
            <Fat>
              <dataEast><offset>(0,0,-0.2)</offset></dataEast>
              <dataSouth><offset>(-0.2,0,-0.2)</offset></dataSouth>
              <dataNorth><offset>(0.2,0,-0.1)</offset></dataNorth>
              <scale>1.2</scale>
            </Fat>
          </bodyTypeDrawData>
        </li>
      </renderNodeProperties>
    </apparel>

    <recipeMaker>
      <recipeUsers>
        <li>CraftingSpot</li>
        <li>ElectricSmithy</li>
        <li>FueledSmithy</li>
      </recipeUsers>
      <researchPrerequisites>
        <li>VV_Perfumery</li>
      </researchPrerequisites>
      <displayPriority>-502</displayPriority>
    </recipeMaker>
    
    <modExtensions>
      <li Class="RPEF.ApparelGraphicHook">
        <defaultBodyTypeGraphicOverride>Thin</defaultBodyTypeGraphicOverride>
      </li>
    </modExtensions>
  </ThingDef>
</Defs>
