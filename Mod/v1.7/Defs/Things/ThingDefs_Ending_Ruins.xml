<?xml version="1.0" encoding="UTF-8"?>
<Defs>
  <!-- 고대 유적 요정꽃: 번호(index) 순서대로만 조사할 수 있다 -->
  <ThingDef Name="VV_AncientRuinFairyFlowerBase" ParentName="BuildingBase" Abstract="True">
    <label>fairy bloom</label>
    <description>An unknown, mysterious arcane flower. A memory still lingers within it. A royal vivi linked to an everflower of attunement level 4 or higher can touch it to see the memory.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Things/Building/VV_FairyFlower</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawRotated>false</drawRotated>
      <shaderType>Transparent</shaderType>
      <drawSize>(1.6, 1.6)</drawSize>
    </graphicData>
    <soundImpactDefault>BulletImpact_Wood</soundImpactDefault>
    <tickerType>Normal</tickerType>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Standable</passability>
    <pathCost>0</pathCost>
    <fillPercent>0</fillPercent>
    <rotatable>false</rotatable>
    <useHitPoints>false</useHitPoints>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <statBases>
      <Flammability>0</Flammability>
      <Beauty>15</Beauty>
    </statBases>
    <building>
      <deconstructible>false</deconstructible>
      <claimable>false</claimable>
      <repairable>false</repairable>
      <isTargetable>false</isTargetable>
      <canBeDamagedByAttacks>false</canBeDamagedByAttacks>
      <isInert>true</isInert>
      <ai_neverTrashThis>true</ai_neverTrashThis>
      <ai_chillDestination>false</ai_chillDestination>
      <expandHomeArea>false</expandHomeArea>
    </building>
    <comps>
      <li Class="CompProperties_Effecter">
        <effecterDef>VV_Effecter_FairyFlowerAura</effecterDef>
      </li>
      <li Class="CompProperties_Usable">
        <useJob>UseItem</useJob>
        <useLabel>Touch {0_label}</useLabel>
        <useDuration>300</useDuration>
      </li>
      <li Class="CompProperties_UseEffectDestroySelf">
        <effecterDef>VV_Effecter_FairyFlowerVanish</effecterDef>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="VV_AncientRuinFairyFlowerBase">
