        <index>3</index>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="VV_AncientRuinFairyFlowerBase">
    <defName>VV_AncientRuinFairyFlowerIV</defName>
    <description>An unknown, mysterious arcane flower. The oldest memory still lingers within it. A royal vivi linked to an everflower of attunement level 4 or higher can touch it to see the memory.</description>
