    <comps>
      <li Class="VVRace.CompProperties_UseEffectRuinEcho">
        <index>4</index>
      </li>
    </comps>
  </ThingDef>

  <!-- 고대 유적 중심 제단: 마지막 요정꽃을 조사한 뒤 고대 호박 코어를 한 번 추출할 수 있다 -->
  <ThingDef ParentName="BuildingBase">
    <defName>VV_AncientRuinAltar</defName>
    <label>ruined central altar</label>
    <description>The central altar of the old vivi empire, preserved inside the inner sanctum. An ancient amber core is still set within it.</description>
    <descriptionHyperlinks>
      <ThingDef>VV_AncientAmberCore</ThingDef>
    </descriptionHyperlinks>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Things/Building/VV_EverflowerAltar</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawRotated>false</drawRotated>
      <drawSize>(10, 10)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Standable</passability>
    <pathCost>100</pathCost>
    <size>(5,5)</size>
    <rotatable>false</rotatable>
    <useHitPoints>false</useHitPoints>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <statBases>
      <Flammability>0</Flammability>
      <Beauty>20</Beauty>
    </statBases>
    <building>
      <deconstructible>false</deconstructible>
      <claimable>false</claimable>
      <repairable>false</repairable>
      <isTargetable>false</isTargetable>
      <canBeDamagedByAttacks>false</canBeDamagedByAttacks>
      <isInert>true</isInert>
      <ai_neverTrashThis>true</ai_neverTrashThis>
      <ai_chillDestination>false</ai_chillDestination>
      <expandHomeArea>false</expandHomeArea>
    </building>
    <comps>
      <li Class="CompProperties_Usable">
        <useJob>UseItem</useJob>
        <useLabel>Extract the ancient amber core</useLabel>
        <useDuration>600</useDuration>
      </li>
      <li Class="CompProperties_UseEffect">
        <compClass>VVRace.CompUseEffect_ExtractAmberCore</compClass>
      </li>
    </comps>
  </ThingDef>

  <!-- 공간 왜곡 결계: 봉인된 유적 외곽을 가로막는 투명 장벽 -->
  <ThingDef ParentName="BuildingBase">
    <defName>VV_RuinSpatialBarrier</defName>
    <label>spatial distortion barrier</label>
    <description>An ancient psychic mana field warps space itself, hiding whatever structure lies beyond and blocking all passage. Touching the ancient fairy bloom in the preceding zone will lift this seal.</description>
    <thingClass>VVRace.Building_RuinSpatialBarrier</thingClass>
    <graphicData>
      <texPath>VFX/VV_FairyPhaseRing</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>Transparent</shaderType>
      <color>(1, 0.92, 0.65, 0)</color>
    </graphicData>
    <uiIconPath>VFX/VV_FairyPhaseRing</uiIconPath>
    <uiIconColor>(0.92, 0.86, 0.58, 1)</uiIconColor>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Impassable</passability>
    <fillPercent>1</fillPercent>
    <blockWind>true</blockWind>
    <blockLight>false</blockLight>
    <castEdgeShadows>false</castEdgeShadows>
    <holdsRoof>false</holdsRoof>
    <rotatable>false</rotatable>
    <useHitPoints>false</useHitPoints>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <preventSkyfallersLandingOn>true</preventSkyfallersLandingOn>
    <statBases>
      <Flammability>0</Flammability>
    </statBases>
    <building>
      <deconstructible>false</deconstructible>
      <claimable>false</claimable>
      <repairable>false</repairable>
      <isTargetable>false</isTargetable>
      <canBeDamagedByAttacks>false</canBeDamagedByAttacks>
      <isInert>true</isInert>
      <ai_neverTrashThis>true</ai_neverTrashThis>
      <ai_chillDestination>false</ai_chillDestination>
      <expandHomeArea>false</expandHomeArea>
      <canPlaceOverWall>false</canPlaceOverWall>
    </building>
  </ThingDef>

