  <!-- 유적 시련의 방 입구 멸망꽃 (저주 없음 · 파괴 시 길 안내 잔향 생성 및 재생성) -->
  <ThingDef ParentName="BuildingBase">
    <defName>VV_RuinDoomFlower</defName>
    <label>echoing doom bloom</label>
    <description>A lingering doom bloom rooted at the threshold of the silent hall. Unlike the cursed blooms of a rampaging empress, it casts no curse; each time it is destroyed, a faint wisp of memory drifts along the unseen safe path before the flower regrows.</description>
    <thingClass>VVRace.Building_RuinDoomFlower</thingClass>
    <graphicData>
      <texPath>Things/Building/VV_DoomFlower</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawRotated>false</drawRotated>
