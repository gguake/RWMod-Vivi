        <index>2</index>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="VV_AncientRuinFairyFlowerBase">
    <defName>VV_AncientRuinFairyFlowerIII</defName>
    <comps>
      <li Class="VVRace.CompProperties_UseEffectRuinEcho">
        <index>3</index>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="VV_AncientRuinFairyFlowerBase">
