<?xml version="1.0" encoding="UTF-8"?>
<Defs>

  <!-- 멸망꽃 -->
  <ThingDef ParentName="BuildingBase">
    <defName>VV_DoomFlower</defName>
    <label>doom bloom</label>
    <description>A cursed flower grown from the ancient vivi queen's warped memories and mana. If it is not destroyed before it fully blooms, visions of the old catastrophe spread and lay a deadly curse on every colonist in the area.</description>
    <thingClass>VVRace.Building_DoomFlower</thingClass>
    <graphicData>
      <texPath>Things/Building/VV_DoomFlower</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawRotated>false</drawRotated>
      <shaderType>Transparent</shaderType>
      <drawSize>(1.6, 1.6)</drawSize>
    </graphicData>
    <soundImpactDefault>BulletImpact_Wood</soundImpactDefault>
    <filthLeaving>Filth_Ash</filthLeaving>
    <drawerType>RealtimeOnly</drawerType>
    
    <drawOffscreen>true</drawOffscreen>
    <tickerType>Normal</tickerType>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>30</pathCost>
    <fillPercent>0.2</fillPercent>
    <rotatable>false</rotatable>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <statBases>
      <MaxHitPoints>150</MaxHitPoints>
      <Flammability>0.5</Flammability>
      <Beauty>-15</Beauty>
    </statBases>
    <building>
      <deconstructible>false</deconstructible>
      <claimable>false</claimable>
      <repairable>false</repairable>
      <isInert>true</isInert>
      <ai_neverTrashThis>true</ai_neverTrashThis>
      <ai_chillDestination>false</ai_chillDestination>
      <expandHomeArea>false</expandHomeArea>
      <destroyEffecter>VV_Effecter_DoomFlowerDestroy</destroyEffecter>
    </building>
    <comps>
      <li Class="CompProperties_Effecter">
        <effecterDef>VV_Effecter_DoomFlowerAura</effecterDef>
      </li>
    </comps>
    <modExtensions>
      <li Class="VVRace.ApocryphaFlowerExtension">
        <bloomEffecter>VV_Effecter_SeedBloomDoom</bloomEffecter>
        <witherEffecter>VV_Effecter_DoomFlowerWither</witherEffecter>
        <linkColor>(1, 0.35, 0.8, 1)</linkColor>
        <linkWidth>0.85</linkWidth>
        <linkOffset>(0.15, 0, 0.25)</linkOffset>
      </li>
    </modExtensions>
  </ThingDef>

  <!-- 요정꽃 문양 잔존 -->
  <ThingDef ParentName="EtherealThingBase">
    <defName>VV_FairySigilWard</defName>
    <label>fairy sigil</label>
    <thingClass>VVRace.FairySigilWard</thingClass>
    <tickerType>Normal</tickerType>
    <drawerType>RealtimeOnly</drawerType>
    <drawOffscreen>true</drawOffscreen>
    <altitudeLayer>MoteLow</altitudeLayer>
    <selectable>false</selectable>
  </ThingDef>

  <!-- 요정꽃 -->
  <ThingDef ParentName="BuildingBase">
    <defName>VV_FairyFlower</defName>
    <label>fairy bloom</label>
    <description>A flower born from the spreading mana of the fairy vivis wrapped around the empress of the nightshade. When a normal vivi resonates with it, she connects to the flower with an energy line and becomes bound to the empress.\n\nThe empress can use psychic power channeled through fairy blooms to forcibly bind vivis to herself. Conversely, binding the empress to the everflower can free the fairy vivis bound to her.\n\nIt can also be destroyed by attacks, but doing so makes the empress's attacks fiercer.</description>
    <thingClass>VVRace.Building_FairyFlower</thingClass>
    <graphicData>
      <texPath>Things/Building/VV_FairyFlower</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawRotated>false</drawRotated>
      <shaderType>Transparent</shaderType>
      <drawSize>(1.6, 1.6)</drawSize>
    </graphicData>
    <soundImpactDefault>BulletImpact_Wood</soundImpactDefault>
    <drawerType>RealtimeOnly</drawerType>

    <drawOffscreen>true</drawOffscreen>
    <tickerType>Normal</tickerType>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Standable</passability>
    <pathCost>0</pathCost>
    <fillPercent>0</fillPercent>
    <rotatable>false</rotatable>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <statBases>
      <MaxHitPoints>2000</MaxHitPoints>
      <Flammability>0</Flammability>
      <Beauty>15</Beauty>
    </statBases>
    <building>
      <deconstructible>false</deconstructible>
      <claimable>false</claimable>
      <repairable>false</repairable>
      <isInert>true</isInert>
      <ai_neverTrashThis>true</ai_neverTrashThis>
      <ai_chillDestination>false</ai_chillDestination>
      <expandHomeArea>false</expandHomeArea>
    </building>
    <comps>
      <li Class="CompProperties_Effecter">
        <effecterDef>VV_Effecter_FairyFlowerAura</effecterDef>
      </li>
    </comps>
    <modExtensions>
      <li Class="VVRace.ApocryphaFlowerExtension">
        <bloomEffecter>VV_Effecter_SeedBloomFairy</bloomEffecter>
        <witherEffecter>VV_Effecter_FairyFlowerVanish</witherEffecter>
        <linkColor>(1, 0.9, 0.6, 1)</linkColor>
        <linkWidth>1</linkWidth>
        <linkOffset>(0, 0, 0.3)</linkOffset>
      </li>
    </modExtensions>
  </ThingDef>
</Defs>
