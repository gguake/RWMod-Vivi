<?xml version="1.0" encoding="UTF-8"?>
<Defs>
  <!-- 연방의 옛 동화책: 제목·본문은 같은 이름의 RulePackDef가 고정 문장으로 만든다 -->
  <ThingDef Name="VV_FairyTaleBookBase" ParentName="BookBase" Abstract="True">
    <description>An old fairy tale passed down among the vivi federation. By long-standing custom, the federation sends it to nests that are newly growing.</description>
    <graphicData>
      <texPath>Things/Item/Book/Novel/Novel</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>0.8</drawSize>
    </graphicData>
    <uiIconPath>Things/Item/Book/Novel/Novel</uiIconPath>
    <statBases>
      <MarketValue>160</MarketValue>
    </statBases>
    <tradeability>Sellable</tradeability>
    <generateCommonality>0</generateCommonality>
    <thingSetMakerTags Inherit="False" />
  </ThingDef>

  <ThingDef ParentName="VV_FairyTaleBookBase">
    <defName>VV_FairyTaleBookI</defName>
    <label>flowershade tales I</label>
    <comps>
      <li Class="CompProperties_Book">
        <nameMaker>VV_FairyTaleBookI</nameMaker>
        <descriptionMaker>VV_FairyTaleBookI</descriptionMaker>
        <ageYearsRange>100~200</ageYearsRange>
        <pickWeight>0</pickWeight>
        <openGraphic>
          <texPath>Things/Item/Book/Novel/Novel_Open</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>0.7</drawSize>
        </openGraphic>
        <verticalGraphic>
          <texPath>Things/Item/Book/Novel/Novel_Vertical</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <addTopAltitudeBias>true</addTopAltitudeBias>
        </verticalGraphic>
        <doers>
          <li Class="BookOutcomeProperties_JoyFactorModifier" />
        </doers>
      </li>
    </comps>
  </ThingDef>

