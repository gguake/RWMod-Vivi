<?xml version="1.0" encoding="UTF-8"?>
<Defs>
  <!-- 영원꽃 제단 -->
  <ThingDef ParentName="BuildingBase">
    <defName>VV_EverflowerAltar</defName>
    <label>everflower altar</label>
    <description>An altar restored from the designs of the old vivi empire. Its amber core and mana circuits support the everflower's growth.\n\nAn everflower of attunement level 4 or higher can be enshrined here and cannot be moved afterward. The altar cannot be destroyed by attacks. Only one can be built per map.</description>
    <descriptionHyperlinks>
      <ThingDef>VV_Everflower</ThingDef>
      <ThingDef>VV_AncientAmberCore</ThingDef>
    </descriptionHyperlinks>

    <thingClass>VVRace.Building_EverflowerAltar</thingClass>

    <graphicData>
      <texPath>Things/Building/VV_EverflowerAltar</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawRotated>false</drawRotated>
      <drawSize>(10, 10)</drawSize>
    </graphicData>

    <uiOrder>2405</uiOrder>
    <uiIconScale>0.9</uiIconScale>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Standable</passability>
    <pathCost>100</pathCost>
    <pathCostIgnoreRepeat>false</pathCostIgnoreRepeat>
    <size>(5,5)</size>
    <rotatable>false</rotatable>
    <canOverlapZones>false</canOverlapZones>

    <statBases>
      <MaxHitPoints>3000</MaxHitPoints>
      <WorkToBuild>30000</WorkToBuild>
      <Beauty>50</Beauty>
      <Flammability>0</Flammability>
    </statBases>

    <costList>
      <VV_AncientAmberCore>1</VV_AncientAmberCore>
      <VV_Viviwax>120</VV_Viviwax>
      <VV_Lifestrand>60</VV_Lifestrand>
      <VV_Propolis>50</VV_Propolis>
      <VV_PerfumingPetal>200</VV_PerfumingPetal>
    </costList>
    <resourcesFractionWhenDeconstructed>1</resourcesFractionWhenDeconstructed>
    <constructEffect>ConstructWood</constructEffect>
    <constructionSkillPrerequisite>8</constructionSkillPrerequisite>

    <building>
      <isInert>true</isInert>
      <ai_neverTrashThis>true</ai_neverTrashThis>
      <artificialForMeditationPurposes>false</artificialForMeditationPurposes>
      <canBeDamagedByAttacks>false</canBeDamagedByAttacks>
      <forcedCostLeavings>
        <li>VV_AncientAmberCore</li>
      </forcedCostLeavings>
    </building>

    <comps>
      <li Class="CompProperties_Glower">
        <glowRadius>5</glowRadius>
        <glowColor>(255,186,96,0)</glowColor>
      </li>
    </comps>

    <placeWorkers>
      <li>VVRace.PlaceWorker_EverflowerAltar</li>
    </placeWorkers>

    <designationCategory>VV_Bulidings</designationCategory>
  </ThingDef>

  <!-- 고대 호박 코어 -->
  <ThingDef ParentName="ResourceBase">
    <defName>VV_AncientAmberCore</defName>
    <label>ancient amber core</label>
    <description>An amber crystal used in the everflower altars of the old vivi empire. The vivi federation holds the surviving cores.\n\nObtained by completing a task for the federation.</description>
    <descriptionHyperlinks>
      <ThingDef>VV_EverflowerAltar</ThingDef>
    </descriptionHyperlinks>

    <graphicData>
      <texPath>Things/Item/VV_AncientAmberCore</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>

    <resourceReadoutPriority>Middle</resourceReadoutPriority>
    <soundInteract>ChunkRock_Drop</soundInteract>
    <soundDrop>ChunkRock_Drop</soundDrop>
    <stackLimit>1</stackLimit>
    <drawGUIOverlay>false</drawGUIOverlay>
    <useHitPoints>true</useHitPoints>
    <healthAffectsPrice>false</healthAffectsPrice>

    <statBases>
      <MarketValue>2500</MarketValue>
      <MaxHitPoints>200</MaxHitPoints>
      <Mass>2</Mass>
      <Flammability>0</Flammability>
      <DeteriorationRate>0</DeteriorationRate>
    </statBases>

    <thingCategories>
      <li>ItemsMisc</li>
    </thingCategories>

    <tradeability>None</tradeability>
    <thingSetMakerTags>
      <li>NonStandardReward</li>
    </thingSetMakerTags>
  </ThingDef>
</Defs>
