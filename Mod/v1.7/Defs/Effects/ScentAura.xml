      <shaderType>MoteGlow</shaderType>
      <renderInstanced>true</renderInstanced>
    </graphicData>
    <fadeInTime>0.02</fadeInTime>
    <solidTime>0.06</solidTime>
    <fadeOutTime>0.15</fadeOutTime>
  </FleckDef>

  <!-- Waterdrops: rising bubble, grows slightly -->
  <FleckDef ParentName="VV_ScentFleckBase">
    <defName>VV_Fleck_ScentBubble</defName>
    <graphicData>
      <texPath>VFX/VV_ScentBubble</texPath>
      <graphicClass>Graphic_Fleck</graphicClass>
      <shaderType>MoteGlow</shaderType>
      <renderInstanced>true</renderInstanced>
