  </FleckDef>

  <!-- Starlitflower: shooting star. Texture tail points up, so trail the tail
       behind the falling head with the 180-degree extra angle. -->
  <FleckDef ParentName="VV_ScentFleckBase">
    <defName>VV_Fleck_ScentComet</defName>
    <graphicData>
      <texPath>VFX/VV_ScentComet</texPath>
      <graphicClass>Graphic_Fleck</graphicClass>
      <shaderType>MoteGlow</shaderType>
      <renderInstanced>true</renderInstanced>
    </graphicData>
    <fadeInTime>0.02</fadeInTime>
    <solidTime>0.35</solidTime>
    <fadeOutTime>0.45</fadeOutTime>
    <rotateTowardsMoveDirection>true</rotateTowardsMoveDirection>
    <rotateTowardsMoveDirectionExtraAngle>180</rotateTowardsMoveDirectionExtraAngle>
  </FleckDef>

  <!-- FrostBloom: slowly spinning snowflake crystal -->
  <FleckDef ParentName="VV_ScentFleckBase">
    <defName>VV_Fleck_ScentFrost</defName>
