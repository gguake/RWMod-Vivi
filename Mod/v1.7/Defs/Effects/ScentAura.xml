  </FleckDef>

  <!-- ======================== Effecters ======================== -->
  <!-- One per scent: shared halo tinted to the scent color + a signature
       particle. Densities stay at 2-3 visible particles per pawn. -->

  <!-- 전기봉오리: charge specks drift in a slow orbit close to the pawn -->
  <EffecterDef>
    <defName>VV_ScentAura_Shockerbud</defName>
    <offsetMode>Free</offsetMode>
    <children>
      <li>
        <subEffecterClass>SubEffecter_SprayerContinuous</subEffecterClass>
        <fleckDef>VV_Fleck_ScentAuraRing</fleckDef>
        <spawnLocType>OnSource</spawnLocType>
        <ticksBetweenMotes>90</ticksBetweenMotes>
        <burstCount>1</burstCount>
        <scale>1</scale>
        <rotationRate>-10~10</rotationRate>
        <color>(0.8, 0.4, 0.8, 0.17)</color>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SprayerContinuous</subEffecterClass>
        <fleckDef>VV_Fleck_ScentCharge</fleckDef>
        <spawnLocType>OnSource</spawnLocType>
        <initialDelayTicks>20</initialDelayTicks>
        <ticksBetweenMotes>40</ticksBetweenMotes>
        <burstCount>1</burstCount>
        <positionRadiusMin>0.25</positionRadiusMin>
        <positionRadius>0.5</positionRadius>
        <orbitOrigin>true</orbitOrigin>
        <orbitSpeed>-1.5~1.5</orbitSpeed>
        <orbitSnapStrength>0.5</orbitSnapStrength>
        <scale>0.20~0.28</scale>
        <color>(0.8, 0.4, 0.8, 0.7)</color>
      </li>
    </children>
  </EffecterDef>

  <!-- 번개꽃: quiet, then an irregular quick spark or two -->
  <EffecterDef>
    <defName>VV_ScentAura_Thunderpetals</defName>
    <offsetMode>Free</offsetMode>
    <children>
      <li>
        <subEffecterClass>SubEffecter_SprayerContinuous</subEffecterClass>
        <fleckDef>VV_Fleck_ScentAuraRing</fleckDef>
        <spawnLocType>OnSource</spawnLocType>
        <ticksBetweenMotes>90</ticksBetweenMotes>
        <burstCount>1</burstCount>
        <scale>1</scale>
        <rotationRate>-10~10</rotationRate>
        <color>(0.78, 0.45, 0.95, 0.17)</color>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SprayerChance</subEffecterClass>
        <fleckDef>VV_Fleck_ScentSpark</fleckDef>
        <spawnLocType>OnSource</spawnLocType>
        <initialDelayTicks>40</initialDelayTicks>
        <chancePeriodTicks>70</chancePeriodTicks>
        <chancePerTick>0.018</chancePerTick>
        <burstCount>1~2</burstCount>
        <positionRadiusMin>0.15</positionRadiusMin>
        <positionRadius>0.45</positionRadius>
        <absoluteAngle>true</absoluteAngle>
        <angle>0~360</angle>
        <speed>0.05~0.2</speed>
        <fleckUsesAngleForVelocity>true</fleckUsesAngleForVelocity>
        <rotation>0~360</rotation>
        <scale>0.38~0.55</scale>
        <color>(0.92, 0.7, 1.0, 0.95)</color>
      </li>
    </children>
  </EffecterDef>

