        <burstCount>1</burstCount>
        <positionOffset>(0, 0, -0.3)</positionOffset>
        <positionRadiusMin>0.1</positionRadiusMin>
        <positionRadius>0.3</positionRadius>
        <absoluteAngle>true</absoluteAngle>
        <angle>-12~12</angle>
        <speed>0.12~0.2</speed>
        <fleckUsesAngleForVelocity>true</fleckUsesAngleForVelocity>
        <scale>0.14~0.22</scale>
        <color>(0.5, 0.8, 1.0, 0.7)</color>
      </li>
    </children>
  </EffecterDef>

