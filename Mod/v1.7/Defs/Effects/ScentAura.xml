<?xml version="1.0" encoding="UTF-8"?>
<Defs>

  <!-- ======================== Flecks ======================== -->
  <!-- Shared base: overhead-low altitude, follows the pawn via attach link.
       Textures VV_ScentAura / VV_ScentElectric / VV_ScentComet are grayscale
       so the per-scent <color> tint below shows true. -->
  <FleckDef ParentName="FleckBase_Thrown" Name="VV_ScentFleckBase" Abstract="True">
    <altitudeLayer>MoteOverheadLow</altitudeLayer>
    <useAttachLink>true</useAttachLink>
  </FleckDef>

  <!-- Common aura halo, tinted per scent. 120-tick lifetime, gentle swell. -->
  <FleckDef ParentName="VV_ScentFleckBase">
    <defName>VV_Fleck_ScentAura</defName>
    <graphicData>
      <texPath>VFX/VV_ScentAura</texPath>
      <graphicClass>Graphic_Fleck</graphicClass>
      <shaderType>MoteGlow</shaderType>
      <renderInstanced>true</renderInstanced>
      <drawSize>1.35</drawSize>
    </graphicData>
    <fadeInTime>0.4</fadeInTime>
    <solidTime>0.4</solidTime>
    <fadeOutTime>1.2</fadeOutTime>
    <growthRate>0.04</growthRate>
  </FleckDef>

  <!-- Ring variant of the halo: wispy magic circle for energy/frost scents -->
  <FleckDef ParentName="VV_ScentFleckBase">
    <defName>VV_Fleck_ScentAuraRing</defName>
    <graphicData>
      <texPath>VFX/VV_ScentAura2</texPath>
      <graphicClass>Graphic_Fleck</graphicClass>
      <shaderType>MoteGlow</shaderType>
      <renderInstanced>true</renderInstanced>
      <drawSize>1.35</drawSize>
    </graphicData>
    <fadeInTime>0.4</fadeInTime>
    <solidTime>0.4</solidTime>
    <fadeOutTime>1.2</fadeOutTime>
    <growthRate>0.04</growthRate>
  </FleckDef>

  <!-- Shockerbud: slow-drifting charge speck -->
  <FleckDef ParentName="VV_ScentFleckBase">
    <defName>VV_Fleck_ScentCharge</defName>
    <graphicData>
      <texPath>VFX/VV_ScentElectric</texPath>
      <graphicClass>Graphic_Fleck</graphicClass>
      <shaderType>MoteGlow</shaderType>
      <renderInstanced>true</renderInstanced>
    </graphicData>
    <fadeInTime>0.25</fadeInTime>
    <solidTime>0.6</solidTime>
    <fadeOutTime>0.6</fadeOutTime>
  </FleckDef>

  <!-- Thunderpetals: near-instant lightning-arc flash -->
  <FleckDef ParentName="VV_ScentFleckBase">
    <defName>VV_Fleck_ScentSpark</defName>
    <graphicData>
      <texPath>VFX/VV_ScentSparkArc</texPath>
