    <solidTime>0.7</solidTime>
    <fadeOutTime>0.5</fadeOutTime>
    <growthRate>0.05</growthRate>
  </FleckDef>

  <!-- Radiant/Rich/Ember: pollen-like light speck -->
  <FleckDef ParentName="VV_ScentFleckBase">
