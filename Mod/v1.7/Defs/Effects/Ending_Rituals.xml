<?xml version="1.0" encoding="UTF-8"?>
<Defs>


  <!-- 만개 의식 황금 파동 고리 -->
  <FleckDef ParentName="FleckBase">
    <defName>VV_Fleck_ResonanceWaveRing</defName>
    <altitudeLayer>MoteOverheadLow</altitudeLayer>
    <fadeInTime>0.05</fadeInTime>
    <solidTime>0.7</solidTime>
    <fadeOutTime>1.1</fadeOutTime>
    <growthRate>14</growthRate>
    <drawOffscreen>true</drawOffscreen>
    <graphicData>
      <texPath>VFX/VV_GoldenWaveRing</texPath>
      <shaderType>MoteGlow</shaderType>
      <drawSize>(4, 4)</drawSize>
    </graphicData>
  </FleckDef>

  <!-- 만개 의식 잔향 고리 -->
  <FleckDef ParentName="FleckBase">
    <defName>VV_Fleck_ResonanceWaveRingSlow</defName>
    <altitudeLayer>MoteOverheadLow</altitudeLayer>
    <fadeInTime>0.1</fadeInTime>
    <solidTime>0.8</solidTime>
    <fadeOutTime>1.3</fadeOutTime>
    <growthRate>6</growthRate>
    <drawOffscreen>true</drawOffscreen>
    <graphicData>
      <texPath>VFX/VV_GoldenWaveRing</texPath>
      <shaderType>MoteGlow</shaderType>
      <color>(1, 1, 1, 0.7)</color>
      <drawSize>(4, 4)</drawSize>
    </graphicData>
  </FleckDef>

  <!-- 만개 의식 마법진 -->
  <ThingDef ParentName="MoteBase">
    <defName>VV_Mote_GrandAttunementCircle</defName>
    <thingClass>MoteAttached</thingClass>
    <altitudeLayer>MoteOverheadLow</altitudeLayer>
    <drawOffscreen>true</drawOffscreen>
    <mote>
      <fadeInTime>0.1</fadeInTime>
      <fadeOutTime>1.4</fadeOutTime>
      <solidTime>0.2</solidTime>
      <growthRate>6</growthRate>
    </mote>
    <graphicData>
      <texPath>Things/Mote/RadiationDistortion_B</texPath>
      <graphicClass>Graphic_MoteWithAgeSecs</graphicClass>
      <color>(1, 0.9, 0.6, 1)</color>
      <shaderType>MoteMultiplyAddCircular</shaderType>
      <shaderParameters>
        <_MultiplyTex>/Things/Mote/RadiationDistortion_B</_MultiplyTex>
        <_texAScale>0.3</_texAScale>
        <_texBScale>0.3</_texBScale>
        <_texAScrollSpeed>0.4</_texAScrollSpeed>
        <_texBScrollSpeed>-0.3</_texBScrollSpeed>
        <_texAScaleDist>0.5</_texAScaleDist>
        <_DistortionScale>0.5</_DistortionScale>
        <_Intensity>5</_Intensity>
      </shaderParameters>
      <drawSize>(14, 14)</drawSize>
    </graphicData>
  </ThingDef>

  <!-- 만개 의식 섬광 -->
  <ThingDef ParentName="MoteBase">
    <defName>VV_Mote_GrandAttunementFlash</defName>
    <thingClass>MoteAttached</thingClass>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <drawOffscreen>true</drawOffscreen>
    <mote>
      <fadeInTime>0.01</fadeInTime>
      <fadeOutTime>1.2</fadeOutTime>
      <solidTime>0.3</solidTime>
    </mote>
    <graphicData>
      <texPath>Things/Mote/BrightFlash</texPath>
      <shaderType>MoteGlow</shaderType>
      <color>(1.0, 0.92, 0.6, 0.85)</color>
      <drawSize>(30, 30)</drawSize>
    </graphicData>
  </ThingDef>

  <!-- 만개 의식 완료 효과 -->
  <EffecterDef>
    <defName>VV_Effecter_GrandAttunementComplete</defName>
    <children>
      <li>
        <subEffecterClass>SubEffecter_SoundTriggered</subEffecterClass>
        <soundDef>VV_EverflowerRitualComplete</soundDef>
        <spawnLocType>OnSource</spawnLocType>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SoundTriggered</subEffecterClass>
        <soundDef>VV_Manawave</soundDef>
        <spawnLocType>OnSource</spawnLocType>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
        <moteDef>VV_Mote_GrandAttunementCircle</moteDef>
        <spawnLocType>OnSource</spawnLocType>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
        <fleckDef>VV_ExpandingDistortionRing</fleckDef>
        <spawnLocType>OnSource</spawnLocType>
        <burstCount>1</burstCount>
        <scale>2.5</scale>
        <rotation>0</rotation>
        <angle>0~0</angle>
        <speed>0</speed>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
        <moteDef>VV_Mote_GrandAttunementFlash</moteDef>
        <burstCount>1</burstCount>
        <spawnLocType>OnSource</spawnLocType>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
        <fleckDef>VV_Fleck_ResonanceWaveRing</fleckDef>
        <spawnLocType>OnSource</spawnLocType>
        <burstCount>1</burstCount>
        <absoluteAngle>true</absoluteAngle>
        <rotation>0~360</rotation>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
        <fleckDef>VV_Fleck_EverflowerPetal_Burst</fleckDef>
        <spawnLocType>OnSource</spawnLocType>
        <burstCount>60~80</burstCount>
        <positionRadius>1</positionRadius>
        <angle>0~360</angle>
        <fleckUsesAngleForVelocity>true</fleckUsesAngleForVelocity>
        <speed>1.5~4.5</speed>
        <rotation>0~360</rotation>
        <rotationRate>-260~260</rotationRate>
        <scale>0.3~0.7</scale>
      </li>
    </children>
  </EffecterDef>

