<?xml version="1.0" encoding="UTF-8"?>
<Defs>
  <!-- 영원꽃 동화 입자 -->
  <FleckDef ParentName="FleckBase_Thrown">
    <defName>VV_Fleck_AssimilationMote</defName>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <fadeInTime>0.15</fadeInTime>
    <solidTime>0.75</solidTime>
    <fadeOutTime>0.3</fadeOutTime>
    <graphicData>
      <texPath>Things/Mote/SparkFlash</texPath>
      <shaderType>MoteGlow</shaderType>
      <renderInstanced>true</renderInstanced>
      <color>(1, 0.92, 0.62, 1)</color>
    </graphicData>
  </FleckDef>

  <!-- 아스포델 영혼 입자 -->
  <FleckDef ParentName="FleckBase_Thrown">
    <defName>VV_Fleck_AssimilationSoul</defName>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <fadeInTime>0.1</fadeInTime>
    <solidTime>1.9</solidTime>
    <fadeOutTime>0.4</fadeOutTime>
    <growthRate>-0.1</growthRate>
    <graphicData>
      <texPath>VFX/VV_ScentTwinkle</texPath>
      <shaderType>MoteGlow</shaderType>
      <renderInstanced>true</renderInstanced>
      <color>(1, 0.86, 0.5, 1)</color>
    </graphicData>
  </FleckDef>

  <!-- 영원꽃 동화 시작 효과 -->
  <EffecterDef>
    <defName>VV_Effecter_AssimilationBegin</defName>
    <maintainTicks>10</maintainTicks>
    <children>
      <li>
        <subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
        <fleckDef>VV_Fleck_GimmickFlash</fleckDef>
        <spawnLocType>OnSource</spawnLocType>
        <scale>3</scale>
        <color>(1, 0.88, 0.55, 0.8)</color>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
        <fleckDef>VV_Fleck_GimmickTwinkle</fleckDef>
        <spawnLocType>OnSource</spawnLocType>
        <burstCount>10~14</burstCount>
        <positionRadius>0.6</positionRadius>
        <absoluteAngle>true</absoluteAngle>
        <angle>-30~30</angle>
        <fleckUsesAngleForVelocity>true</fleckUsesAngleForVelocity>
        <speed>0.8~2</speed>
        <scale>0.35~0.6</scale>
        <color>(1, 0.9, 0.62, 1)</color>
      </li>
    </children>
  </EffecterDef>

  <!-- 영원꽃 동화 흡수 효과 -->
  <EffecterDef>
    <defName>VV_Effecter_AssimilationAbsorb</defName>
    <maintainTicks>12</maintainTicks>
    <children>
      <li>
        <subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
        <fleckDef>VV_Fleck_GimmickFlash</fleckDef>
        <spawnLocType>OnSource</spawnLocType>
        <scale>6</scale>
        <color>(1, 0.86, 0.5, 0.9)</color>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
        <fleckDef>VV_Fleck_GimmickBlastRing</fleckDef>
        <spawnLocType>OnSource</spawnLocType>
        <scale>0.6</scale>
        <color>(1, 0.86, 0.5, 0.9)</color>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
        <fleckDef>VV_Fleck_GimmickTwinkle</fleckDef>
        <spawnLocType>OnSource</spawnLocType>
        <burstCount>16~22</burstCount>
        <positionRadius>0.4</positionRadius>
        <absoluteAngle>true</absoluteAngle>
        <angle>0~360</angle>
        <fleckUsesAngleForVelocity>true</fleckUsesAngleForVelocity>
        <speed>1.5~4</speed>
        <scale>0.4~0.7</scale>
        <color>(1, 0.9, 0.62, 1)</color>
      </li>
    </children>
  </EffecterDef>
</Defs>
