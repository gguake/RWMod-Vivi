<?xml version="1.0" encoding="UTF-8"?>
<Defs>
  <!-- 아스포델 생각 트리: 판단은 하나의 작업 지급기(JobGiver_ApocryphaMain)가 CompApocrypha 상태를 보고 내린다. -->
  <ThinkTreeDef>
    <defName>VV_Apocrypha</defName>
    <thinkRoot Class="ThinkNode_Priority">
      <subNodes>
        <li Class="ThinkNode_Subtree">
          <treeDef>Despawned</treeDef>
        </li>
        <li Class="ThinkNode_Subtree">
          <treeDef>Downed</treeDef>
        </li>
        <li Class="VVRace.JobGiver_ApocryphaMain" />
        <li Class="JobGiver_IdleError" />
      </subNodes>
    </thinkRoot>
  </ThinkTreeDef>

  <ThinkTreeDef>
    <defName>VV_ApocryphaConstant</defName>
    <thinkRoot Class="ThinkNode_Priority">
      <subNodes>
        <li Class="ThinkNode_Subtree">
          <treeDef>Despawned</treeDef>
        </li>
      </subNodes>
    </thinkRoot>
  </ThinkTreeDef>
</Defs>
