    </apparelRequired>
    <weaponMoney>50~500</weaponMoney>
    <weaponTags>
      <li>VV_WanderingViviWeapon</li>
    </weaponTags>
  </PawnKindDef>

  <PawnKindDef ParentName="VV_WanderingViviBase" Class="VVRace.PawnKindDef_Vivi">
    <defName>VV_WanderingRoyalVivi</defName>
    <label>wandering royal vivi</label>
    <combatPower>50</combatPower>
    <isFighter>false</isFighter>
    <itemQuality>Normal</itemQuality>
    <isRoyal>true</isRoyal>
    <forcedBodyType>Female</forcedBodyType>

    <apparelMoney>0~0</apparelMoney>
    <apparelRequired>
      <li>VV_BasicRoyalCostume</li>
    </apparelRequired>
    <nakedChance>0</nakedChance>
    <weaponMoney>0~0</weaponMoney>

    <acceptArrestChanceFactor>0.25</acceptArrestChanceFactor>
    <initialWillRange>16~19</initialWillRange>
    <initialResistanceRange>38~58</initialResistanceRange>

    <backstoryFiltersOverride Inherit="False">
      <li>
        <categories>
          <li>VV_RoyalViviSettlerBackstory</li>
        </categories>
      </li>
    </backstoryFiltersOverride>
  </PawnKindDef>
</Defs>
