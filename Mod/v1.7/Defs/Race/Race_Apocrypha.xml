<?xml version="1.0" encoding="UTF-8"?>
<Defs>
  <!-- 아스포델 -->
  <ThingDef ParentName="AnimalThingBase">
    <defName>VV_Apocrypha</defName>
    <label>Asphodel</label>
    <description>The last empress of the ancient vivi empire, and its destroyer.\n\nWhen the empire stood on the brink of ruin, the empress performed a grand ritual to save her billions of subjects, turning every vivi in the empire into a fairy at once and binding them all to herself. But unable to bear their weight, she lost her mind and became a monster, and the emptied empire fell in an instant.\n\nThe vivis who survived the catastrophe erased every record of the empress and her ritual so that no one could ever repeat it. Yet even now, countless ages later, the maddened empress has found no rest; she drifts through subspace, searching only for the everflower that lingers in her memory.\n\nThe fairy vivis bound to the fallen empress remember her final kindness. They are her last guardians, and at the same time, her seal.</description>
    <drawOffscreen>true</drawOffscreen>
    <thingCategories Inherit="False" />
    <statBases>
      <MoveSpeed>1.5</MoveSpeed>
      <PsychicSensitivity>0</PsychicSensitivity>
      <ArmorRating_Sharp>0</ArmorRating_Sharp>
