    <label>Asphodel</label>
    <description>Asphodel, the last empress of the old vivi empire.\n\nUnable to sleep for long ages, she wandered in search of the flower's shade in her memory, until the altar's waves drew her here. Around her twisted form linger countless little lights, layer upon layer, that remember the empress's last kindness.</description>
    <drawOffscreen>true</drawOffscreen>
    <statBases>
      <MoveSpeed>1.5</MoveSpeed>
      <PsychicSensitivity>0</PsychicSensitivity>
      <ArmorRating_Sharp>0</ArmorRating_Sharp>
      <ArmorRating_Blunt>0</ArmorRating_Blunt>
      <ArmorRating_Heat>0</ArmorRating_Heat>
      <Flammability>0</Flammability>
      <ToxicResistance>1</ToxicResistance>
      <ToxicEnvironmentResistance>1</ToxicEnvironmentResistance>
      <ComfyTemperatureMin>-150</ComfyTemperatureMin>
      <ComfyTemperatureMax>250</ComfyTemperatureMax>
      <PainShockThreshold>1</PainShockThreshold>
      <MarketValue>0</MarketValue>
      <LeatherAmount>0</LeatherAmount>
    </statBases>
    <uiIconScale>1</uiIconScale>
    <tradeability>None</tradeability>
    <inspectorTabs Inherit="False">
      <li>ITab_Pawn_Health</li>
      <li>ITab_Pawn_Log</li>
    </inspectorTabs>

    <tools>
      <li>
        <label>left claw</label>
        <capacities>
          <li>Scratch</li>
          <li>Stab</li>
        </capacities>
        <power>45</power>
        <cooldownTime>2.2</cooldownTime>
        <linkedBodyPartsGroup>VV_LeftClaw</linkedBodyPartsGroup>
        <alwaysTreatAsWeapon>true</alwaysTreatAsWeapon>
        <armorPenetration>0.7</armorPenetration>
      </li>
      <li>
        <label>right claw</label>
        <capacities>
          <li>Scratch</li>
          <li>Stab</li>
        </capacities>
        <power>45</power>
        <cooldownTime>2.2</cooldownTime>
        <linkedBodyPartsGroup>VV_RightClaw</linkedBodyPartsGroup>
        <alwaysTreatAsWeapon>true</alwaysTreatAsWeapon>
        <armorPenetration>0.7</armorPenetration>
      </li>
      <li>
        <label>jaw</label>
        <capacities>
          <li>Bite</li>
        </capacities>
        <power>30</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>Mouth</linkedBodyPartsGroup>
