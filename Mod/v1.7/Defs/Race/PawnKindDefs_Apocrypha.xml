<?xml version="1.0" encoding="UTF-8"?>
<Defs>
  <PawnKindDef ParentName="AnimalKindBase">
    <defName>VV_Apocrypha</defName>
    <label>Asphodel</label>
    <race>VV_Apocrypha</race>
    <combatPower>3000</combatPower>
    <canArriveManhunter>false</canArriveManhunter>
    <ecoSystemWeight>0</ecoSystemWeight>
    <isBoss>true</isBoss>
    <skipResistant>true</skipResistant>
    <immuneToTraps>true</immuneToTraps>
    <ignoresPainShock>true</ignoresPainShock>
    <immuneToGameConditionEffects>true</immuneToGameConditionEffects>
    <!-- 수명이 1000년이라 생성 시 노화 흉터가 붙을 수 있는데, 모든 피해를 흡수하므로 전투 내내 남는다. -->
    <allowOldAgeInjuries>false</allowOldAgeInjuries>

    <lifeStages>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/Apocrypha/VV_Apocrypha</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <!-- 형체 높이 약 2.8칸(그림 높이의 93%) = 로열 비비(약 1.14칸)의 약 2.5배 -->
          <drawSize>3</drawSize>
          <shadowData>
            <volume>(0.65, 0.46, 0.32)</volume>
            <offset>(0, 0, -0.42)</offset>
          </shadowData>
        </bodyGraphicData>
      </li>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/Apocrypha/VV_ApocryphaUnbound</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>8.5</drawSize>
          <shadowData>
            <volume>(1.8, 1.3, 0.9)</volume>
            <offset>(0, 0, -1.2)</offset>
          </shadowData>
        </bodyGraphicData>
      </li>
    </lifeStages>
  </PawnKindDef>
</Defs>
