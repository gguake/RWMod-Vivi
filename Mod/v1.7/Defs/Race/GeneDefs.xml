<?xml version="1.0" encoding="UTF-8"?>
<Defs>
  <GeneDef>
    <defName>VV_ViviMetabolism</defName>
    <label>excessive metabolism</label>
    <description>Vivi's unique genes greatly boost skill learning speed and grant learning bonuses during growth stages. Growth and aging are very rapid, and it cannot reproduce by normal means.</description>
    <iconPath>UI/Icons/Genes/Gene_Vivi</iconPath>
    <displayCategory>Miscellaneous</displayCategory>
    <biologicalAgeTickFactorFromAgeCurve>
      <points>
        <li>(0, 2)</li>
        <li>(3, 3)</li>
        <li>(6.999999, 3)</li>
        <li>(7, 3)</li>
        <li>(12.999999, 3)</li>
        <li>(13, 10)</li>
      </points>
    </biologicalAgeTickFactorFromAgeCurve>
    <biostatMet>-3</biostatMet>
    <biostatCpx>3</biostatCpx>
    <sterilize>true</sterilize>
    <statOffsets>
      <GlobalLearningFactor>0.5</GlobalLearningFactor>
    </statOffsets>
    <statFactors>
      <LearningRateFactor>2.0</LearningRateFactor>
    </statFactors>
    <canGenerateInGeneSet>false</canGenerateInGeneSet>
    <symbolPack>
      <suffixSymbols>
        <li><symbol>vivi</symbol><weight>100000000</weight></li>
      </suffixSymbols>
    </symbolPack>
  </GeneDef>
  
  <GeneDef>
    <defName>VV_HoneyDepedency</defName>
    <label>fructose dependency</label>
    <description>Carriers of this gene need to ingest vivi honey or ambrosia on a regular basis to survive. After 15 days without vivi honey or ambrosia, carriers will suffer from fructose deficiency.</description>
    <geneClass>VVRace.Gene_HoneyDependency</geneClass>
    <iconPath>UI/Icons/Genes/Gene_Vivi2</iconPath>
    <displayCategory>Miscellaneous</displayCategory>
    <biostatMet>2</biostatMet>
    <biostatCpx>1</biostatCpx>
    <minAgeActive>3</minAgeActive>
    <canGenerateInGeneSet>false</canGenerateInGeneSet>
  </GeneDef>

  <GeneDef ParentName="GeneToughnessBase">
    <defName>VV_LightBody</defName>
    <label>light body</label>
    <description>Carriers of this gene have extremely light bones and organs, letting them move swiftly, but they take heavy injuries from even weak impacts.</description>
    <iconPath>UI/Icons/Genes/Gene_LightBody</iconPath>
    <displayOrderInCategory>5</displayOrderInCategory>
    <statFactors>
      <IncomingDamageFactor>1.2</IncomingDamageFactor>
      <PawnTrapSpringChance>0.1</PawnTrapSpringChance>
    </statFactors>
    <statOffsets>
      <MeleeDodgeChance>15</MeleeDodgeChance>
      <MoveSpeed>0.2</MoveSpeed>
    </statOffsets>
    <biostatCpx>2</biostatCpx>
    <biostatMet>2</biostatMet>
    <symbolPack>
      <prefixSymbols>
        <li><symbol>feather</symbol></li>
        <li><symbol>lithe</symbol></li>
        <li><symbol>airy</symbol></li>
      </prefixSymbols>
    </symbolPack>
  </GeneDef>

  <GeneDef ParentName="GeneSkinColorMelanin">
    <defName>VV_Skin_Melanin</defName>
    <skinColorBase>(255, 255, 255)</skinColorBase>
    <minMelanin>0</minMelanin>
    <selectionWeight>1</selectionWeight>
  </GeneDef>
</Defs>
