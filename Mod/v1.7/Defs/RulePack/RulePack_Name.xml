<?xml version="1.0" encoding="UTF-8"?>
<Defs>
  <RulePackDef>
    <defName>VV_NamerPersonVivi</defName>
    <rulePack>
      <rulesStrings>
        <li>r_name->[first_name] [last_name]</li>

        <li>first_name->[vivi_name_prefix][vivi_name_base]</li>
        <li>last_name->[vivi_flower_nouns]</li>
      </rulesStrings>
      <rulesFiles>
        <li>vivi_flower_nouns->Words/VV_FlowerNouns</li>
        <li>vivi_name_prefix->Words/VV_NamePrefix</li>
        <li>vivi_name_base->Words/VV_NameBase</li>
        <li>colors->Words/Nouns/Colors</li>
      </rulesFiles>
    </rulePack>
  </RulePackDef>
  
  <!--
    Ideo name maker of VV_ViviCulture. The meme that supplies the symbol pack (VV_Structure_Vivi, via symbolPackOverride)
    is left out of the ideo name request, so only the culture namer can shape the ideo name.
  -->
  <RulePackDef MayRequire="Ludeon.RimWorld.Ideology">
    <defName>VV_NamerIdeoVivi</defName>
    <include>
      <li>NamerIdeoGlobal</li>
    </include>
    <rulePack>
      <rulesStrings>
        <!-- Structure meme packs are exposed as [packIdeoNameStructure]. priority=1 blocks NamerIdeoGlobal's fallbacks
             (neo-/post- prefixes, [creed] of [packTheme]...), which still apply when the pack comes from a non-structure meme -->
        <li>r_ideoName(priority=1)->[packIdeoNameStructure]</li>
        <li>r_ideoName(priority=1)->[viviIdeoAdjective] [packIdeoNameStructure]</li>

        <li>viviIdeoAdjective->simple</li>
        <li>viviIdeoAdjective->warm</li>
        <li>viviIdeoAdjective->gentle</li>
        <li>viviIdeoAdjective->peaceful</li>
      </rulesStrings>
    </rulePack>
  </RulePackDef>

  <RulePackDef>
    <defName>VV_NamerFactionVivi</defName>
    <rulePack>
      <rulesStrings>
        <li>r_name->[colors] independent vivi kingdom</li>
        <li>r_name->[vivi_adjective] vivi kingdom</li>
      </rulesStrings>
      <rulesFiles>
        <li>vivi_adjective->Words/VV_Faction_Adjective</li>
        <li>colors->Words/Nouns/Colors</li>
      </rulesFiles>
    </rulePack>
  </RulePackDef>
  
  <RulePackDef>
    <defName>VV_NamerNPCFactionVivi</defName>
    <rulePack>
      <rulesStrings>
        <li>r_name->[vivi_flower_nouns] vivi federation</li>
        <li>r_name->[colors] [vivi_flower_nouns] vivi federation</li>
      </rulesStrings>
      <rulesFiles>
        <li>vivi_flower_nouns->Words/VV_FlowerNouns</li>
        <li>colors->Words/Nouns/Colors</li>
      </rulesFiles>
    </rulePack>
  </RulePackDef>

  <RulePackDef>
    <defName>VV_NamerSettlementVivi</defName>
    <rulePack>
      <rulesStrings>
        <li>r_name->[colors] hive</li>
        <li>r_name->hive [position] [nature]</li>
        <li>r_name->honey storage [position] [nature]</li>
        <li>r_name->pollen storage [position] [nature]</li>
        <li>r_name->vivi town [position] [nature]</li>
        <li>r_name->[colors] arcane plant farm</li>
      </rulesStrings>
      <rulesFiles>
        <li>colors->Words/Nouns/Colors</li>
        <li>nature->Words/VV_Faction_Nature</li>
        <li>position->Words/VV_Faction_Position</li>
      </rulesFiles>
    </rulePack>
  </RulePackDef>
</Defs>
