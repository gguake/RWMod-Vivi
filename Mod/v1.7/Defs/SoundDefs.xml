  <!-- 아스포델 소환음: 등장 연출 동안 유지하는 지속음(전용 채널이라 일시정지 중 다른 소리에 빼앗기지 않음), 형체가 완성되는 5초에 절정, 카메라 위치와 관계없이.
       반복 재생은 실제 시간으로 끝을 잡지 않게 하려는 것으로, 소리 길이(5.8초)보다 먼저 연출이 지속음을 끝낸다. -->
  <SoundDef>
    <defName>VV_ApocryphaSummon</defName>
    <sustain>True</sustain>
    <context>MapOnly</context>
    <priorityMode>PrioritizeNearest</priorityMode>
    <sustainFadeoutTime>0.15</sustainFadeoutTime>
    <subSounds>
      <li>
        <onCamera>True</onCamera>
        <grains>
          <li Class="AudioGrain_Clip">
            <clipPath>SFX/VV_ApocryphaSummon</clipPath>
          </li>
        </grains>
        <volumeRange>38</volumeRange>
        <tempoAffectedByGameSpeed>true</tempoAffectedByGameSpeed>
      </li>
    </subSounds>
  </SoundDef>

  <!-- 거대 말벌 소환음: 형체가 빚어지기 시작할 때 재생해 실제 말벌이 되는 2.5초에 절정 -->
  <SoundDef>
