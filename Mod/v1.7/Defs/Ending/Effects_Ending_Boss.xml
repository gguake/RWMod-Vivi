    </graphicData>
  </FleckDef>

  <!-- ===================== 공용 모트 ===================== -->
  <ThingDef ParentName="MoteBase">
    <defName>VV_Mote_ApocryphaMagentaFlash</defName>
    <thingClass>MoteAttached</thingClass>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <drawOffscreen>true</drawOffscreen>
    <mote>
      <fadeInTime>0.01</fadeInTime>
      <fadeOutTime>0.9</fadeOutTime>
      <solidTime>0.2</solidTime>
    </mote>
    <graphicData>
      <texPath>Things/Mote/BrightFlash</texPath>
      <shaderType>MoteGlow</shaderType>
      <color>(1, 0.4, 0.9, 0.85)</color>
      <drawSize>(18, 18)</drawSize>
    </graphicData>
  </ThingDef>

  <ThingDef ParentName="MoteBase">
    <defName>VV_Mote_ApocryphaGoldenFlash</defName>
    <thingClass>MoteAttached</thingClass>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <drawOffscreen>true</drawOffscreen>
    <mote>
      <fadeInTime>0.01</fadeInTime>
      <fadeOutTime>0.8</fadeOutTime>
      <solidTime>0.15</solidTime>
    </mote>
    <graphicData>
      <texPath>Things/Mote/BrightFlash</texPath>
      <shaderType>MoteGlow</shaderType>
      <color>(1, 0.86, 0.5, 0.85)</color>
      <drawSize>(12, 12)</drawSize>
    </graphicData>
