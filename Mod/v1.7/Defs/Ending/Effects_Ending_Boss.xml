<?xml version="1.0" encoding="UTF-8"?>
<Defs>
  <!-- ===================== 공용 플렉 ===================== -->
  <!-- 주의: 플렉 크기 = (scale + growthRate × 경과초) × drawSize. 세밀한 번개 고리(512px)는 크게 키우면 확대·압축으로 깨져 보이므로
       보스 주변(최대 약 25칸)까지만 키운다. 맵 전체로 퍼지는 파동은 텍스처 없이 수식으로 그리는 VV_ShockWave 셰이더 플렉으로 그린다. -->
  <FleckDef ParentName="FleckBase">
    <defName>VV_Fleck_ApocryphaMagentaRing</defName>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <drawOffscreen>true</drawOffscreen>
    <fadeInTime>0.05</fadeInTime>
    <solidTime>0.35</solidTime>
    <fadeOutTime>0.9</fadeOutTime>
    <growthRate>4</growthRate>
    <graphicData>
      <texPath>VFX/VV_MagentaShockRing</texPath>
      <shaderType>MoteGlow</shaderType>
      <drawSize>(4, 4)</drawSize>
    </graphicData>
  </FleckDef>

  <!-- 2페이즈 전환 충격파(VV_ShockWave 셰이더): 쿼드는 최종 크기(90칸)로 고정하고 셰이더가 파면을 넓힌다.
       파면이 장면을 굴절시키며 자홍 잔광과 전기 줄기를 남긴다. 페이드는 셰이더가 _Duration에 맞춰 직접 처리한다. -->
  <FleckDef ParentName="FleckBase">
    <defName>VV_Fleck_ApocryphaShockWave</defName>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <drawOffscreen>true</drawOffscreen>
    <fadeInTime>0</fadeInTime>
    <solidTime>1.6</solidTime>
    <fadeOutTime>0.05</fadeOutTime>
    <graphicData>
      <graphicClass>Graphic_FleckPulse</graphicClass>
      <texPath>Things/Mote/Black</texPath>
      <shaderType>VV_ShockWave</shaderType>
      <renderInstanced>false</renderInstanced>
      <drawSize>(90, 90)</drawSize>
      <shaderParameters>
        <_Duration>1.6</_Duration>
        <_Width>0.009</_Width>
        <_Distortion>0.012</_Distortion>
        <_Brightness>1.5</_Brightness>
        <_ArcIntensity>1.0</_ArcIntensity>
        <_CoreColor>(1.0, 0.82, 0.98, 1)</_CoreColor>
        <_GlowColor>(1.0, 0.25, 0.85, 1)</_GlowColor>
        <_FringeColor>(0.55, 0.2, 1.0, 1)</_FringeColor>
      </shaderParameters>
    </graphicData>
  </FleckDef>

  <!-- 2페이즈 모핑 중 심장 박동마다 몸에서 번지는 작은 굴절 파동(VV_ShockWave 셰이더). 몸의 모핑을 가리지 않도록 빛은 약하게, 굴절 위주로. -->
  <FleckDef ParentName="FleckBase">
    <defName>VV_Fleck_ApocryphaMorphPulse</defName>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <drawOffscreen>true</drawOffscreen>
    <fadeInTime>0</fadeInTime>
    <solidTime>0.7</solidTime>
    <fadeOutTime>0.05</fadeOutTime>
    <graphicData>
      <graphicClass>Graphic_FleckPulse</graphicClass>
      <texPath>Things/Mote/Black</texPath>
      <shaderType>VV_ShockWave</shaderType>
      <renderInstanced>false</renderInstanced>
      <drawSize>(16, 16)</drawSize>
      <shaderParameters>
        <_Duration>0.7</_Duration>
        <_Width>0.025</_Width>
        <_Distortion>0.04</_Distortion>
        <_Brightness>0.35</_Brightness>
        <_ArcIntensity>0</_ArcIntensity>
        <_CoreColor>(1.0, 0.55, 0.75, 1)</_CoreColor>
        <_GlowColor>(0.85, 0.08, 0.35, 1)</_GlowColor>
        <_FringeColor>(0.5, 0.05, 0.4, 1)</_FringeColor>
      </shaderParameters>
    </graphicData>
  </FleckDef>

  <FleckDef ParentName="FleckBase">
    <defName>VV_Fleck_ApocryphaShockDistortion</defName>
    <altitudeLayer>MoteLow</altitudeLayer>
    <drawOffscreen>true</drawOffscreen>
    <fadeInTime>0</fadeInTime>
    <solidTime>0.2</solidTime>
    <fadeOutTime>0.8</fadeOutTime>
    <growthRate>45</growthRate>
    <graphicData>
      <graphicClass>Graphic_FleckPulse</graphicClass>
      <texPath>Things/Mote/Black</texPath>
      <shaderType>MoteLargeDistortionWave</shaderType>
      <shaderParameters>
        <_DistortionTex>/Things/Mote/PsychicDistortionCurrents</_DistortionTex>
        <_NoiseTex>/Things/Mote/PsycastNoise</_NoiseTex>
        <_distortionIntensity>0.25</_distortionIntensity>
        <_brightnessMultiplier>3.5</_brightnessMultiplier>
      </shaderParameters>
      <drawSize>1</drawSize>
    </graphicData>
  </FleckDef>

  <FleckDef ParentName="FleckBase">
    <defName>VV_Fleck_ApocryphaGoldenRing</defName>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <drawOffscreen>true</drawOffscreen>
    <fadeInTime>0.05</fadeInTime>
    <solidTime>0.2</solidTime>
    <fadeOutTime>0.7</fadeOutTime>
    <growthRate>16</growthRate>
    <graphicData>
      <texPath>VFX/VV_GoldenWaveRing</texPath>
      <shaderType>MoteGlow</shaderType>
      <drawSize>(3, 3)</drawSize>
    </graphicData>
  </FleckDef>

  <!-- 금빛 불씨(소멸·변신·조준 반짝임) -->
  <FleckDef ParentName="FleckBase_Thrown">
    <defName>VV_Fleck_ApocryphaEmber</defName>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <fadeInTime>0.05</fadeInTime>
    <solidTime>0.5</solidTime>
    <fadeOutTime>0.9</fadeOutTime>
    <growthRate>-0.15</growthRate>
    <graphicData>
      <texPath>Things/Mote/SparkFlash</texPath>
      <shaderType>MoteGlow</shaderType>
      <renderInstanced>true</renderInstanced>
      <color>(1, 0.8, 0.36, 1)</color>
    </graphicData>
  </FleckDef>

  <!-- 찬탈 후 흩날리는 영원꽃·아포크리파 꽃잎 (DyingApocrypha 찬탈 모드가 색·속도·회전을 정해 생성) -->
  <FleckDef ParentName="VV_FleckEverflowerPetalBase">
    <defName>VV_Fleck_ApocryphaStealPetal</defName>
    <fadeInTime>0.1</fadeInTime>
    <solidTime>1.3</solidTime>
    <fadeOutTime>1.1</fadeOutTime>
    <graphicData>
      <drawSize>(0.7, 0.7)</drawSize>
    </graphicData>
  </FleckDef>

  <!-- 잿빛 먼지(소멸) -->
  <FleckDef ParentName="FleckBase_Thrown">
    <defName>VV_Fleck_ApocryphaAsh</defName>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <fadeInTime>0.1</fadeInTime>
    <solidTime>0.5</solidTime>
    <fadeOutTime>1.4</fadeOutTime>
    <growthRate>0.7</growthRate>
    <graphicData>
      <texPath>Things/Mote/DustPuff</texPath>
      <renderInstanced>true</renderInstanced>
      <color>(0.45, 0.42, 0.42, 0.85)</color>
    </graphicData>
  </FleckDef>

  <!-- 독성 브레스(녹색/자홍 독가스) -->
  <FleckDef ParentName="FleckBase_Thrown">
    <defName>VV_Fleck_ApocryphaToxicGas</defName>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <fadeInTime>0.08</fadeInTime>
    <solidTime>0.45</solidTime>
    <fadeOutTime>1.2</fadeOutTime>
    <growthRate>1.6</growthRate>
    <graphicData>
      <texPath>Things/Gas/GasCloudThickA</texPath>
      <shaderType>TransparentPostLight</shaderType>
      <color>(0.58, 0.88, 0.14, 0.55)</color>
    </graphicData>
  </FleckDef>

  <FleckDef ParentName="FleckBase_Thrown">
    <defName>VV_Fleck_ApocryphaToxicGasViolet</defName>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <fadeInTime>0.08</fadeInTime>
    <solidTime>0.4</solidTime>
    <fadeOutTime>1.1</fadeOutTime>
    <growthRate>1.5</growthRate>
    <graphicData>
      <texPath>Things/Gas/GasCloudThickA</texPath>
      <shaderType>TransparentPostLight</shaderType>
      <color>(0.66, 0.24, 0.78, 0.45)</color>
    </graphicData>
  </FleckDef>

  <!-- 조준 지점에서 피어오르는 금빛 꽃잎 / 찬탈 중 빨려 나가는 자홍 꽃잎 -->
  <FleckDef ParentName="FleckBase_Thrown">
    <defName>VV_Fleck_ApocryphaAimSpark</defName>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <fadeInTime>0.1</fadeInTime>
    <solidTime>0.3</solidTime>
    <fadeOutTime>0.7</fadeOutTime>
    <graphicData>
      <texPath>VFX/VV_EverflowerPetal</texPath>
      <shaderType>MoteGlow</shaderType>
      <renderInstanced>true</renderInstanced>
      <color>(1, 0.86, 0.5, 1)</color>
    </graphicData>
  </FleckDef>

  <FleckDef ParentName="FleckBase_Thrown">
    <defName>VV_Fleck_ApocryphaDrainSpark</defName>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <fadeInTime>0.1</fadeInTime>
    <solidTime>0.4</solidTime>
    <fadeOutTime>0.8</fadeOutTime>
    <graphicData>
      <texPath>VFX/VV_EverflowerPetal</texPath>
      <shaderType>MoteGlow</shaderType>
      <renderInstanced>true</renderInstanced>
      <color>(1, 0.4, 0.86, 1)</color>
    </graphicData>
  </FleckDef>

  <!-- ===================== 공용 모트 ===================== -->
  <ThingDef ParentName="MoteBase">
    <defName>VV_Mote_ApocryphaMagentaFlash</defName>
    <thingClass>MoteAttached</thingClass>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <drawOffscreen>true</drawOffscreen>
    <mote>
      <fadeInTime>0.01</fadeInTime>
      <fadeOutTime>0.9</fadeOutTime>
      <solidTime>0.2</solidTime>
    </mote>
    <graphicData>
      <texPath>Things/Mote/BrightFlash</texPath>
      <shaderType>MoteGlow</shaderType>
      <color>(1, 0.4, 0.9, 0.85)</color>
      <drawSize>(18, 18)</drawSize>
    </graphicData>
  </ThingDef>

  <ThingDef ParentName="MoteBase">
    <defName>VV_Mote_ApocryphaGoldenFlash</defName>
    <thingClass>MoteAttached</thingClass>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <drawOffscreen>true</drawOffscreen>
    <mote>
      <fadeInTime>0.01</fadeInTime>
      <fadeOutTime>0.8</fadeOutTime>
      <solidTime>0.15</solidTime>
    </mote>
    <graphicData>
      <texPath>Things/Mote/BrightFlash</texPath>
      <shaderType>MoteGlow</shaderType>
      <color>(1, 0.86, 0.5, 0.85)</color>
      <drawSize>(12, 12)</drawSize>
    </graphicData>
  </ThingDef>

  <!-- ===================== 등장·증원 ===================== -->
  <EffecterDef>
    <defName>VV_Effecter_ApocryphaArrive</defName>
    <children>
      <li>
        <subEffecterClass>SubEffecter_SoundTriggered</subEffecterClass>
        <soundDef>Pawn_BigInsect_Call</soundDef>
        <spawnLocType>OnSource</spawnLocType>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
        <fleckDef>DustPuffThick</fleckDef>
        <spawnLocType>OnSource</spawnLocType>
        <burstCount>10~14</burstCount>
        <positionRadius>2.5</positionRadius>
        <angle>0~360</angle>
        <fleckUsesAngleForVelocity>true</fleckUsesAngleForVelocity>
        <speed>0.6~1.4</speed>
        <scale>1.6~2.6</scale>
        <rotationRate>-60~60</rotationRate>
      </li>
    </children>
  </EffecterDef>

  <!-- ===================== 등장 연출 (ApocryphaManifestation) ===================== -->
  <!-- 영원꽃 위로 모여드는 검은 에너지 입자(알파 혼합). 꼬리가 아래로 끌리는 혜성 모양이라 회전을 속도 방향에 맞춰 날린다.
       수명(0.95초)과 속도는 코드가 맞춰 꼬리가 사라질 무렵 형체에 닿게 한다. -->
  <FleckDef ParentName="FleckBase_Thrown">
    <defName>VV_Fleck_ApocryphaDarkWisp</defName>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <drawOffscreen>true</drawOffscreen>
    <fadeInTime>0.12</fadeInTime>
    <solidTime>0.53</solidTime>
    <fadeOutTime>0.3</fadeOutTime>
    <growthRate>-0.3</growthRate>
    <graphicData>
      <texPath>VFX/VV_DarkWisp</texPath>
      <shaderType>Mote</shaderType>
      <renderInstanced>true</renderInstanced>
      <color>(0.05, 0.01, 0.08, 0.95)</color>
      <drawSize>(0.75, 1.5)</drawSize>
    </graphicData>
  </FleckDef>

  <!-- 등장 연출의 반짝이는 기운(가산). 색은 코드·스프레이어가 정한다(검은 입자 사이의 자홍 기운, 꽃봉오리로 모이는 금빛). -->
  <FleckDef ParentName="FleckBase_Thrown">
    <defName>VV_Fleck_ApocryphaManifestSpark</defName>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <drawOffscreen>true</drawOffscreen>
    <fadeInTime>0.12</fadeInTime>
    <solidTime>0.53</solidTime>
    <fadeOutTime>0.3</fadeOutTime>
    <growthRate>-0.2</growthRate>
    <graphicData>
      <texPath>Things/Mote/SparkFlash</texPath>
      <shaderType>MoteGlow</shaderType>
      <renderInstanced>true</renderInstanced>
    </graphicData>
  </FleckDef>

  <!-- 형체가 다 빚어진 뒤 영원꽃 꽃봉오리에 모이는 금빛(파장 직전까지 차오른다) -->
  <ThingDef ParentName="MoteBase">
    <defName>VV_Mote_ApocryphaRepelCharge</defName>
    <thingClass>MoteThrown</thingClass>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <drawOffscreen>true</drawOffscreen>
    <mote>
      <fadeInTime>0.65</fadeInTime>
      <solidTime>0.05</solidTime>
      <fadeOutTime>0.35</fadeOutTime>
      <growthRate>3</growthRate>
    </mote>
    <graphicData>
      <texPath>Things/Mote/BrightFlash</texPath>
      <shaderType>MoteGlow</shaderType>
      <color>(1, 0.86, 0.5, 0.8)</color>
      <drawSize>(5, 5)</drawSize>
    </graphicData>
  </ThingDef>

  <!-- 영원꽃에서 맵 전체로 퍼지는 금빛 파장(VV_ShockWave 셰이더). 코드가 맵 끝 모서리까지 덮도록 크기(scale)를 정한다.
       크기가 맵마다 달라지므로 굴절·파면 폭은 반지름 약 190칸(250 맵 중앙)일 때 2페이즈 전환 충격파와 비슷해지도록 작게 둔다. -->
  <FleckDef ParentName="FleckBase">
    <defName>VV_Fleck_ApocryphaRepelWave</defName>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <drawOffscreen>true</drawOffscreen>
    <fadeInTime>0</fadeInTime>
    <solidTime>2.6</solidTime>
    <fadeOutTime>0.05</fadeOutTime>
    <graphicData>
      <graphicClass>Graphic_FleckPulse</graphicClass>
      <texPath>Things/Mote/Black</texPath>
      <shaderType>VV_ShockWave</shaderType>
      <renderInstanced>false</renderInstanced>
      <drawSize>(100, 100)</drawSize>
      <shaderParameters>
        <_Duration>2.6</_Duration>
        <_Width>0.0035</_Width>
        <_Distortion>0.003</_Distortion>
        <_Brightness>1.7</_Brightness>
        <_ArcIntensity>0.6</_ArcIntensity>
        <_CoreColor>(1.0, 0.96, 0.78, 1)</_CoreColor>
        <_GlowColor>(1.0, 0.76, 0.3, 1)</_GlowColor>
        <_FringeColor>(1.0, 0.55, 0.2, 1)</_FringeColor>
      </shaderParameters>
    </graphicData>
  </FleckDef>

  <!-- 형체가 다 빚어지는 순간: 작은 굴절 맥동과 사방으로 튀는 자홍 기운(섬광은 검은 몸을 분홍으로 바래게 하므로 쓰지 않는다) -->
  <EffecterDef>
    <defName>VV_Effecter_ApocryphaManifestComplete</defName>
    <children>
      <li>
        <subEffecterClass>SubEffecter_SoundTriggered</subEffecterClass>
        <soundDef>PsychicPulseGlobal</soundDef>
        <spawnLocType>OnSource</spawnLocType>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
        <fleckDef>VV_Fleck_ApocryphaMorphPulse</fleckDef>
        <spawnLocType>OnSource</spawnLocType>
        <burstCount>1</burstCount>
        <absoluteAngle>true</absoluteAngle>
        <rotation>0~360</rotation>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
        <fleckDef>VV_Fleck_ApocryphaManifestSpark</fleckDef>
        <spawnLocType>OnSource</spawnLocType>
        <burstCount>18~24</burstCount>
        <positionRadius>1.8</positionRadius>
        <angle>0~360</angle>
        <fleckUsesAngleForVelocity>true</fleckUsesAngleForVelocity>
        <speed>2~4.5</speed>
        <scale>0.3~0.6</scale>
        <color>(0.9, 0.18, 0.7, 1)</color>
      </li>
    </children>
  </EffecterDef>

  <!-- 영원꽃 꽃봉오리에서 파장이 터지는 순간(맵 전체 파장 플렉은 코드가 맵 크기에 맞춰 따로 띄운다) -->
  <EffecterDef>
    <defName>VV_Effecter_ApocryphaRepel</defName>
    <children>
      <li>
        <subEffecterClass>SubEffecter_SoundTriggered</subEffecterClass>
        <soundDef>VV_Manawave</soundDef>
        <spawnLocType>OnSource</spawnLocType>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SoundTriggered</subEffecterClass>
        <soundDef>Explosion_MechBandShockwave</soundDef>
        <spawnLocType>OnSource</spawnLocType>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
        <moteDef>VV_Mote_EverflowerRitualFlash</moteDef>
        <spawnLocType>OnSource</spawnLocType>
        <burstCount>1</burstCount>
        <scale>1.6</scale>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
        <fleckDef>VV_Fleck_ResonanceWaveRing</fleckDef>
        <spawnLocType>OnSource</spawnLocType>
        <burstCount>1</burstCount>
        <absoluteAngle>true</absoluteAngle>
        <rotation>0~360</rotation>
        <scale>1.4</scale>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
        <fleckDef>VV_Fleck_ResonanceWaveRingSlow</fleckDef>
        <spawnLocType>OnSource</spawnLocType>
        <burstCount>1</burstCount>
        <absoluteAngle>true</absoluteAngle>
        <rotation>0~360</rotation>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
        <fleckDef>VV_ExpandingDistortionRing</fleckDef>
        <spawnLocType>OnSource</spawnLocType>
        <burstCount>1</burstCount>
        <scale>2</scale>
        <rotation>0</rotation>
        <angle>0~0</angle>
        <speed>0</speed>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
        <fleckDef>VV_Fleck_EverflowerPetal_Burst</fleckDef>
        <spawnLocType>OnSource</spawnLocType>
        <burstCount>36~46</burstCount>
        <positionRadius>0.6</positionRadius>
        <angle>0~360</angle>
        <fleckUsesAngleForVelocity>true</fleckUsesAngleForVelocity>
        <speed>3~7</speed>
        <rotation>0~360</rotation>
        <rotationRate>-260~260</rotationRate>
        <scale>0.3~0.6</scale>
      </li>
    </children>
  </EffecterDef>

  <!-- 밀려난 형체가 외곽에 내려앉는 순간(실제 보스 등장 이펙트 VV_Effecter_ApocryphaArrive와 겹쳐 터진다).
       사방으로 튀는 검은 입자는 회전을 속도 방향에 맞춰야 하므로 코드가 따로 날린다. -->
  <EffecterDef>
    <defName>VV_Effecter_ApocryphaManifestLand</defName>
    <children>
      <li>
        <subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
        <moteDef>VV_Mote_ApocryphaMagentaFlash</moteDef>
        <spawnLocType>OnSource</spawnLocType>
        <burstCount>1</burstCount>
        <scale>0.4</scale>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
        <fleckDef>DustPuffThick</fleckDef>
        <spawnLocType>OnSource</spawnLocType>
        <burstCount>8~12</burstCount>
        <positionRadius>2.2</positionRadius>
        <angle>0~360</angle>
        <fleckUsesAngleForVelocity>true</fleckUsesAngleForVelocity>
        <speed>1~2.4</speed>
        <scale>2~3.2</scale>
        <rotationRate>-60~60</rotationRate>
      </li>
