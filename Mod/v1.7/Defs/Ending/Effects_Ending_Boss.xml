<?xml version="1.0" encoding="UTF-8"?>
<Defs>
  <!-- ===================== 공용 플렉 ===================== -->
  <!-- 주의: 플렉 크기 = (scale + growthRate × 경과초) × drawSize. 세밀한 번개 고리(512px)는 크게 키우면 확대·압축으로 깨져 보이므로
       보스 주변(최대 약 25칸)까지만 키운다. 맵 전체로 퍼지는 파동은 텍스처 없이 수식으로 그리는 VV_ShockWave 셰이더 플렉으로 그린다. -->
  <FleckDef ParentName="FleckBase">
    <defName>VV_Fleck_ApocryphaMagentaRing</defName>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <drawOffscreen>true</drawOffscreen>
    <fadeInTime>0.05</fadeInTime>
    <solidTime>0.35</solidTime>
    <fadeOutTime>0.9</fadeOutTime>
    <growthRate>4</growthRate>
    <graphicData>
      <texPath>VFX/VV_MagentaShockRing</texPath>
      <shaderType>MoteGlow</shaderType>
      <drawSize>(4, 4)</drawSize>
    </graphicData>
  </FleckDef>

  <!-- 2페이즈 전환 충격파(VV_ShockWave 셰이더): 쿼드는 최종 크기(90칸)로 고정하고 셰이더가 파면을 넓힌다.
       파면이 장면을 굴절시키며 자홍 잔광과 전기 줄기를 남긴다. 페이드는 셰이더가 _Duration에 맞춰 직접 처리한다. -->
  <FleckDef ParentName="FleckBase">
    <defName>VV_Fleck_ApocryphaShockWave</defName>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <drawOffscreen>true</drawOffscreen>
    <fadeInTime>0</fadeInTime>
    <solidTime>1.6</solidTime>
    <fadeOutTime>0.05</fadeOutTime>
    <graphicData>
      <graphicClass>Graphic_FleckPulse</graphicClass>
      <texPath>Things/Mote/Black</texPath>
      <shaderType>VV_ShockWave</shaderType>
      <renderInstanced>false</renderInstanced>
      <drawSize>(90, 90)</drawSize>
      <shaderParameters>
        <_Duration>1.6</_Duration>
        <_Width>0.009</_Width>
        <_Distortion>0.012</_Distortion>
        <_Brightness>1.5</_Brightness>
        <_ArcIntensity>1.0</_ArcIntensity>
        <_CoreColor>(1.0, 0.82, 0.98, 1)</_CoreColor>
        <_GlowColor>(1.0, 0.25, 0.85, 1)</_GlowColor>
        <_FringeColor>(0.55, 0.2, 1.0, 1)</_FringeColor>
      </shaderParameters>
    </graphicData>
  </FleckDef>

  <!-- 2페이즈 모핑 중 심장 박동마다 몸에서 번지는 작은 굴절 파동(VV_ShockWave 셰이더). 몸의 모핑을 가리지 않도록 빛은 약하게, 굴절 위주로. -->
  <FleckDef ParentName="FleckBase">
    <defName>VV_Fleck_ApocryphaMorphPulse</defName>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <drawOffscreen>true</drawOffscreen>
    <fadeInTime>0</fadeInTime>
    <solidTime>0.7</solidTime>
    <fadeOutTime>0.05</fadeOutTime>
    <graphicData>
      <graphicClass>Graphic_FleckPulse</graphicClass>
      <texPath>Things/Mote/Black</texPath>
      <shaderType>VV_ShockWave</shaderType>
      <renderInstanced>false</renderInstanced>
      <drawSize>(16, 16)</drawSize>
      <shaderParameters>
        <_Duration>0.7</_Duration>
        <_Width>0.025</_Width>
        <_Distortion>0.04</_Distortion>
        <_Brightness>0.35</_Brightness>
        <_ArcIntensity>0</_ArcIntensity>
        <_CoreColor>(1.0, 0.55, 0.75, 1)</_CoreColor>
        <_GlowColor>(0.85, 0.08, 0.35, 1)</_GlowColor>
        <_FringeColor>(0.5, 0.05, 0.4, 1)</_FringeColor>
      </shaderParameters>
    </graphicData>
  </FleckDef>

  <FleckDef ParentName="FleckBase">
    <defName>VV_Fleck_ApocryphaShockDistortion</defName>
    <altitudeLayer>MoteLow</altitudeLayer>
    <drawOffscreen>true</drawOffscreen>
    <fadeInTime>0</fadeInTime>
    <solidTime>0.2</solidTime>
    <fadeOutTime>0.8</fadeOutTime>
    <growthRate>45</growthRate>
    <graphicData>
      <graphicClass>Graphic_FleckPulse</graphicClass>
      <texPath>Things/Mote/Black</texPath>
      <shaderType>MoteLargeDistortionWave</shaderType>
      <shaderParameters>
        <_DistortionTex>/Things/Mote/PsychicDistortionCurrents</_DistortionTex>
        <_NoiseTex>/Things/Mote/PsycastNoise</_NoiseTex>
        <_distortionIntensity>0.25</_distortionIntensity>
        <_brightnessMultiplier>3.5</_brightnessMultiplier>
      </shaderParameters>
      <drawSize>1</drawSize>
    </graphicData>
  </FleckDef>

  <FleckDef ParentName="FleckBase">
    <defName>VV_Fleck_ApocryphaGoldenRing</defName>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <drawOffscreen>true</drawOffscreen>
    <fadeInTime>0.05</fadeInTime>
    <solidTime>0.2</solidTime>
    <fadeOutTime>0.7</fadeOutTime>
    <growthRate>16</growthRate>
    <graphicData>
      <texPath>VFX/VV_GoldenWaveRing</texPath>
      <shaderType>MoteGlow</shaderType>
      <drawSize>(3, 3)</drawSize>
    </graphicData>
  </FleckDef>

