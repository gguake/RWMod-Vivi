  <!-- ===================== 등장·증원 ===================== -->
  <EffecterDef>
    <defName>VV_Effecter_ApocryphaArrive</defName>
    <children>
      <li>
        <subEffecterClass>SubEffecter_SoundTriggered</subEffecterClass>
        <soundDef>Pawn_BigInsect_Call</soundDef>
        <spawnLocType>OnSource</spawnLocType>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
        <fleckDef>DustPuffThick</fleckDef>
        <spawnLocType>OnSource</spawnLocType>
        <burstCount>10~14</burstCount>
        <positionRadius>2.5</positionRadius>
        <angle>0~360</angle>
        <fleckUsesAngleForVelocity>true</fleckUsesAngleForVelocity>
        <speed>0.6~1.4</speed>
        <scale>1.6~2.6</scale>
        <rotationRate>-60~60</rotationRate>
      </li>
    </children>
  </EffecterDef>

  <!-- ===================== 1페이즈: 요정 비비 사출 포격 조준 ===================== -->
  <!-- 표적 마법진: VV_MagicCircle 셰이더가 수식으로 그린다(텍스처는 쓰지 않음). 바깥 고리 반지름(0.95 × 2.6칸)이 사출탄 폭발 반경 2.4칸과 맞도록 크기 5.2.
       좁혀 드는 고리가 _Duration(= CompProperties_Apocrypha.shellAimTicks / 60초) 동안 중심으로 줄어 발사 시점을 알린다.
       모트 나이를 조준 시작 틱에 맞추므로(ApocryphaShellAim) 불러온 뒤 다시 만들어도 고리 위치가 남은 시간과 맞는다. -->
  <ThingDef ParentName="MoteBase">
    <defName>VV_Mote_ApocryphaAimTarget</defName>
    <thingClass>MoteAttached</thingClass>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <drawOffscreen>true</drawOffscreen>
    <mote>
      <fadeInTime>0.15</fadeInTime>
      <fadeOutTime>0.25</fadeOutTime>
      <solidTime>999999</solidTime>
      <needsMaintenance>True</needsMaintenance>
    </mote>
    <graphicData>
      <texPath>Things/Mote/Black</texPath>
      <graphicClass>Graphic_MoteWithAgeSecs</graphicClass>
      <shaderType>VV_MagicCircle</shaderType>
      <color>(1, 0.84, 0.45, 1)</color>
      <shaderParameters>
        <_CoreColor>(1, 0.94, 0.75, 1)</_CoreColor>
        <_Duration>4</_Duration>
        <_ShrinkRing>1</_ShrinkRing>
        <_RuneCount>28</_RuneCount>
        <_RotSpeed>0.3</_RotSpeed>
        <_StarAlpha>1</_StarAlpha>
        <_CoreGlow>0.15</_CoreGlow>
        <_InscribeSecs>0.6</_InscribeSecs>
        <_LineScale>1</_LineScale>
        <_Brightness>0.75</_Brightness>
      </shaderParameters>
      <drawSize>(5.2, 5.2)</drawSize>
    </graphicData>
  </ThingDef>

  <!-- 시전 마법진: 보스 몸통 앞(표적 쪽)에 뜨는 작은 마법진. 표적 마법진과 같은 셰이더로, 좁혀 드는 고리 대신 충전될수록 중심이 밝아진다.
       작게 그리므로 선을 굵게(_LineScale) 하고 룬 수를 줄인다. -->
  <ThingDef ParentName="MoteBase">
    <defName>VV_Mote_ApocryphaAimCharge</defName>
    <thingClass>MoteAttached</thingClass>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <drawOffscreen>true</drawOffscreen>
    <mote>
      <fadeInTime>0.15</fadeInTime>
      <fadeOutTime>0.3</fadeOutTime>
      <solidTime>999999</solidTime>
      <needsMaintenance>True</needsMaintenance>
    </mote>
    <graphicData>
      <texPath>Things/Mote/Black</texPath>
      <graphicClass>Graphic_MoteWithAgeSecs</graphicClass>
      <shaderType>VV_MagicCircle</shaderType>
      <color>(1, 0.84, 0.45, 1)</color>
      <shaderParameters>
        <_CoreColor>(1, 0.94, 0.75, 1)</_CoreColor>
        <_Duration>4</_Duration>
        <_ShrinkRing>0</_ShrinkRing>
        <_RuneCount>10</_RuneCount>
        <_RotSpeed>0.9</_RotSpeed>
        <_StarAlpha>1</_StarAlpha>
        <_CoreGlow>1</_CoreGlow>
        <_InscribeSecs>0.4</_InscribeSecs>
        <_LineScale>1.8</_LineScale>
        <_Brightness>0.85</_Brightness>
      </shaderParameters>
      <drawSize>(2, 2)</drawSize>
    </graphicData>
  </ThingDef>

  <!-- 조준 지점에서 피어오르는 금빛 반짝임(꽃잎과 함께) -->
  <FleckDef ParentName="FleckBase_Thrown">
    <defName>VV_Fleck_ApocryphaAimTwinkle</defName>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <fadeInTime>0.1</fadeInTime>
    <solidTime>0.2</solidTime>
    <fadeOutTime>0.6</fadeOutTime>
    <graphicData>
      <texPath>VFX/VV_ScentTwinkle</texPath>
      <shaderType>MoteGlow</shaderType>
      <renderInstanced>true</renderInstanced>
      <color>(1, 0.9, 0.62, 1)</color>
    </graphicData>
  </FleckDef>

  <!-- 사출 포격 조준: 조준이 여러 개 겹칠 수 있으므로 표적 칸의 꽃잎·반짝임은 조준마다(VV_Effecter_ApocryphaAim),
       조준음은 조준이 하나라도 있는 동안 보스에게 하나만(VV_Effecter_ApocryphaAimSustain) 낸다. -->
  <EffecterDef>
    <defName>VV_Effecter_ApocryphaAimSustain</defName>
    <children>
      <li>
        <subEffecterClass>SubEffecter_Sustainer</subEffecterClass>
        <soundDef>HellsphereCannon_Aiming</soundDef>
        <spawnLocType>OnSource</spawnLocType>
      </li>
    </children>
  </EffecterDef>

  <EffecterDef>
    <defName>VV_Effecter_ApocryphaAim</defName>
    <children>
      <li>
        <subEffecterClass>SubEffecter_SprayerContinuous</subEffecterClass>
        <fleckDef>VV_Fleck_ApocryphaAimSpark</fleckDef>
        <spawnLocType>OnTarget</spawnLocType>
        <ticksBetweenMotes>8</ticksBetweenMotes>
        <positionRadius>2.3</positionRadius>
        <absoluteAngle>true</absoluteAngle>
        <angle>-20~20</angle>
        <fleckUsesAngleForVelocity>true</fleckUsesAngleForVelocity>
        <speed>0.4~0.9</speed>
        <scale>0.2~0.4</scale>
        <rotation>0~360</rotation>
        <rotationRate>-120~120</rotationRate>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SprayerContinuous</subEffecterClass>
        <fleckDef>VV_Fleck_ApocryphaAimTwinkle</fleckDef>
        <spawnLocType>OnTarget</spawnLocType>
        <ticksBetweenMotes>7</ticksBetweenMotes>
        <positionRadius>2.3</positionRadius>
        <absoluteAngle>true</absoluteAngle>
        <angle>-15~15</angle>
        <fleckUsesAngleForVelocity>true</fleckUsesAngleForVelocity>
        <speed>0.25~0.55</speed>
        <scale>0.18~0.34</scale>
        <rotation>0~360</rotation>
        <rotationRate>-90~90</rotationRate>
      </li>
    </children>
  </EffecterDef>

  <!-- ===================== 2페이즈 전환: 충격파 ===================== -->
  <!-- 뒤따르는 메아리 파동(지연 스프레이)이 나오도록 맵 이펙터 유지기에 맡긴다(CompApocrypha.SpawnEffecter). -->
  <EffecterDef>
    <defName>VV_Effecter_ApocryphaShockwave</defName>
    <maintainTicks>20</maintainTicks>
    <children>
      <li>
        <subEffecterClass>SubEffecter_SoundTriggered</subEffecterClass>
        <soundDef>Explosion_MechBandShockwave</soundDef>
        <spawnLocType>OnSource</spawnLocType>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
        <moteDef>VV_Mote_ApocryphaMagentaFlash</moteDef>
        <spawnLocType>OnSource</spawnLocType>
        <burstCount>1</burstCount>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
        <fleckDef>VV_Fleck_ApocryphaShockWave</fleckDef>
        <spawnLocType>OnSource</spawnLocType>
        <burstCount>1</burstCount>
        <absoluteAngle>true</absoluteAngle>
        <rotation>0~360</rotation>
      </li>
      <!-- 뒤따르는 작은 메아리 파동 -->
      <li>
        <subEffecterClass>SubEffecter_SprayerTriggeredDelayed</subEffecterClass>
        <fleckDef>VV_Fleck_ApocryphaShockWave</fleckDef>
        <spawnLocType>OnSource</spawnLocType>
        <initialDelayTicks>14</initialDelayTicks>
        <absoluteAngle>true</absoluteAngle>
        <rotation>0~360</rotation>
        <scale>0.55</scale>
        <color>(1, 1, 1, 0.6)</color>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
        <fleckDef>VV_Fleck_ApocryphaEmber</fleckDef>
        <spawnLocType>OnSource</spawnLocType>
        <burstCount>30~40</burstCount>
        <positionRadius>1.5</positionRadius>
        <angle>0~360</angle>
        <fleckUsesAngleForVelocity>true</fleckUsesAngleForVelocity>
        <speed>3~7</speed>
        <scale>0.3~0.7</scale>
        <color>(1, 0.45, 0.9, 1)</color>
      </li>
    </children>
  </EffecterDef>

  <!-- 2페이즈 모핑 중 심장 박동마다: 작은 굴절 파동 + 핏빛 불씨 -->
