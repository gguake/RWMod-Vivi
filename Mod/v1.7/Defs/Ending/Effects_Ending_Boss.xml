    <graphicData>
      <texPath>Things/Mote/DustPuff</texPath>
      <renderInstanced>true</renderInstanced>
      <color>(0.45, 0.42, 0.42, 0.85)</color>
    </graphicData>
  </FleckDef>

  <!-- 독성 브레스(녹색/자홍 독가스) -->
