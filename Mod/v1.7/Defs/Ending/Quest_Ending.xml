<?xml version="1.0" encoding="UTF-8"?>
<Defs>
  <!-- 엔딩 퀘스트 1: 〈비비 연방의 밀서〉. 사건 VV_GiveQuest_ViviMissive(Incidents_Ending.xml)가 일어날 때 만들어지고(ViviEndingQuest),
       진행 중인 동안 제단 건설과 통신기 고대 호박 코어 의뢰가 열린다. 5단계 대조율 의식이 끝나면 성공으로 끝난다.
       이름·설명·편지는 루트 노드가 Keyed 번역으로 채우므로 문법 규칙이 없다.
       두 퀘스트 모두 이념 DLC의 아르코넥서스 이주(MoveColonyAndReset)에도 끝나지 않는다(바닐라 아르코넥서스 퀘스트와 같은 endOnColonyMove=false).
       밀서는 이주 뒤에도 이어져 코어를 의뢰할 수 있고, 본편은 앵커가 옛 정착지와 함께 사라지면 〈영원꽃 소실〉로 실패한다. -->
  <QuestScriptDef>
    <defName>VV_EndGame_ViviMissive</defName>
    <isRootSpecial>true</isRootSpecial>
    <autoAccept>true</autoAccept>
    <sendAvailableLetter>false</sendAvailableLetter>
    <endOnColonyMove>false</endOnColonyMove>
    <root Class="VVRace.QuestNode_Root_ViviMissive" />
  </QuestScriptDef>

  <!-- 엔딩 퀘스트 2: 〈만개하는 여명〉. 5단계 대조율 의식이 끝나는 순간 앵커 영원꽃과 함께 만들어진다.
       공성 → 평화 기간 → 아포크리파 → 여왕의 대관식 → 엔딩, 영원꽃 찬탈·소실 시 실패. -->
  <QuestScriptDef>
    <defName>VV_EndGame_ViviBloom</defName>
    <isRootSpecial>true</isRootSpecial>
    <autoAccept>true</autoAccept>
    <sendAvailableLetter>false</sendAvailableLetter>
    <endOnColonyMove>false</endOnColonyMove>
    <defaultChallengeRating>4</defaultChallengeRating>
    <root Class="VVRace.QuestNode_Root_ViviBloom" />
  </QuestScriptDef>

  <!-- 엔딩 막간 〈불길한 정적〉: 평화 기간 동안 화면 상단에 남은 시간을 보여주는 표시용 컨디션.
       실제 위협 억제는 VVRace.EndingCorePatch(IncidentWorker.CanFireNow 포스트픽스)가 한다.
       preventIncidents는 상인·방문객 같은 긍정적 사건까지 막으므로 쓰지 않는다. -->
  <GameConditionDef>
    <defName>VV_OminousSilence</defName>
    <conditionClass>GameCondition</conditionClass>
    <label>ominous silence</label>
    <description>An enormous psychic wave of unknown origin is interfering with the roots of the everflower, and the flow of its final bloom has come to a halt. The enemies that were swarming toward the altar have suddenly stopped coming, but something vast and hollow is crawling toward the warmth of the everflower.</description>
    <natural>false</natural>
    <displayOnUI>true</displayOnUI>
    <preventIncidents>false</preventIncidents>
    <canBePermanent>false</canBePermanent>
  </GameConditionDef>
</Defs>