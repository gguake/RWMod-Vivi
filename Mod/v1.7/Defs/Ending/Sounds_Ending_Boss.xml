<?xml version="1.0" encoding="UTF-8"?>
<Defs>
  <!-- 아포크리파 바늘 조준음. 조준(2.5초) 동안 차오르다 발사 순간에 맞춰 사라지도록 잘라 두었고, 게임 배속에 맞춰 빨라지게 한다. -->
  <SoundDef>
    <defName>VV_ApocryphaNeedleCharge</defName>
    <context>MapOnly</context>
    <maxSimultaneous>1</maxSimultaneous>
    <subSounds>
      <li>
        <grains>
          <li Class="AudioGrain_Clip">
            <clipPath>SFX/VV_ApocryphaNeedleCharge</clipPath>
          </li>
        </grains>
        <volumeRange>17</volumeRange>
        <pitchRange>0.97~1.03</pitchRange>
        <tempoAffectedByGameSpeed>true</tempoAffectedByGameSpeed>
        <sustainLoop>False</sustainLoop>
      </li>
    </subSounds>
  </SoundDef>

  <!-- 2페이즈 기절이 풀려 꽂힌 바늘을 뽑아낼 때. 조준음의 가장 밝은 구간을 짧게 잘라 낮은 웅웅거림을 걷어냈다. 여러 바늘을 한꺼번에 뽑아도 한 번만 낸다. -->
  <SoundDef>
    <defName>VV_ApocryphaNeedlePullOut</defName>
    <context>MapOnly</context>
    <maxSimultaneous>1</maxSimultaneous>
    <subSounds>
      <li>
        <grains>
          <li Class="AudioGrain_Clip">
            <clipPath>SFX/VV_ApocryphaNeedlePullOut</clipPath>
          </li>
        </grains>
        <volumeRange>16</volumeRange>
        <pitchRange>0.95~1.05</pitchRange>
        <sustainLoop>False</sustainLoop>
      </li>
    </subSounds>
  </SoundDef>

  <!-- 요정 비비 사출 조준음: 조준이 하나라도 있는 동안 보스에게 이어지는 지속음. 줄어들던 원본을 평평하게 펴 4초 반복으로 이었고,
       바닐라 헬스피어 캐논 조준음과 같은 크기로 맞췄다. 조준이 끝나면 0.4초에 걸쳐 흐려진다. -->
  <SoundDef>
    <defName>VV_ApocryphaFairyCharge</defName>
    <sustain>True</sustain>
    <context>MapOnly</context>
    <priorityMode>PrioritizeNearest</priorityMode>
    <sustainFadeoutTime>0.4</sustainFadeoutTime>
    <subSounds>
      <li>
        <grains>
          <li Class="AudioGrain_Clip">
            <clipPath>SFX/VV_ApocryphaFairyCharge</clipPath>
          </li>
        </grains>
        <volumeRange>7</volumeRange>
        <tempoAffectedByGameSpeed>true</tempoAffectedByGameSpeed>
        <sustainAttack>0.3</sustainAttack>
        <sustainSkipFirstAttack>false</sustainSkipFirstAttack>
      </li>
    </subSounds>
  </SoundDef>

  <!-- 요정 비비 사출탄 폭발음(VV_FairyBlast). 최대 볼륨에서 바닐라 폭탄음보다 첫 타격이 약 3dB 작다. -->
  <SoundDef>
    <defName>VV_ApocryphaFairyBlast</defName>
    <context>MapOnly</context>
    <maxSimultaneous>1</maxSimultaneous>
    <subSounds>
      <li>
        <grains>
          <li Class="AudioGrain_Clip">
            <clipPath>SFX/VV_ApocryphaFairyBlast</clipPath>
          </li>
        </grains>
        <volumeRange>100</volumeRange>
        <pitchRange>0.92~1.08</pitchRange>
        <sustainLoop>False</sustainLoop>
      </li>
    </subSounds>
  </SoundDef>

  <!-- 1페이즈 무력화(마나 보호장이 깨짐): 보호막이 깨지고 힘이 빠져나가는 소리.
       바닐라 보호막 파괴음과 기절 폭발음 두 겹을 대신하며, 최대 볼륨에서도 이전 두 겹보다 첫 타격이 약 4dB 작다. -->
  <SoundDef>
    <defName>VV_ApocryphaGroggyPhase1</defName>
    <context>MapOnly</context>
    <maxSimultaneous>1</maxSimultaneous>
    <subSounds>
      <li>
        <grains>
          <li Class="AudioGrain_Clip">
            <clipPath>SFX/VV_ApocryphaGroggyPhase1</clipPath>
          </li>
        </grains>
        <volumeRange>100</volumeRange>
        <sustainLoop>False</sustainLoop>
      </li>
    </subSounds>
  </SoundDef>

  <!-- 2페이즈 무력화(바늘이 모두 꽂힘·공명 파동): 거대한 몸이 무너지는 소리. 바닐라 기절 폭발음을 대신하며 첫 타격이 약 3dB 작다. -->
  <SoundDef>
    <defName>VV_ApocryphaGroggyPhase2</defName>
    <context>MapOnly</context>
    <maxSimultaneous>1</maxSimultaneous>
    <subSounds>
      <li>
        <grains>
          <li Class="AudioGrain_Clip">
            <clipPath>SFX/VV_ApocryphaGroggyPhase2</clipPath>
          </li>
        </grains>
        <volumeRange>100</volumeRange>
        <sustainLoop>False</sustainLoop>
      </li>
    </subSounds>
  </SoundDef>

  <!-- 2페이즈 바늘이 보스에게 꽂힘. 바늘 발사음보다 조금 크게 두어 맞혔다는 손맛을 준다. -->
  <SoundDef>
    <defName>VV_ApocryphaNeedleStick</defName>
    <context>MapOnly</context>
    <maxSimultaneous>1</maxSimultaneous>
    <subSounds>
      <li>
        <grains>
          <li Class="AudioGrain_Clip">
            <clipPath>SFX/VV_ApocryphaNeedleStick</clipPath>
          </li>
        </grains>
        <volumeRange>52</volumeRange>
        <pitchRange>0.95~1.05</pitchRange>
        <sustainLoop>False</sustainLoop>
      </li>
    </subSounds>
  </SoundDef>

  <!-- 아포크리파 바늘 발사음. 같은 틱에 여러 바늘이 함께 쏘면 한 번만 낸다. -->
  <SoundDef>
    <defName>VV_ApocryphaNeedleFire</defName>
    <context>MapOnly</context>
    <maxSimultaneous>1</maxSimultaneous>
    <subSounds>
      <li>
        <grains>
          <li Class="AudioGrain_Clip">
            <clipPath>SFX/VV_ApocryphaNeedleFire</clipPath>
          </li>
        </grains>
        <volumeRange>55</volumeRange>
        <pitchRange>0.95~1.05</pitchRange>
        <sustainLoop>False</sustainLoop>
      </li>
    </subSounds>
  </SoundDef>
</Defs>
