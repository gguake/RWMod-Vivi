<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 아포크리파 1페이즈 기믹 연출. VFX 텍스처는 검정 배경 RGB라 가산(MoteGlow) 셰이더로만 쓴다.
       흰색 텍스처(VV_Scent*)는 스프레이어의 color로 금빛/자홍으로 물들인다.
       다른 모듈과 이름이 겹치지 않도록 이 파일의 플렉은 모두 VV_Fleck_Gimmick 접두사를 쓴다. -->

  <!-- ======================== Flecks ======================== -->

  <!-- 네 갈래 반짝임 -->
  <FleckDef ParentName="FleckBase_Thrown">
    <defName>VV_Fleck_GimmickTwinkle</defName>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <fadeInTime>0.08</fadeInTime>
    <solidTime>0.12</solidTime>
    <fadeOutTime>0.4</fadeOutTime>
    <graphicData>
      <texPath>VFX/VV_ScentTwinkle</texPath>
      <shaderType>MoteGlow</shaderType>
      <renderInstanced>true</renderInstanced>
    </graphicData>
  </FleckDef>

  <!-- 떠오르는 작은 빛 알갱이 -->
  <FleckDef ParentName="FleckBase_Thrown">
    <defName>VV_Fleck_GimmickMote</defName>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <fadeInTime>0.3</fadeInTime>
    <solidTime>0.6</solidTime>
