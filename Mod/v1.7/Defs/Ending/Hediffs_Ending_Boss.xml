<?xml version="1.0" encoding="UTF-8"?>
<Defs>
  <!-- 1페이즈 〈요정 비비 결속〉: 플레이어 비비의 결속 헤디프와 같은 라벨. 수치(1,440,000,000)는 CompApocrypha가 보관하고 라벨에만 표시한다. -->
  <HediffDef>
    <defName>VV_ApocryphaFairyBond</defName>
    <label>vivi fairy</label>
    <description>The souls of 1,440,000,000 fairy vivis bound to the old empire's last queen form a mana shield that absorbs all attacks.</description>
    <hediffClass>VVRace.Hediff_ApocryphaFairyBond</hediffClass>
    <defaultLabelColor>(0, 1, 1)</defaultLabelColor>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <scenarioCanAdd>false</scenarioCanAdd>
    <priceImpact>false</priceImpact>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>1</maxSeverity>
  </HediffDef>

  <!-- 2페이즈 〈시조의 외피〉: 꽂힌 바늘에 따른 받는 피해 배율 표시(실제 배율은 CompApocrypha)와 이동속도 보정(1.5 → 5.0). -->
  <HediffDef>
    <defName>VV_ApocryphaCarapace</defName>
    <label>primordial carapace</label>
    <description>The progenitor hornet's carapace has hardened over centuries of condensed mana. Her own giant eltex needles can pierce and weaken it.</description>
    <hediffClass>VVRace.Hediff_ApocryphaCarapace</hediffClass>
    <defaultLabelColor>(1, 0.42, 0.85)</defaultLabelColor>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <scenarioCanAdd>false</scenarioCanAdd>
    <priceImpact>false</priceImpact>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <stages>
      <li>
        <statOffsets>
          <MoveSpeed>2.5</MoveSpeed>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>
</Defs>