<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 엔딩 이후 보상 연출: 〈안식의 바람〉, 〈하늘 방패〉, 여왕의 권능(생명 공명·선고·마나 보호막).
       기존 영원꽃·엔딩 연출의 플렉을 재사용하고 바람 줄기와 말벌 가루만 새로 정의한다. -->

  <!-- ===== 〈안식의 바람〉 ===== -->

  <!-- 파면을 따라 바깥으로 흐르는 옅은 바람 줄기(가산). WindOfRest가 파면 방향으로 회전·속도를 정해 생성한다 -->
  <FleckDef ParentName="FleckBase_Thrown">
    <defName>VV_Fleck_WindOfRestGust</defName>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <fadeInTime>0.15</fadeInTime>
    <solidTime>0.25</solidTime>
    <fadeOutTime>0.6</fadeOutTime>
    <graphicData>
      <texPath>VFX/VV_WindGust</texPath>
      <shaderType>MoteGlow</shaderType>
      <renderInstanced>true</renderInstanced>
      <color>(1, 0.97, 0.85, 0.55)</color>
      <drawSize>(1.2, 2.6)</drawSize>
    </graphicData>
  </FleckDef>

  <!-- 거대 말벌의 몸이 부서진 가루. DissolvingHornet이 바람 방향으로 색·속도를 정해 생성한다 -->
  <FleckDef ParentName="FleckBase_Thrown">
    <defName>VV_Fleck_HornetDust</defName>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <fadeInTime>0.05</fadeInTime>
    <solidTime>0.3</solidTime>
    <fadeOutTime>1.1</fadeOutTime>
    <growthRate>0.9</growthRate>
    <graphicData>
      <texPath>Things/Mote/DustPuff</texPath>
      <renderInstanced>true</renderInstanced>
    </graphicData>
  </FleckDef>

  <!-- 의식 완료(영원꽃): 섬광 + 퍼지는 금빛 고리 + 사방으로 터지는 꽃잎. 바람의 파면은 WindOfRest가 그린다 -->
  <EffecterDef>
    <defName>VV_Effecter_WindOfRestComplete</defName>
    <children>
      <li>
        <subEffecterClass>SubEffecter_SoundTriggered</subEffecterClass>
        <soundDef>VV_EverflowerRitualComplete</soundDef>
        <spawnLocType>OnSource</spawnLocType>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
        <moteDef>VV_Mote_FairyficationFlash</moteDef>
        <burstCount>1</burstCount>
        <spawnLocType>OnSource</spawnLocType>
        <scale>1.6</scale>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
        <fleckDef>VV_Fleck_ResonanceWaveRingSlow</fleckDef>
        <spawnLocType>OnSource</spawnLocType>
        <burstCount>1</burstCount>
        <absoluteAngle>true</absoluteAngle>
        <rotation>0~360</rotation>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
        <fleckDef>VV_Fleck_EverflowerPetal_Burst</fleckDef>
        <spawnLocType>OnSource</spawnLocType>
        <burstCount>24~32</burstCount>
        <positionRadius>0.6</positionRadius>
        <angle>0~360</angle>
        <fleckUsesAngleForVelocity>true</fleckUsesAngleForVelocity>
        <speed>2~4</speed>
        <rotation>0~360</rotation>
        <rotationRate>-260~260</rotationRate>
        <scale>0.2~0.45</scale>
      </li>
    </children>
  </EffecterDef>

  <!-- 바람에 닿아 불안정·스카리아가 걷힌 폰: 작은 반짝임과 꽃잎. 동시에 여럿이 정화되므로 소리는 넣지 않는다 -->
  <EffecterDef>
    <defName>VV_Effecter_WindOfRestCleanse</defName>
    <children>
      <li>
        <subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
        <fleckDef>NewbornBecomeChildGlimmer</fleckDef>
        <spawnLocType>OnSource</spawnLocType>
        <burstCount>5~8</burstCount>
        <positionRadius>0.5</positionRadius>
        <speed>0.2~0.5</speed>
        <rotation>-45</rotation>
        <angle>0</angle>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
        <fleckDef>VV_Fleck_EverflowerPetal_Burst</fleckDef>
        <spawnLocType>OnSource</spawnLocType>
        <burstCount>4~6</burstCount>
        <positionRadius>0.3</positionRadius>
        <angle>0~360</angle>
        <fleckUsesAngleForVelocity>true</fleckUsesAngleForVelocity>
        <speed>0.6~1.4</speed>
        <rotation>0~360</rotation>
        <rotationRate>-260~260</rotationRate>
        <scale>0.15~0.3</scale>
      </li>
    </children>
  </EffecterDef>

  <!-- 거대 말벌이 가루가 되기 시작하는 순간: 흙먼지와 반짝임. 이후 가루는 DissolvingHornet이 날린다 -->
  <EffecterDef>
    <defName>VV_Effecter_HornetDissolve</defName>
    <children>
      <li>
        <subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
        <fleckDef>DustPuffThick</fleckDef>
        <spawnLocType>OnSource</spawnLocType>
        <burstCount>3~5</burstCount>
        <positionRadius>0.6</positionRadius>
        <speed>0.3~0.8</speed>
        <scale>1.2~1.8</scale>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
        <fleckDef>NewbornBecomeChildGlimmer</fleckDef>
        <spawnLocType>OnSource</spawnLocType>
        <burstCount>6~9</burstCount>
        <positionRadius>0.8</positionRadius>
        <speed>0.2~0.5</speed>
        <rotation>-45</rotation>
        <angle>0</angle>
      </li>
    </children>
  </EffecterDef>

  <!-- ===== 〈하늘 방패〉 의식 완료: 고각 보호막 기동음 + 금빛 고리 + 하늘로 오르는 반짝임 ===== -->
  <EffecterDef>
    <defName>VV_Effecter_SkyShieldComplete</defName>
    <children>
      <li>
        <subEffecterClass>SubEffecter_SoundTriggered</subEffecterClass>
        <soundDef>VV_EverflowerRitualComplete</soundDef>
        <spawnLocType>OnSource</spawnLocType>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SoundTriggered</subEffecterClass>
        <soundDef>MortarShieldGenerator_Reactivate</soundDef>
        <spawnLocType>OnSource</spawnLocType>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
        <moteDef>VV_Mote_FairyficationFlash</moteDef>
        <burstCount>1</burstCount>
        <spawnLocType>OnSource</spawnLocType>
        <scale>1.6</scale>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
        <fleckDef>VV_Fleck_ResonanceWaveRing</fleckDef>
        <spawnLocType>OnSource</spawnLocType>
        <burstCount>1</burstCount>
        <absoluteAngle>true</absoluteAngle>
        <rotation>0~360</rotation>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
        <fleckDef>NewbornBecomeChildGlimmer</fleckDef>
        <spawnLocType>OnSource</spawnLocType>
        <burstCount>12~16</burstCount>
        <positionRadius>1.2</positionRadius>
        <speed>0.4~0.9</speed>
        <rotation>-45</rotation>
        <angle>0</angle>
      </li>
    </children>
  </EffecterDef>

  <!-- ===== 생명 공명 ===== -->

  <!-- 여왕의 시체가 금빛 꽃잎으로 흩어진다 -->
  <EffecterDef>
    <defName>VV_Effecter_QueenCorpseBloom</defName>
    <children>
      <li>
        <subEffecterClass>SubEffecter_SoundTriggered</subEffecterClass>
        <soundDef>VV_FairyDematerialize</soundDef>
        <spawnLocType>OnSource</spawnLocType>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
        <fleckDef>VV_Fleck_GimmickFlash</fleckDef>
        <spawnLocType>OnSource</spawnLocType>
        <burstCount>1</burstCount>
        <scale>2.2</scale>
        <color>(1, 0.9, 0.6)</color>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
        <fleckDef>VV_Fleck_EverflowerPetal_Burst</fleckDef>
        <spawnLocType>OnSource</spawnLocType>
        <burstCount>20~28</burstCount>
        <positionRadius>0.5</positionRadius>
        <angle>-50~50</angle>
        <fleckUsesAngleForVelocity>true</fleckUsesAngleForVelocity>
        <speed>1~2.5</speed>
        <rotation>0~360</rotation>
        <rotationRate>-260~260</rotationRate>
        <scale>0.2~0.4</scale>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
        <fleckDef>NewbornBecomeChildGlimmer</fleckDef>
        <spawnLocType>OnSource</spawnLocType>
        <burstCount>8~12</burstCount>
        <positionRadius>0.6</positionRadius>
        <speed>0.2~0.5</speed>
        <rotation>-45</rotation>
        <angle>0</angle>
      </li>
    </children>
  </EffecterDef>

  <!-- 영원꽃 앞에서 여왕이 다시 깨어난다: 대관식 완료 연출과 같은 고리·꽃잎 -->
  <EffecterDef>
    <defName>VV_Effecter_QueenRebirth</defName>
    <children>
      <li>
        <subEffecterClass>SubEffecter_SoundTriggered</subEffecterClass>
        <soundDef>VV_UndoFairyfication</soundDef>
        <spawnLocType>OnSource</spawnLocType>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
        <moteDef>VV_Mote_FairyficationFlash</moteDef>
        <burstCount>1</burstCount>
        <spawnLocType>OnSource</spawnLocType>
        <scale>1.6</scale>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
        <fleckDef>VV_Fleck_CoronationRing</fleckDef>
        <spawnLocType>OnSource</spawnLocType>
        <burstCount>1</burstCount>
        <absoluteAngle>true</absoluteAngle>
        <rotation>0~360</rotation>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
        <fleckDef>VV_Fleck_EverflowerPetal_Burst</fleckDef>
        <spawnLocType>OnSource</spawnLocType>
        <burstCount>16~24</burstCount>
        <positionRadius>0.4</positionRadius>
        <angle>0~360</angle>
        <fleckUsesAngleForVelocity>true</fleckUsesAngleForVelocity>
        <speed>1~2.5</speed>
        <rotation>0~360</rotation>
        <rotationRate>-260~260</rotationRate>
        <scale>0.2~0.4</scale>
      </li>
    </children>
  </EffecterDef>

  <!-- ===== 선고: 허공에 바늘이 맺히는 순간의 금빛 고리와 반짝임(조준음은 아포크리파 바늘 조준 연출이 낸다) ===== -->
  <EffecterDef>
    <defName>VV_Effecter_QueenVerdictSummon</defName>
    <children>
      <li>
        <subEffecterClass>SubEffecter_SoundTriggered</subEffecterClass>
        <soundDef>VV_FairyMaterialize</soundDef>
        <spawnLocType>OnSource</spawnLocType>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
        <fleckDef>VV_Fleck_GimmickPhaseRing</fleckDef>
        <spawnLocType>OnSource</spawnLocType>
        <burstCount>1</burstCount>
        <scale>2.4</scale>
        <absoluteAngle>true</absoluteAngle>
        <rotation>0~360</rotation>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
        <fleckDef>VV_Fleck_GimmickTwinkle</fleckDef>
        <spawnLocType>OnSource</spawnLocType>
        <burstCount>8~12</burstCount>
        <positionRadius>1.2</positionRadius>
        <speed>0.3~0.8</speed>
        <angle>0~360</angle>
        <fleckUsesAngleForVelocity>true</fleckUsesAngleForVelocity>
        <scale>0.3~0.6</scale>
      </li>
    </children>
  </EffecterDef>

  <!-- ===== 마나 보호막: 주변 마나가 모여드는 파동 + 저각 보호막 기동음 ===== -->
  <EffecterDef>
    <defName>VV_Effecter_QueenManaBarrier</defName>
    <children>
      <li>
        <subEffecterClass>SubEffecter_SoundTriggered</subEffecterClass>
        <soundDef>BulletShieldGenerator_Reactivate</soundDef>
        <spawnLocType>OnSource</spawnLocType>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
        <fleckDef>VV_Fleck_Manawave</fleckDef>
        <spawnLocType>OnSource</spawnLocType>
        <burstCount>1</burstCount>
        <scale>0.4</scale>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
        <fleckDef>NewbornBecomeChildGlimmer</fleckDef>
        <spawnLocType>OnSource</spawnLocType>
        <burstCount>10~14</burstCount>
        <positionRadius>3</positionRadius>
        <speed>0.3~0.7</speed>
        <rotation>-45</rotation>
        <angle>0</angle>
        <color>(0.55, 0.9, 1)</color>
      </li>
    </children>
  </EffecterDef>

  <!-- ===== 〈꽃의 대지〉 ===== -->

  <!-- 의식 완료(영원꽃): 섬광 + 사방으로 터지는 꽃잎 -->
  <EffecterDef>
    <defName>VV_Effecter_FlowerLandComplete</defName>
    <children>
      <li>
        <subEffecterClass>SubEffecter_SoundTriggered</subEffecterClass>
        <soundDef>VV_EverflowerRitualComplete</soundDef>
        <spawnLocType>OnSource</spawnLocType>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
        <moteDef>VV_Mote_FairyficationFlash</moteDef>
        <burstCount>1</burstCount>
        <spawnLocType>OnSource</spawnLocType>
        <scale>1.6</scale>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
        <fleckDef>VV_Fleck_EverflowerPetal_Burst</fleckDef>
        <spawnLocType>OnSource</spawnLocType>
        <burstCount>16~24</burstCount>
        <positionRadius>0.4</positionRadius>
        <angle>0~360</angle>
        <fleckUsesAngleForVelocity>true</fleckUsesAngleForVelocity>
        <speed>1~2.5</speed>
        <rotation>0~360</rotation>
        <rotationRate>-260~260</rotationRate>
        <scale>0.2~0.4</scale>
      </li>
    </children>
  </EffecterDef>

  <!-- 꽃밭이 생긴 자리: 반경(6.6칸)까지 퍼지는 금빛 고리. 크기 = (1 + 1.8×초) × 4칸이라 약 1.4초에 지름 14칸에 닿는다 -->
  <FleckDef ParentName="FleckBase">
    <defName>VV_Fleck_FlowerLandRing</defName>
    <altitudeLayer>MoteOverheadLow</altitudeLayer>
    <fadeInTime>0.05</fadeInTime>
    <solidTime>0.6</solidTime>
    <fadeOutTime>0.8</fadeOutTime>
    <growthRate>1.8</growthRate>
    <drawOffscreen>true</drawOffscreen>
    <graphicData>
      <texPath>VFX/VV_GoldenWaveRing</texPath>
      <shaderType>MoteGlow</shaderType>
      <drawSize>(4, 4)</drawSize>
    </graphicData>
  </FleckDef>

  <!-- 꽃밭이 생긴 자리: 맑은 소리 + 금빛 고리 + 범위 전체에서 피어오르는 꽃잎·반짝임 -->
  <EffecterDef>
    <defName>VV_Effecter_FlowerLandBloom</defName>
    <children>
      <li>
        <subEffecterClass>SubEffecter_SoundTriggered</subEffecterClass>
        <soundDef>VV_FairyMaterialize</soundDef>
        <spawnLocType>OnSource</spawnLocType>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
        <fleckDef>VV_Fleck_FlowerLandRing</fleckDef>
        <spawnLocType>OnSource</spawnLocType>
        <burstCount>1</burstCount>
        <absoluteAngle>true</absoluteAngle>
        <rotation>0~360</rotation>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
        <fleckDef>VV_Fleck_EverflowerPetal_Burst</fleckDef>
        <spawnLocType>OnSource</spawnLocType>
        <burstCount>50~70</burstCount>
        <positionRadius>6</positionRadius>
        <angle>-40~40</angle>
        <fleckUsesAngleForVelocity>true</fleckUsesAngleForVelocity>
        <speed>0.6~1.6</speed>
        <rotation>0~360</rotation>
        <rotationRate>-260~260</rotationRate>
        <scale>0.2~0.45</scale>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
        <fleckDef>NewbornBecomeChildGlimmer</fleckDef>
        <spawnLocType>OnSource</spawnLocType>
        <burstCount>24~32</burstCount>
        <positionRadius>6</positionRadius>
        <speed>0.2~0.5</speed>
        <rotation>-45</rotation>
        <angle>0</angle>
      </li>
    </children>
  </EffecterDef>
</Defs>
