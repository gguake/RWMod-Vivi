<?xml version="1.0" encoding="UTF-8"?>
<Defs>
  <!-- 아포크리파 1페이즈 기믹: 요정 간섭, 멸망꽃 저주 -->

  <!-- 요정 간섭: 요정꽃과 결속한 비비. 6시간(15000틱) 안에 1페이즈 아포크리파에게 2.9칸 이내로 다가가면 결속 해방 -->
  <HediffDef>
    <defName>VV_FairyInterference</defName>
    <label>fairy interference</label>
    <description>Can interfere with the bonds between Asphodel and the fairy vivis, severing them to set the fairy vivis free.</description>
    <hediffClass>VVRace.Hediff_FairyInterference</hediffClass>
    <defaultLabelColor>(1, 0.9, 0.55)</defaultLabelColor>
    <isBad>false</isBad>
    <priceImpact>false</priceImpact>
    <scenarioCanAdd>false</scenarioCanAdd>
    <everCurableByItem>false</everCurableByItem>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>15000~15000</disappearsAfterTicks>
        <showRemainingTime>false</showRemainingTime>
        <messageOnDisappear>{PAWN_labelShort}'s fairy interference has faded.</messageOnDisappear>
      </li>
    </comps>
  </HediffDef>

  <!-- 멸망꽃 저주 공용: 5단계(severity 1~5, DoomBlightUtility.MaxBlightLevel), 결속 해방이나 엔딩 정리로만 풀린다(죽으면 함께 사라짐 — Hediff_DoomBlight) -->
  <HediffDef Name="VV_DoomBlightBase" Abstract="True">
    <hediffClass>VVRace.Hediff_DoomBlight</hediffClass>
    <defaultLabelColor>(0.95, 0.45, 0.8)</defaultLabelColor>
    <isBad>true</isBad>
    <priceImpact>false</priceImpact>
    <scenarioCanAdd>false</scenarioCanAdd>
    <everCurableByItem>false</everCurableByItem>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>5</maxSeverity>
  </HediffDef>

  <!-- 공포: 고통 한계 감소 + 정신 붕괴 기준 상승.
       정신 붕괴 기준은 바닐라 최대값이 0.50(기본 0.35)이라 V단계 +0.15에서 상한에 닿도록 나눈다(그보다 크면 IV·V가 같아짐). -->
  <HediffDef ParentName="VV_DoomBlightBase">
    <defName>VV_DoomBlight_Fear</defName>
    <label>doom blight: dread</label>
    <description>In the visions conjured by the doom bloom, the old nests burn and the screaming never stops. The afflicted collapse from pain more easily and become more prone to mental breaks.</description>
    <stages>
      <li>
        <minSeverity>1</minSeverity>
        <statOffsets>
          <PainShockThreshold>-0.04</PainShockThreshold>
          <MentalBreakThreshold>0.03</MentalBreakThreshold>
        </statOffsets>
      </li>
      <li>
        <minSeverity>2</minSeverity>
        <statOffsets>
          <PainShockThreshold>-0.08</PainShockThreshold>
          <MentalBreakThreshold>0.06</MentalBreakThreshold>
        </statOffsets>
      </li>
      <li>
        <minSeverity>3</minSeverity>
        <statOffsets>
          <PainShockThreshold>-0.12</PainShockThreshold>
          <MentalBreakThreshold>0.09</MentalBreakThreshold>
        </statOffsets>
      </li>
      <li>
        <minSeverity>4</minSeverity>
        <statOffsets>
          <PainShockThreshold>-0.16</PainShockThreshold>
          <MentalBreakThreshold>0.12</MentalBreakThreshold>
        </statOffsets>
      </li>
      <li>
        <minSeverity>5</minSeverity>
        <statOffsets>
          <PainShockThreshold>-0.20</PainShockThreshold>
          <MentalBreakThreshold>0.15</MentalBreakThreshold>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <!-- 허기: 허기·피로 증가. 1.7에는 허기 StatDef가 없으므로 hungerRateFactor/restFallFactor 사용 -->
  <HediffDef ParentName="VV_DoomBlightBase">
    <defName>VV_DoomBlight_Hunger</defName>
    <label>doom blight: famine</label>
    <description>Haunted by visions of living through the empire's last days, when every flower withered and the honey ran dry. Severe hunger and fatigue set in.</description>
    <stages>
      <li>
        <minSeverity>1</minSeverity>
        <hungerRateFactor>1.5</hungerRateFactor>
        <restFallFactor>1.5</restFallFactor>
      </li>
      <li>
        <minSeverity>2</minSeverity>
        <hungerRateFactor>2</hungerRateFactor>
        <restFallFactor>2</restFallFactor>
      </li>
      <li>
        <minSeverity>3</minSeverity>
        <hungerRateFactor>2.5</hungerRateFactor>
        <restFallFactor>2.5</restFallFactor>
      </li>
      <li>
        <minSeverity>4</minSeverity>
        <hungerRateFactor>3</hungerRateFactor>
        <restFallFactor>3</restFallFactor>
      </li>
      <li>
        <minSeverity>5</minSeverity>
        <hungerRateFactor>3.5</hungerRateFactor>
        <restFallFactor>3.5</restFallFactor>
      </li>
    </stages>
  </HediffDef>

  <!-- 역병: 면역 획득 속도(질병 회복)·부상 회복 속도 감소 + 받는 피해 증가. -->
  <HediffDef ParentName="VV_DoomBlightBase">
    <defName>VV_DoomBlight_Plague</defName>
    <label>doom blight: plague</label>
    <description>The old empire's plague, which no medicine could cure, seeps into the body through hallucinations. Recovery from disease and injuries is slower, and damage taken is increased.</description>
    <stages>
      <li>
        <minSeverity>1</minSeverity>
        <statFactors>
          <ImmunityGainSpeed>0.9</ImmunityGainSpeed>
          <InjuryHealingFactor>0.8</InjuryHealingFactor>
          <IncomingDamageFactor>1.05</IncomingDamageFactor>
        </statFactors>
      </li>
      <li>
        <minSeverity>2</minSeverity>
        <statFactors>
          <ImmunityGainSpeed>0.8</ImmunityGainSpeed>
          <InjuryHealingFactor>0.7</InjuryHealingFactor>
          <IncomingDamageFactor>1.1</IncomingDamageFactor>
        </statFactors>
      </li>
      <li>
        <minSeverity>3</minSeverity>
        <statFactors>
          <ImmunityGainSpeed>0.7</ImmunityGainSpeed>
          <InjuryHealingFactor>0.6</InjuryHealingFactor>
          <IncomingDamageFactor>1.15</IncomingDamageFactor>
        </statFactors>
      </li>
      <li>
        <minSeverity>4</minSeverity>
        <statFactors>
          <ImmunityGainSpeed>0.6</ImmunityGainSpeed>
          <InjuryHealingFactor>0.45</InjuryHealingFactor>
          <IncomingDamageFactor>1.2</IncomingDamageFactor>
        </statFactors>
      </li>
      <li>
        <minSeverity>5</minSeverity>
        <statFactors>
          <ImmunityGainSpeed>0.5</ImmunityGainSpeed>
          <InjuryHealingFactor>0.3</InjuryHealingFactor>
          <IncomingDamageFactor>1.25</IncomingDamageFactor>
        </statFactors>
      </li>
    </stages>
  </HediffDef>
</Defs>
