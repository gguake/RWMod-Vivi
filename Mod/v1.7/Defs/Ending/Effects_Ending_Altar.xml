        <fleckDef>NewbornBecomeChildGlimmer</fleckDef>
        <spawnLocType>OnSource</spawnLocType>
        <burstCount>10~16</burstCount>
        <positionRadius>1.8</positionRadius>
        <speed>0.2~0.5</speed>
        <rotation>-45</rotation>
        <scale>3~5</scale>
        <positionOffset>(-0.31, 0.2, 4.38)</positionOffset>
      </li>
    </children>
  </EffecterDef>

