<?xml version="1.0" encoding="UTF-8"?>
<Defs>
  <DamageDef ParentName="Stun">
    <defName>VV_ManawaveStun</defName>
    <workerClass>VVRace.DamageWorker_ManawaveStun</workerClass>
  </DamageDef>

  <DamageDef>
    <defName>VV_ToxicStab</defName>
    <label>stab</label>
    <workerClass>DamageWorker_Stab</workerClass>
    <externalViolence>true</externalViolence>
    <deathMessage>{0} has been stabbed to death.</deathMessage>
    <hediff>Stab</hediff>
    <hediffSolid>Crack</hediffSolid>
    <impactSoundType>Slice</impactSoundType>
    <armorCategory>Sharp</armorCategory>
    <stabChanceOfForcedInternal>0.6</stabChanceOfForcedInternal>
    <overkillPctToDestroyPart>0.4~1.0</overkillPctToDestroyPart>
    <additionalHediffs>
      <li>
        <hediff>ToxicBuildup</hediff>
        <severityPerDamageDealt>0.012</severityPerDamageDealt>
        <victimSeverityScaling>ToxicResistance</victimSeverityScaling>
        <inverseStatScaling>true</inverseStatScaling>
        <victimSeverityScalingByInvBodySize>true</victimSeverityScalingByInvBodySize>
      </li>
    </additionalHediffs>
  </DamageDef>

  <DamageDef ParentName="Arrow">
    <defName>VV_ToxicArrow</defName>
    <additionalHediffs>
      <li>
        <hediff>ToxicBuildup</hediff>
        <severityPerDamageDealt>0.0065</severityPerDamageDealt>
        <victimSeverityScaling>ToxicResistance</victimSeverityScaling>
        <inverseStatScaling>true</inverseStatScaling>
        <victimSeverityScalingByInvBodySize>true</victimSeverityScalingByInvBodySize>
      </li>
    </additionalHediffs>
  </DamageDef>

  <DamageDef>
    <defName>VV_RangedToxicStab</defName>
    <label>stab</label>
    <workerClass>DamageWorker_AddInjury</workerClass>
    <externalViolence>true</externalViolence>
    <deathMessage>{0} has been stabbed to death.</deathMessage>
    <hediff>Stab</hediff>
    <hediffSolid>Crack</hediffSolid>
    <impactSoundType>Slice</impactSoundType>
    <armorCategory>Sharp</armorCategory>
    <overkillPctToDestroyPart>0~0.7</overkillPctToDestroyPart>
    <isRanged>true</isRanged>
    <makesAnimalsFlee>true</makesAnimalsFlee>
    
    <additionalHediffs>
      <li>
        <hediff>ToxicBuildup</hediff>
        <severityPerDamageDealt>0.012</severityPerDamageDealt>
        <victimSeverityScaling>ToxicResistance</victimSeverityScaling>
        <inverseStatScaling>true</inverseStatScaling>
        <victimSeverityScalingByInvBodySize>true</victimSeverityScalingByInvBodySize>
      </li>
    </additionalHediffs>
  </DamageDef>
  
  <DamageDef>
    <defName>VV_ExtinguishWithWater</defName>
    <label>extinguish</label>
    <workerClass>DamageWorker_Extinguish</workerClass>
    <canInterruptJobs>false</canInterruptJobs>
    <makesBlood>false</makesBlood>
    <defaultDamage>999999</defaultDamage>
    <hediff>CoveredInFirefoam</hediff>
    <explosionCellFleck>BlastExtinguisher</explosionCellFleck>
    <explosionColorEdge>(0.94, 1, 1, 0.1)</explosionColorEdge>
    <soundExplosion>EmergeFromWater</soundExplosion>
    <harmsHealth>false</harmsHealth>
    <combatLogRules>Damage_Extinguish</combatLogRules>
    <consideredHelpful>true</consideredHelpful>
  </DamageDef>
  
  <DamageDef>
    <defName>VV_CompressedWind</defName>
    <label>compressed wind</label>
    <workerClass>VVRace.DamageWorker_CompressedWind</workerClass>
    <harmsHealth>false</harmsHealth>
    <makesBlood>false</makesBlood>
    <defaultDamage>1</defaultDamage>
    <soundExplosion>Explosion_FirefoamPopper</soundExplosion>
    <explosionSnowMeltAmount>0</explosionSnowMeltAmount>
  </DamageDef>

  <DamageDef>
    <defName>VV_Frostbite</defName>
    <workerClass>VVRace.DamageWorker_FrostbiteCustom</workerClass>
    <label>frostbite</label>
    <hasForcefulImpact>false</hasForcefulImpact>
    <makesBlood>false</makesBlood>
    <canInterruptJobs>false</canInterruptJobs>
    <externalViolence>true</externalViolence>
    <deathMessage>{0} has succumbed to frostbite.</deathMessage>
    <hediff>Frostbite</hediff>
    <armorCategory>Heat</armorCategory>
    <minDamageToFragment>15</minDamageToFragment>
    <defaultDamage>10</defaultDamage>
    <defaultArmorPenetration>0</defaultArmorPenetration>
    <explosionCellFleck>VV_Fleck_BlastFrost</explosionCellFleck>
    <explosionColorCenter>(1, 1, 1)</explosionColorCenter>
    <explosionColorEdge>(1, 1, 1)</explosionColorEdge>
    <soundExplosion>VV_Explosion_Frostbite</soundExplosion>
    <combatLogRules>VV_Damage_Frostbite</combatLogRules>
    <canUseDeflectMetalEffect>false</canUseDeflectMetalEffect>
    <scaleDamageToBuildingsBasedOnFlammability>true</scaleDamageToBuildingsBasedOnFlammability>
    <explosionSnowMeltAmount>0</explosionSnowMeltAmount>
    
    <additionalHediffs>
      <li>
        <hediff>VV_Frozen</hediff>
        <severityPerDamageDealt>0.015</severityPerDamageDealt>
      </li>
    </additionalHediffs>
  </DamageDef>
  
  <DamageDef ParentName="Bullet">
    <defName>VV_Bullet_Lava</defName>
    <label>bullet</label>
    <igniteChanceByTargetFlammability>
      <points>
        <li>(0, 0)</li>
        <li>(1, 0.1)</li>
        <li>(2, 1)</li>
      </points>
    </igniteChanceByTargetFlammability>
    <impactSoundType>Bullet</impactSoundType>
    <damageEffecter>VV_Impact_BulletLava</damageEffecter>
  </DamageDef>

  <!-- 고대 엘텍스 바늘 관통 피해 -->
  <DamageDef>
    <defName>VV_GiantNeedlePierce</defName>
    <label>giant needle</label>
    <workerClass>DamageWorker_Stab</workerClass>
    <externalViolence>true</externalViolence>
    <deathMessage>{0} was skewered by an ancient eltex needle.</deathMessage>
    <hediff>Stab</hediff>
    <hediffSolid>Crack</hediffSolid>
    <impactSoundType>Slice</impactSoundType>
    <armorCategory>Sharp</armorCategory>
    <stabChanceOfForcedInternal>0.6</stabChanceOfForcedInternal>
    <overkillPctToDestroyPart>0.4~1.0</overkillPctToDestroyPart>
    <defaultDamage>80</defaultDamage>
    <defaultArmorPenetration>0.8</defaultArmorPenetration>
    <buildingDamageFactor>2</buildingDamageFactor>
  </DamageDef>



  <!-- 요정 비비 사출탄 폭발 피해 -->
  <DamageDef ParentName="Bomb">
    <defName>VV_FairyBlast</defName>
    <label>fairy blast</label>
    <deathMessage>{0} was caught in the blast of a hurled fairy vivi.</deathMessage>
    <defaultDamage>24</defaultDamage>
    <defaultArmorPenetration>0.15</defaultArmorPenetration>
    <buildingDamageFactor>0.5</buildingDamageFactor>
    <buildingDamageFactorImpassable>1</buildingDamageFactorImpassable>
    <buildingDamageFactorPassable>1</buildingDamageFactorPassable>
    <plantDamageFactor>1</plantDamageFactor>
    <explosionHeatEnergyPerCell>0</explosionHeatEnergyPerCell>
    <explosionCellFleck>Fleck_Vaporize</explosionCellFleck>
    <explosionColorCenter>(1, 0.95, 0.72)</explosionColorCenter>
    <explosionColorEdge>(1, 0.7, 0.28)</explosionColorEdge>
    <soundExplosion>VV_ApocryphaFairyBlast</soundExplosion>
  </DamageDef>
</Defs>
