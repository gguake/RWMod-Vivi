<?xml version="1.0" encoding="UTF-8"?>
<Defs>
  <!-- 요정 비비 결속 -->
  <HediffDef>
    <defName>VV_ApocryphaFairyBond</defName>
    <label>vivi fairy</label>
    <description>The souls of 1,440,000,000 fairy vivis bound to the old empire's last empress form a shield that absorbs all attacks.</description>
    <hediffClass>VVRace.Hediff_ApocryphaFairyBond</hediffClass>
    <defaultLabelColor>(0, 1, 1)</defaultLabelColor>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <scenarioCanAdd>false</scenarioCanAdd>
    <priceImpact>false</priceImpact>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>1</maxSeverity>
  </HediffDef>

  <!-- 고대 엘텍스 바늘 -->
  <HediffDef>
    <defName>VV_ApocryphaStuckNeedle</defName>
    <label>ancient eltex needle</label>
    <description>An ancient eltex needle lodged in the body. The more needles are lodged, the more damage it takes; once all three are lodged, it staggers for a while and then tears them out.</description>
    <hediffClass>VVRace.Hediff_ApocryphaStuckNeedle</hediffClass>
    <defaultLabelColor>(1, 0.42, 0.85)</defaultLabelColor>
    <isBad>true</isBad>
    <everCurableByItem>false</everCurableByItem>
    <scenarioCanAdd>false</scenarioCanAdd>
    <priceImpact>false</priceImpact>
    <initialSeverity>1</initialSeverity>
    <minSeverity>0</minSeverity>
    <maxSeverity>3</maxSeverity>
  </HediffDef>

  <!-- 오염된 영원꽃 동화 -->
  <HediffDef>
    <defName>VV_CorruptedEverflowerAssimilation</defName>
    <label>corrupted everflower assimilation</label>
    <description>Assimilated into everflower mana twisted by Asphodel. Unaffected by toxic environments. On death, the body crumbles into ash and leaves no corpse.</description>
    <hediffClass>VVRace.Hediff_CorruptedEverflowerAssimilation</hediffClass>
    <defaultLabelColor>(0.85, 0.35, 0.75)</defaultLabelColor>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <scenarioCanAdd>false</scenarioCanAdd>
    <priceImpact>false</priceImpact>
    <stages>
      <li>
        <statOffsets>
          <ToxicEnvironmentResistance>1</ToxicEnvironmentResistance>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>
</Defs>
