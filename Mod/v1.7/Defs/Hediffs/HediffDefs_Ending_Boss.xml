<?xml version="1.0" encoding="UTF-8"?>
<Defs>
  <!-- 요정 비비 결속 -->
  <HediffDef>
    <defName>VV_ApocryphaFairyBond</defName>
    <label>fairy vivi bond</label>
    <description>Countless fairy vivis wrap layer upon layer around Asphodel, blocking all attacks.</description>
    <hediffClass>VVRace.Hediff_ApocryphaFairyBond</hediffClass>
    <defaultLabelColor>(0, 1, 1)</defaultLabelColor>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <scenarioCanAdd>false</scenarioCanAdd>
    <priceImpact>false</priceImpact>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <stages>
      <li>
        <statOffsets>
          <MoveSpeed>0.5</MoveSpeed>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <!-- 결의 -->
  <HediffDef>
    <defName>VV_ApocryphaResolve</defName>
    <label>resolve</label>
    <description>Asphodel's resolve toward the salvation of all vivis has hardened. Each stack reduces damage taken, increases her needle damage, and speeds up her needle aiming.</description>
    <hediffClass>VVRace.Hediff_ApocryphaResolve</hediffClass>
    <defaultLabelColor>(1, 0.72, 0.32)</defaultLabelColor>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <scenarioCanAdd>false</scenarioCanAdd>
    <priceImpact>false</priceImpact>
    <initialSeverity>1</initialSeverity>
    <minSeverity>1</minSeverity>
    <maxSeverity>5</maxSeverity>
    <stages>
      <li>
        <minSeverity>1</minSeverity>
        <statFactors>
          <IncomingDamageFactor>0.9</IncomingDamageFactor>
        </statFactors>
      </li>
      <li>
        <minSeverity>2</minSeverity>
        <statFactors>
          <IncomingDamageFactor>0.8</IncomingDamageFactor>
        </statFactors>
      </li>
      <li>
        <minSeverity>3</minSeverity>
        <statFactors>
          <IncomingDamageFactor>0.7</IncomingDamageFactor>
        </statFactors>
      </li>
      <li>
        <minSeverity>4</minSeverity>
        <statFactors>
          <IncomingDamageFactor>0.6</IncomingDamageFactor>
        </statFactors>
      </li>
      <li>
        <minSeverity>5</minSeverity>
        <statFactors>
          <IncomingDamageFactor>0.5</IncomingDamageFactor>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

  <!-- 고대 엘텍스 바늘 -->
  <HediffDef>
    <defName>VV_ApocryphaStuckNeedle</defName>
    <label>ancient eltex needle</label>
    <description>An ancient eltex needle lodged deep in the carapace. The more needles are lodged, the more vulnerable the target becomes, greatly increasing damage taken.</description>
    <hediffClass>VVRace.Hediff_ApocryphaStuckNeedle</hediffClass>
    <defaultLabelColor>(1, 0.42, 0.85)</defaultLabelColor>
    <isBad>true</isBad>
    <everCurableByItem>false</everCurableByItem>
    <scenarioCanAdd>false</scenarioCanAdd>
    <priceImpact>false</priceImpact>
    <initialSeverity>1</initialSeverity>
    <minSeverity>0</minSeverity>
    <maxSeverity>3</maxSeverity>
  </HediffDef>

  <!-- 멸망꽃 환영 -->
  <HediffDef>
    <defName>VV_DoomPhantasm</defName>
    <label>doom bloom phantasm</label>
    <description>A phantasm conjured from the memories within a doom bloom.</description>
    <hediffClass>VVRace.Hediff_DoomPhantasm</hediffClass>
    <defaultLabelColor>(0.85, 0.35, 0.75)</defaultLabelColor>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <scenarioCanAdd>false</scenarioCanAdd>
    <priceImpact>false</priceImpact>
    <stages>
      <li>
        <statOffsets>
          <PainShockThreshold>1</PainShockThreshold>
          <ToxicEnvironmentResistance>1</ToxicEnvironmentResistance>
          <ComfyTemperatureMin>-200</ComfyTemperatureMin>
          <ComfyTemperatureMax>200</ComfyTemperatureMax>
          <IncomingDamageFactor>0.35</IncomingDamageFactor>
        </statOffsets>
        <statFactors>
          <Flammability>0</Flammability>
        </statFactors>
        <hungerRateFactor>0</hungerRateFactor>
      </li>
    </stages>
  </HediffDef>
</Defs>
