<?xml version="1.0" encoding="UTF-8"?>
<Defs>
  <!-- 영원꽃의 축복 -->
  <HediffDef>
    <defName>VV_EverflowerBlessing</defName>
    <label>everflower's blessing</label>
    <description>The blessing of a fully bloomed everflower greatly slows aging in adult vivis. It fades about a day after leaving the everflower's area.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(1, 0.85, 0.4)</defaultLabelColor>

    <isBad>false</isBad>
    <priceImpact>false</priceImpact>
    <scenarioCanAdd>false</scenarioCanAdd>
    <everCurableByItem>false</everCurableByItem>

    <comps>
      <li Class="VVRace.HediffCompProperties_AgingFactor">
        <factor>0.1</factor>
      </li>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>60000~60000</disappearsAfterTicks>
        <showRemainingTime>false</showRemainingTime>
      </li>
    </comps>
  </HediffDef>

  <!-- 영원꽃 완전 동화 -->
  <HediffDef>
    <defName>VV_EverflowerFullAssimilation</defName>
    <label>everflower full assimilation</label>
    <description>One with the everflower, guiding its bloom. Needs and aging are suspended, and no harm can be taken, but the resonator cannot move or take orders.</description>
    <hediffClass>VVRace.Hediff_EverflowerAssimilation</hediffClass>
    <defaultLabelColor>(1, 0.85, 0.4)</defaultLabelColor>
    <isBad>false</isBad>
    <priceImpact>false</priceImpact>
    <scenarioCanAdd>false</scenarioCanAdd>
    <everCurableByItem>false</everCurableByItem>
  </HediffDef>


  <!-- 영원의 여제 -->
  <HediffDef>
    <defName>VV_EverflowerQueen</defName>
    <label>eternal empress</label>
    <description>The queen of a fully bloomed everflower.\n\nAs long as the everflower remains, she returns from it a day after death with all wounds healed.</description>
    <hediffClass>VVRace.Hediff_EverflowerQueen</hediffClass>
    <defaultLabelColor>(1, 0.85, 0.4)</defaultLabelColor>
    <isBad>false</isBad>
    <priceImpact>false</priceImpact>
    <scenarioCanAdd>false</scenarioCanAdd>
    <everCurableByItem>false</everCurableByItem>
    <keepOnBodyPartRestoration>true</keepOnBodyPartRestoration>
    <maxSeverity>1</maxSeverity>
    <initialSeverity>1</initialSeverity>
    <abilities>
      <li>VV_QueenVerdict</li>
      <li>VV_QueenManaBarrier</li>
    </abilities>
  </HediffDef>
</Defs>
