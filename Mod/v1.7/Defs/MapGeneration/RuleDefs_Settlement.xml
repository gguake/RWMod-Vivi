<?xml version="1.0" encoding="UTF-8"?>
<Defs>
  <!-- 포탑 식물밭: 콩뿌리개밭 2, 콘뿌리개밭 1, 건인장밭 1의 비율.
       콩뿌리개밭의 강화 꽃은 바이옴 전용 배치가 있으면 그것을, 없으면 연평균 기온대에 맞는 배치를 쓴다 -->
  <RuleDef>
    <defName>VV_TurretGarden</defName>
    <symbol>vv_turret_garden</symbol>
    <resolvers>
      <!-- 온화: 하늘풀 + 풍년화 -->
      <li Class="VVRace.SymbolResolver_ViviGarden">
        <prefabs>
          <li>VV_ViviGarden_PeaBed</li>
          <li>VV_ViviGarden_PeaBed_Small</li>
        </prefabs>
        <barricade>true</barricade>
        <selectionWeight>2</selectionWeight>
        <tileTemperature>-10~25</tileTemperature>
        <excludeBiomes>
          <li>TropicalRainforest</li>
          <li>TropicalSwamp</li>
          <li MayRequire="Ludeon.RimWorld.Odyssey">Grasslands</li>
          <li>Desert</li>
          <li>ExtremeDesert</li>
          <li MayRequire="Ludeon.RimWorld.Odyssey">Scarlands</li>
        </excludeBiomes>
      </li>
      <!-- 혹한: 서리꽃 + 하늘풀 -->
      <li Class="VVRace.SymbolResolver_ViviGarden">
        <prefabs>
          <li>VV_ViviGarden_PeaBed_Cold</li>
          <li>VV_ViviGarden_PeaBed_Cold_Small</li>
        </prefabs>
        <barricade>true</barricade>
        <selectionWeight>2</selectionWeight>
        <tileTemperature>-9999~-10</tileTemperature>
        <excludeBiomes>
          <li>TropicalRainforest</li>
          <li>TropicalSwamp</li>
          <li MayRequire="Ludeon.RimWorld.Odyssey">Grasslands</li>
          <li>Desert</li>
          <li>ExtremeDesert</li>
          <li MayRequire="Ludeon.RimWorld.Odyssey">Scarlands</li>
        </excludeBiomes>
      </li>
      <!-- 고온: 잔불꽃 + 풍년화 -->
      <li Class="VVRace.SymbolResolver_ViviGarden">
        <prefabs>
          <li>VV_ViviGarden_PeaBed_Hot</li>
          <li>VV_ViviGarden_PeaBed_Hot_Small</li>
        </prefabs>
        <barricade>true</barricade>
        <selectionWeight>2</selectionWeight>
        <tileTemperature>25~9999</tileTemperature>
        <excludeBiomes>
          <li>TropicalRainforest</li>
          <li>TropicalSwamp</li>
          <li MayRequire="Ludeon.RimWorld.Odyssey">Grasslands</li>
          <li>Desert</li>
          <li>ExtremeDesert</li>
          <li MayRequire="Ludeon.RimWorld.Odyssey">Scarlands</li>
        </excludeBiomes>
      </li>
      <!-- 열대·초원: 더워도 잔불꽃 대신 하늘풀 -->
      <li Class="VVRace.SymbolResolver_ViviGarden">
        <prefabs>
          <li>VV_ViviGarden_PeaBed</li>
          <li>VV_ViviGarden_PeaBed_Small</li>
        </prefabs>
        <barricade>true</barricade>
        <selectionWeight>2</selectionWeight>
        <biomes>
          <li>TropicalRainforest</li>
          <li>TropicalSwamp</li>
          <li MayRequire="Ludeon.RimWorld.Odyssey">Grasslands</li>
        </biomes>
      </li>
      <!-- 사막: 풍년화 대신 잔불꽃 -->
      <li Class="VVRace.SymbolResolver_ViviGarden">
        <prefabs>
          <li>VV_ViviGarden_PeaBed_Desert</li>
          <li>VV_ViviGarden_PeaBed_Desert_Small</li>
        </prefabs>
        <barricade>true</barricade>
        <selectionWeight>2</selectionWeight>
        <biomes>
          <li>Desert</li>
          <li>ExtremeDesert</li>
        </biomes>
      </li>
      <!-- 흉터 지대: 잔불꽃 대신 정화초 -->
      <li Class="VVRace.SymbolResolver_ViviGarden">
        <prefabs>
          <li>VV_ViviGarden_PeaBed_Scarlands</li>
          <li>VV_ViviGarden_PeaBed_Scarlands_Small</li>
        </prefabs>
        <barricade>true</barricade>
        <selectionWeight>2</selectionWeight>
        <biomes>
          <li MayRequire="Ludeon.RimWorld.Odyssey">Scarlands</li>
        </biomes>
      </li>
      <li Class="VVRace.SymbolResolver_ViviGarden">
        <prefabs>
          <li>VV_ViviGarden_CornBattery</li>
        </prefabs>
        <barricade>true</barricade>
      </li>
      <li Class="VVRace.SymbolResolver_ViviGarden">
        <prefabs>
          <li>VV_ViviGarden_ShootusLine</li>
        </prefabs>
        <barricade>true</barricade>
        <turretWeapons>
          <li>VV_RepeatingCrossbow</li>
          <li>VV_ViviLongJavelin</li>
        </turretWeapons>
      </li>
    </resolvers>
  </RuleDef>
  
