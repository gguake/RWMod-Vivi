  <RuleDef>
    <defName>VV_HexaRoomCourtyard</defName>
    <symbol>vv_hexa_room_courtyard</symbol>
    <resolvers>
      <!-- 따뜻한 곳: 지붕 없는 흙바닥 꽃밭 -->
      <li Class="VVRace.SymbolResolver_HexaRoomPrefab">
        <prefabs>
          <li>VV_HexaRoom_Courtyard</li>
        </prefabs>
        <noRoof>true</noRoof>
        <floorDef>Soil</floorDef>
        <tileTemperature>10~9999</tileTemperature>
      </li>
      <!-- 추운 곳: 지붕을 씌우고 잔불꽃으로 데운 흙바닥 꽃밭. 방이 데워지기 전인 생성 시점 기온은 따지지 않는다 -->
      <li Class="VVRace.SymbolResolver_HexaRoomPrefab">
        <prefabs>
          <li>VV_HexaRoom_Courtyard_Cold</li>
        </prefabs>
        <floorDef>Soil</floorDef>
        <ignoreGrowthSeason>true</ignoreGrowthSeason>
        <tileTemperature>-9999~10</tileTemperature>
      </li>
    </resolvers>
  </RuleDef>

