<?xml version="1.0" encoding="UTF-8"?>
<Defs>
  <!-- 정찰 비비가 유인통 냄새를 맡는다 -->
  <JobDef>
    <defName>VV_ViviInspectLure</defName>
    <driverClass>VVRace.JobDriver_ViviInspectLure</driverClass>
    <reportString>sniffing TargetA.</reportString>
    <casualInterruptible>false</casualInterruptible>
  </JobDef>

  <!-- 둥지 비비가 들고 온 짐을 둥지 보관 칸에 푼다 -->
  <JobDef>
    <defName>VV_ViviNestUnload</defName>
    <driverClass>VVRace.JobDriver_ViviNestUnload</driverClass>
    <reportString>unloading supplies.</reportString>
  </JobDef>

  <!-- 둥지 비비가 비옥한 흙을 파서 마나 비료를 만든다 -->
  <JobDef>
    <defName>VV_ViviNestDigFertilizer</defName>
    <driverClass>VVRace.JobDriver_ViviNestDigFertilizer</driverClass>
    <reportString>digging soil for mana fertilizer.</reportString>
  </JobDef>

  <!-- 둥지 비비가 둥지 방의 빈 지붕을 얹는다(바닐라 지붕 짓기는 플레이어 지붕 구역만 본다) -->
  <JobDef>
    <defName>VV_ViviNestBuildRoof</defName>
    <driverClass>VVRace.JobDriver_ViviNestBuildRoof</driverClass>
    <reportString>building roof.</reportString>
    <allowOpportunisticPrefix>true</allowOpportunisticPrefix>
  </JobDef>

  <!-- 둥지 비비가 저장 마나가 낮은 둥지 마법식물에 둥지 몫 마나 비료를 준다(바닐라 연료 보충과 같은 설정) -->
  <JobDef>
    <defName>VV_ViviNestFertilizePlant</defName>
    <driverClass>VVRace.JobDriver_ViviNestFertilizePlant</driverClass>
    <reportString>fertilizing TargetA.</reportString>
    <suspendable>false</suspendable>
    <allowOpportunisticPrefix>true</allowOpportunisticPrefix>
  </JobDef>

  <!-- 둥지 비비가 꽃·나무 곁에서 그 자리에서 꿀·꽃가루·프로폴리스를 채취한다(기존 채집 레시피 규칙, 채집 장소 없음). 채취물은 바닥에 둥지 몫으로 떨어뜨린다 -->
  <JobDef>
    <defName>VV_ViviNestGatherHoney</defName>
    <driverClass>VVRace.JobDriver_ViviNestGather</driverClass>
    <reportString>gathering honey from TargetA.</reportString>
    <allowOpportunisticPrefix>true</allowOpportunisticPrefix>
    <ifFlyingKeepFlying>true</ifFlyingKeepFlying>
  </JobDef>

  <JobDef>
    <defName>VV_ViviNestGatherPollen</defName>
    <driverClass>VVRace.JobDriver_ViviNestGather</driverClass>
    <reportString>gathering pollen from TargetA.</reportString>
    <allowOpportunisticPrefix>true</allowOpportunisticPrefix>
    <ifFlyingKeepFlying>true</ifFlyingKeepFlying>
  </JobDef>

  <JobDef>
    <defName>VV_ViviNestGatherPropolis</defName>
    <driverClass>VVRace.JobDriver_ViviNestGather</driverClass>
    <reportString>gathering propolis from TargetA.</reportString>
    <allowOpportunisticPrefix>true</allowOpportunisticPrefix>
    <ifFlyingKeepFlying>true</ifFlyingKeepFlying>
  </JobDef>

  <!-- 곰·말벌이 유인통 미끼를 먹어 치운다 -->
  <JobDef>
    <defName>VV_DevourBait</defName>
    <driverClass>VVRace.JobDriver_DevourBait</driverClass>
    <reportString>devouring the bait on TargetA.</reportString>
  </JobDef>
</Defs>
