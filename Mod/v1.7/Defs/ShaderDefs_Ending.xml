<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 1.7(Waylith)은 각 로드 폴더의 Shaders 폴더에서 GLSL 원본을 읽어 실행 중에 컴파일한다(Verse.ShaderDefRegistry).
       파일 이름은 모든 모드에서 공유되므로 VV_ 접두사를 붙인다. 정점 셰이더는 바닐라 Mote.vert.glsl을 재사용한다. -->

  <!-- 아스포델 소멸: 노이즈 디졸브 + 황금 불씨 테두리 (알파 혼합) -->
  <ShaderDef>
    <defName>VV_Dissolve</defName>
    <shaderProgram>
      <vertexShaderFileName>Mote.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>VV_Dissolve.frag.glsl</fragmentShaderFileName>
      <transparent>true</transparent>
      <depthWrite>false</depthWrite>
      <cullMode>None</cullMode>
      <renderQueue>3000</renderQueue>
    </shaderProgram>
  </ShaderDef>

  <ShaderTypeDef>
    <defName>VV_Dissolve</defName>
    <shaderPath>Map/VV_Dissolve</shaderPath>
  </ShaderTypeDef>

  <!-- 아스포델 등장: 검은 에너지가 몸 중심에서 바깥으로 형체를 빚고 본래 색이 드러난다(알파 혼합, ApocryphaManifestation이 직접 그린다) -->
  <ShaderDef>
    <defName>VV_Manifest</defName>
    <shaderProgram>
      <vertexShaderFileName>Mote.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>VV_Manifest.frag.glsl</fragmentShaderFileName>
      <transparent>true</transparent>
      <depthWrite>false</depthWrite>
      <cullMode>None</cullMode>
      <renderQueue>3000</renderQueue>
    </shaderProgram>
  </ShaderDef>

  <ShaderTypeDef>
    <defName>VV_Manifest</defName>
    <shaderPath>Map/VV_Manifest</shaderPath>
  </ShaderTypeDef>

  <!-- 영혼 연결 빔: 타일링 텍스처 두 겹 스크롤 + 맥동 (가산 혼합)
       충격파(VV_ShockWave)의 장면 캡처(큐 3151) 전에 그려야 파면에 함께 굴절되고 덮여 지워지지 않으므로 큐를 3150으로 둔다. -->
  <ShaderDef>
    <defName>VV_SoulLink</defName>
    <shaderProgram>
      <vertexShaderFileName>Mote.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>VV_SoulLink.frag.glsl</fragmentShaderFileName>
      <flipTextureST>false</flipTextureST>
      <blendMode>Additive</blendMode>
      <depthWrite>false</depthWrite>
      <cullMode>None</cullMode>
      <renderQueue>3150</renderQueue>
      <textureWrapOverrides>
        <li>
          <key>_MainTex</key>
          <value>Repeat</value>
        </li>
      </textureWrapOverrides>
    </shaderProgram>
  </ShaderDef>

  <ShaderTypeDef>
    <defName>VV_SoulLink</defName>
    <shaderPath>Map/VV_SoulLink</shaderPath>
  </ShaderTypeDef>

  <!-- 아스포델 연결선(멸망꽃·요정꽃·요정 간섭): 두 가닥 나선을 따라 꽃잎이 흩날리며 흐른다(가산 혼합).
       꽃잎 그림 한 장(_MainTex)을 셰이더가 돌려 가며 찍는다. 영혼 연결 빔과 같은 이유로 큐를 장면 캡처(3151)보다 앞인 3150으로 둔다. -->
  <ShaderDef>
    <defName>VV_PetalLink</defName>
    <shaderProgram>
      <vertexShaderFileName>Mote.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>VV_PetalLink.frag.glsl</fragmentShaderFileName>
      <flipTextureST>false</flipTextureST>
      <blendMode>Additive</blendMode>
      <depthWrite>false</depthWrite>
      <cullMode>None</cullMode>
      <renderQueue>3150</renderQueue>
    </shaderProgram>
  </ShaderDef>

  <ShaderTypeDef>
    <defName>VV_PetalLink</defName>
    <shaderPath>Map/VV_PetalLink</shaderPath>
  </ShaderTypeDef>

  <!-- 요정 간섭 비비의 일렁이는 빛: 텍스처 없이 수식으로 몸을 감싸 피어오르는 빛 자락과 물결 같은 반짝임을 그린다(가산 혼합, 유지형 부착 모트). -->
  <ShaderDef>
    <defName>VV_LightShimmer</defName>
    <shaderProgram>
      <vertexShaderFileName>Mote.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>VV_LightShimmer.frag.glsl</fragmentShaderFileName>
      <flipTextureST>false</flipTextureST>
      <blendMode>Additive</blendMode>
      <depthWrite>false</depthWrite>
      <cullMode>None</cullMode>
      <renderQueue>3150</renderQueue>
    </shaderProgram>
  </ShaderDef>

  <ShaderTypeDef>
    <defName>VV_LightShimmer</defName>
    <shaderPath>Map/VV_LightShimmer</shaderPath>
  </ShaderTypeDef>

  <!-- 충격파: 텍스처 없이 수식으로 파면·잔광·전기 줄기를 그리고 장면 캡처를 굴절시킨다(크기와 무관하게 선명).
       장면 캡처는 바닐라 왜곡 셰이더(MoteLargeDistortionWave)와 같은 이름·큐를 사용하므로 프레임당 한 번만 수행한다. -->
  <ShaderDef>
    <defName>VV_ShockWave</defName>
    <shaderProgram>
      <vertexShaderFileName>Mote.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>VV_ShockWave.frag.glsl</fragmentShaderFileName>
      <flipTextureST>false</flipTextureST>
      <transparent>true</transparent>
      <depthWrite>false</depthWrite>
      <cullMode>None</cullMode>
      <renderQueue>3151</renderQueue>
      <sceneGrab>
        <name>DistortionBackground</name>
        <queue>3151</queue>
      </sceneGrab>
    </shaderProgram>
  </ShaderDef>

  <ShaderTypeDef>
    <defName>VV_ShockWave</defName>
    <shaderPath>Map/VV_ShockWave</shaderPath>
  </ShaderTypeDef>

  <!-- 아스포델 2페이즈 전환 모핑: 1페이즈 몸이 꿈틀거리며 2페이즈 몸으로 뒤바뀐다(알파 혼합, 몸통 렌더 노드의 재질을 대신한다) -->
  <ShaderDef>
    <defName>VV_Morph</defName>
    <shaderProgram>
      <vertexShaderFileName>Mote.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>VV_Morph.frag.glsl</fragmentShaderFileName>
      <transparent>true</transparent>
      <depthWrite>false</depthWrite>
      <cullMode>None</cullMode>
      <renderQueue>3000</renderQueue>
    </shaderProgram>
  </ShaderDef>

  <ShaderTypeDef>
    <defName>VV_Morph</defName>
    <shaderPath>Map/VV_Morph</shaderPath>
  </ShaderTypeDef>

  <!-- 사출 포격 조준 표식: 텍스처 없이 수식으로 바깥 고리와 피어나는 연꽃(요정꽃 모양)을 그린다(가산 혼합).
       영혼 연결 빔과 같은 이유로(멸망꽃 사출 충격파에 함께 굴절되도록) 큐를 장면 캡처(3151)보다 앞인 3150으로 둔다. -->
  <ShaderDef>
    <defName>VV_MagicCircle</defName>
    <shaderProgram>
      <vertexShaderFileName>Mote.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>VV_MagicCircle.frag.glsl</fragmentShaderFileName>
      <flipTextureST>false</flipTextureST>
      <blendMode>Additive</blendMode>
      <depthWrite>false</depthWrite>
      <cullMode>None</cullMode>
      <renderQueue>3150</renderQueue>
    </shaderProgram>
  </ShaderDef>

  <ShaderTypeDef>
    <defName>VV_MagicCircle</defName>
    <shaderPath>Map/VV_MagicCircle</shaderPath>
  </ShaderTypeDef>

  <!-- 거대 엘텍스 바늘 조준 경고 띠: 텍스처 없이 수식으로 발사 직선 전체·차오르는 진행도·흐르는 갈매기 무늬를 그린다(가산 혼합).
       조준 연꽃 표식과 같은 이유로 큐를 장면 캡처(3151)보다 앞인 3150으로 둔다. -->
  <ShaderDef>
    <defName>VV_NeedleLane</defName>
    <shaderProgram>
      <vertexShaderFileName>Mote.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>VV_NeedleLane.frag.glsl</fragmentShaderFileName>
      <flipTextureST>false</flipTextureST>
      <blendMode>Additive</blendMode>
      <depthWrite>false</depthWrite>
      <cullMode>None</cullMode>
      <renderQueue>3150</renderQueue>
    </shaderProgram>
  </ShaderDef>

  <ShaderTypeDef>
    <defName>VV_NeedleLane</defName>
    <shaderPath>Map/VV_NeedleLane</shaderPath>
  </ShaderTypeDef>

  <!-- 거대 엘텍스 바늘 발사 왜곡: 촉이 지나간 직선 위의 장면 캡처를 순간 일그러뜨린다. 바닐라 사이캐스트 사이킥 선의 마스크·노이즈·그림을 써서
       바닐라 왜곡과 같은 질감으로 일그러진다(텍스처는 ApocryphaNeedleRenderer가 넣는다). 바닐라 큰 왜곡 파동과 같은 장면 캡처 이름·큐를 써서 프레임당 한 번만 캡처. -->
  <ShaderDef>
    <defName>VV_NeedleWarp</defName>
    <shaderProgram>
      <vertexShaderFileName>Mote.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>VV_NeedleWarp.frag.glsl</fragmentShaderFileName>
      <flipTextureST>false</flipTextureST>
      <transparent>true</transparent>
      <depthWrite>false</depthWrite>
      <cullMode>None</cullMode>
      <renderQueue>3151</renderQueue>
      <sceneGrab>
        <name>DistortionBackground</name>
        <queue>3151</queue>
      </sceneGrab>
      <textureWrapOverrides>
        <li>
          <key>_NoiseTex</key>
          <value>Repeat</value>
        </li>
      </textureWrapOverrides>
    </shaderProgram>
  </ShaderDef>

  <ShaderTypeDef>
    <defName>VV_NeedleWarp</defName>
    <shaderPath>Map/VV_NeedleWarp</shaderPath>
  </ShaderTypeDef>

  <!-- 가산 빛(MoteGlow, 큐 3151) 위에 그리는 알파 그림: 바닐라 TransparentPostLight와 같은 셰이더를 큐만 늦춘다.
       요정 비비 사출탄의 요정이 혜성 꼬리·후광·반짝임에 덮여 하얗게 바래지 않게 한다. -->
  <ShaderDef>
    <defName>VV_TransparentOverGlow</defName>
    <shaderProgram>
      <vertexShaderFileName>Mote.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>TransparentPostLight.frag.glsl</fragmentShaderFileName>
      <transparent>true</transparent>
      <depthWrite>false</depthWrite>
      <renderQueue>3152</renderQueue>
    </shaderProgram>
  </ShaderDef>

  <ShaderTypeDef>
    <defName>VV_TransparentOverGlow</defName>
    <shaderPath>Map/VV_TransparentOverGlow</shaderPath>
  </ShaderTypeDef>
</Defs>
