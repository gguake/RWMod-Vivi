<?xml version="1.0" encoding="UTF-8"?>
<Defs>
  <DutyDef>
    <defName>VV_DefendViviBase</defName>
    <alwaysShowWeapon>false</alwaysShowWeapon>
    <thinkNode Class="ThinkNode_Priority">
      <subNodes>
        <li Class="JobGiver_TakeCombatEnhancingDrug">
          <onlyIfInDanger>true</onlyIfInDanger>
        </li>
        <li Class="JobGiver_AIDefendPoint">
          <targetAcquireRadius>28</targetAcquireRadius>
          <targetKeepRadius>35</targetKeepRadius>
        </li>

        <li Class="ThinkNode_ForbidOutsideFlagRadius">
          <maxDistToSquadFlag>20</maxDistToSquadFlag>
          <subNodes>
            <li Class="ThinkNode_Subtree">
              <treeDef>SatisfyBasicNeeds</treeDef>
            </li>
          </subNodes>
        </li>

        <li Class="JobGiver_SeekSafeTemperature" />

        <li Class="ThinkNode_ConditionalCloseToDutyTarget">
          <maxDistToDutyTarget>28</maxDistToDutyTarget>
          <subNodes>
            <li Class="JobGiver_FightFiresNearPoint">
              <maxDistFromPoint>28</maxDistFromPoint>
            </li>
    
            <li Class="VVRace.JobGiver_FixDamagedNearPoint">
              <maxDistFromPoint>28</maxDistFromPoint>
            </li>
            
            <li Class="JobGiver_WanderAnywhere">
              <wanderRadius>28</wanderRadius>
            </li>
          </subNodes>
        </li>

        <li Class="JobGiver_WanderNearDutyLocation">
          <locomotionUrgencyOutsideRadius>Sprint</locomotionUrgencyOutsideRadius>
        </li>
      </subNodes>
    </thinkNode>
  </DutyDef>
  
  <DutyDef>
    <defName>VV_TitanicHornetAssault</defName>
    <thinkNode Class="ThinkNode_Priority">
      <subNodes>
        <li Class="ThinkNode_HarmedRecently">
          <thresholdTicks>600</thresholdTicks>
          <subNodes>
            <li Class="JobGiver_AIFightEnemies"> <!-- respond if attacked -->
              <targetAcquireRadius>65</targetAcquireRadius>
              <targetKeepRadius>72</targetKeepRadius>
              <needLOSToAcquireNonPawnTargets>true</needLOSToAcquireNonPawnTargets>
            </li>
          </subNodes>
        </li>
        <li Class="JobGiver_AIFightEnemies">
          <targetAcquireRadius>12</targetAcquireRadius>
          <targetKeepRadius>15</targetKeepRadius>
        </li>
        <li Class="JobGiver_AIBreaching" />
        <li Class="JobGiver_AIFightEnemies">
          <targetAcquireRadius>65</targetAcquireRadius>
          <targetKeepRadius>72</targetKeepRadius>
        </li>
        <li Class="JobGiver_AITrashColonyClose" />
        <li Class="JobGiver_AITrashBuildingsDistant" />
        <li Class="JobGiver_AIGotoNearestHostile">
          <overrideExpiryInterval>60</overrideExpiryInterval>
        </li>
        <!-- 광폭 상태의 세력 없는 말벌은 위 노드가 정착민을 찾지 못한다 -->
        <li Class="VVRace.JobGiver_HornetGotoColony" />
        <li Class="JobGiver_AITrashBuildingsDistant">
          <attackAllInert>true</attackAllInert>
        </li>
      </subNodes>
    </thinkNode>
  </DutyDef>
  
  <DutyDef>
    <defName>VV_DeliverPawnToEverflower</defName>
    <hook>HighPriority</hook>
    <socialModeMax>Off</socialModeMax>
    <thinkNode Class="ThinkNode_Priority">
      <subNodes>
        <!-- Goto pawn -->
        <li Class="VVRace.JobGiver_DeliverPawnToEverflower">
          <exactCell>true</exactCell>
          <locomotionUrgency>Jog</locomotionUrgency>
        </li>
      </subNodes>
    </thinkNode>
  </DutyDef>

  <DutyDef>
    <defName>VV_TeleportEverflower</defName>
    <hook>HighPriority</hook>
    <socialModeMax>Off</socialModeMax>
    <thinkNode Class="ThinkNode_Priority">
      <subNodes>
        <!-- Goto pawn -->
        <li Class="VVRace.JobGiver_DeliverPawnToEverflower">
          <exactCell>true</exactCell>
          <locomotionUrgency>Jog</locomotionUrgency>
        </li>
      </subNodes>
    </thinkNode>
  </DutyDef>

  <!-- 비비 양봉: 정찰 비비 둘러보기 -->
  <DutyDef>
    <defName>VV_ViviLureScout</defName>
    <thinkNode Class="ThinkNode_Priority">
      <subNodes>
        <li Class="ThinkNode_Subtree">
          <treeDef>SatisfyVeryUrgentNeeds</treeDef>
        </li>
        <li Class="VVRace.JobGiver_ViviLureInspect" />
        <li Class="JobGiver_WanderNearDutyLocation">
          <wanderRadius>8</wanderRadius>
        </li>
      </subNodes>
    </thinkNode>
  </DutyDef>

  <!-- 비비 양봉: 곰·말벌이 미끼를 먹어 치움 -->
  <DutyDef>
    <defName>VV_ViviBaitThief</defName>
    <thinkNode Class="ThinkNode_Priority">
      <subNodes>
        <li Class="VVRace.JobGiver_DevourBait" />
        <li Class="JobGiver_WanderNearDutyLocation">
          <wanderRadius>4</wanderRadius>
        </li>
      </subNodes>
    </thinkNode>
  </DutyDef>

  <!-- 비비 양봉: 둥지 생활. 식사는 바닐라 그대로(금지 패치로 둥지 음식만 보인다), 잠은 밤에 둥지 방에서 -->
  <DutyDef>
    <defName>VV_ViviNestLife</defName>
    <!-- 위협: 하던 일을 끊고 바로 반응하도록 상시 노드에 둔다. 무장 비비는 둥지 둘레(듀티 반경)의 적과 싸우고, 나머지는 둥지 방으로 피한다 -->
    <constantThinkNode Class="ThinkNode_Priority">
      <subNodes>
        <li Class="VVRace.JobGiver_ViviNestDefend" />
        <li Class="VVRace.JobGiver_ViviNestTakeShelter" />
      </subNodes>
    </constantThinkNode>
    <thinkNode Class="ThinkNode_Priority">
      <subNodes>
        <li Class="JobGiver_FightFiresNearPoint">
          <maxDistFromPoint>24</maxDistFromPoint>
        </li>
        <li Class="ThinkNode_Tagger">
          <tagToGive>SatisfyingNeeds</tagToGive>
          <subNodes>
            <li Class="ThinkNode_PrioritySorter">
              <subNodes>
                <li Class="JobGiver_GetFood" />
                <li Class="VVRace.JobGiver_ViviNestRest" />
                <!-- 알 낳기(기존 잡 기버): 식량이 넉넉하고 새 알까지 방 수용량 안이거나 증축할 자리가 있을 때만 -->
                <li Class="VVRace.JobGiver_ViviNestLayEgg" />
              </subNodes>
            </li>
          </subNodes>
        </li>
        <li Class="VVRace.JobGiver_ViviNestUnload" />
        <!-- 저체온·열사병이면 일보다 먼저 편한 기온의 둥지 방으로 피한다(잠은 편한 기온의 방에서 자고, 배고프면 먼저 먹는다) -->
        <li Class="VVRace.JobGiver_ViviNestSeekSafeTemperature" />
        <li Class="ThinkNode_ForbidOutsideFlagRadius">
          <maxDistToSquadFlag>24</maxDistToSquadFlag>
          <subNodes>
            <!-- 쓰러진 구성원은 다른 일보다 먼저 편한 기온의 둥지 방으로 옮긴다(바깥에 두면 겨울에 얼어 죽는다) -->
            <li Class="VVRace.JobGiver_ViviNestRescue" />
            <!-- 시체는 썩으면 악취 가스로 폐부패를 일으키므로 다른 일보다 먼저 둥지 밖으로 옮긴다 -->
            <li Class="VVRace.JobGiver_ViviNestRemoveCorpse" />
            <!-- 다친 구성원 치료(쓰러졌거나 누운 환자, 둥지 몫 약이 있으면 쓴다) -->
            <li Class="VVRace.JobGiver_ViviNestTend" />
            <!-- 쓰러진 배고픈 구성원(아기 제외)에게 둥지 몫 음식을 먹인다(바닐라 환자 먹이기 잡) -->
            <li Class="VVRace.JobGiver_ViviNestFeedPatient" />
            <li Class="VVRace.JobGiver_ViviNestChildcare">
              <royal>true</royal>
            </li>
            <!-- 저장 마나가 절반 아래인 둥지 마법식물에 둥지 몫 비료를 준다. 겨울 잔불꽃처럼 생존이 걸린 일이라 운반·건설·생산보다 먼저 한다 -->
            <li Class="VVRace.JobGiver_ViviNestFertilizePlant" />
            <li Class="VVRace.JobGiver_ViviNestHaul" />
            <li Class="VVRace.JobGiver_ViviNestDress" />
            <li Class="VVRace.JobGiver_ViviNestBuild" />
            <li Class="VVRace.JobGiver_ViviNestRefuel" />
            <li Class="VVRace.JobGiver_ViviNestPlantSeed" />
            <!-- 채집·나무 베기·땅 비료·제작은 보유량이 목표에 비해 가장 모자란 일부터(각 잡 기버의 우선도), 못 하면 다음 것 -->
            <li Class="ThinkNode_PrioritySorter">
              <subNodes>
                <li Class="VVRace.JobGiver_ViviNestGather" />
                <li Class="VVRace.JobGiver_ViviNestCutTree" />
                <li Class="VVRace.JobGiver_ViviNestDigFertilizer" />
                <li Class="VVRace.JobGiver_ViviNestCraft" />
                <li Class="VVRace.JobGiver_ViviNestHarvestHealroot" />
              </subNodes>
            </li>
            <li Class="VVRace.JobGiver_ViviNestGarden" />
            <li Class="VVRace.JobGiver_ViviNestChildcare" />
            <li Class="VVRace.JobGiver_ViviNestSmoothWall" />
            <!-- 놀이(한가할 때, 낮에만): 편자 막대 놀이(바깥이 편할 때)·낮잠(졸릴 때)·빈둥거리기 중 하나를 섞어 고른다. 하던 놀이는 놀이 시간 동안 이어 하고 600틱마다 다시 생각해 일이 생기면 넘어간다 -->
            <li Class="VVRace.ThinkNode_ViviNestPlay">
              <subNodes>
                <li Class="VVRace.JobGiver_ViviNestHorseshoes" />
                <li Class="VVRace.JobGiver_ViviNestNap" />
                <li Class="VVRace.JobGiver_ViviNestLoaf" />
              </subNodes>
            </li>
          </subNodes>
        </li>
        <li Class="VVRace.JobGiver_ViviNestWander" />
      </subNodes>
    </thinkNode>
  </DutyDef>

  <!-- 둥지를 떠나는 비비: 어른은 아기를 안고 나가고, 나머지는 맵 가장자리로 나간다 -->
  <DutyDef>
    <defName>VV_ViviNestExit</defName>
    <thinkNode Class="ThinkNode_Priority">
      <subNodes>
        <li Class="VVRace.JobGiver_ViviNestCarryBabyOut" />
        <li Class="JobGiver_ExitMapBest">
          <defaultLocomotion>Walk</defaultLocomotion>
          <canFlyOutOfMap>false</canFlyOutOfMap>
        </li>
      </subNodes>
    </thinkNode>
  </DutyDef>

  <!-- 거대 말벌 아스포델 호위 -->
  <DutyDef>
    <defName>VV_TitanicHornetEscort</defName>
    <thinkNode Class="ThinkNode_Priority">
      <subNodes>
        <li Class="JobGiver_AIFollowEscortee" />
        <li Class="JobGiver_WanderNearDutyLocation">
          <wanderRadius>8</wanderRadius>
        </li>
      </subNodes>
    </thinkNode>
  </DutyDef>

  <!-- 거대 말벌 꽃 경비 -->
  <DutyDef>
    <defName>VV_TitanicHornetFlowerGuard</defName>
    <thinkNode Class="ThinkNode_Priority">
      <subNodes>
        <li Class="JobGiver_WanderNearDutyLocation">
          <wanderRadius>4</wanderRadius>
          <locomotionUrgencyOutsideRadius>Jog</locomotionUrgencyOutsideRadius>
        </li>
      </subNodes>
    </thinkNode>
  </DutyDef>
</Defs>
