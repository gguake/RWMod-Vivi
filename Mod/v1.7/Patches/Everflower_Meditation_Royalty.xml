<?xml version="1.0" encoding="UTF-8"?>
<Patch>
  <Operation Class="PatchOperationSequence">
    <operations>
      <li Class="PatchOperationSequence" MayRequire="Ludeon.RimWorld.Royalty">
        <operations>
          <!-- 영원꽃 명상 초점: 공명 레벨에 따른 기본 강도 + 공명자 보너스 -->
          <li Class="PatchOperationAdd">
            <xpath>Defs/ThingDef[defName="VV_Everflower"]/statBases</xpath>
            <value>
              <MeditationFocusStrength>0</MeditationFocusStrength>
            </value>
          </li>
          <li Class="PatchOperationAdd">
            <xpath>Defs/ThingDef[defName="VV_Everflower"]/comps</xpath>
            <value>
              <li Class="CompProperties_MeditationFocus">
                <statDef>MeditationFocusStrength</statDef>
                <focusTypes>
                  <li>Natural</li>
                </focusTypes>
                <offsets>
                  <li Class="VVRace.FocusStrengthOffset_EverflowerLevel">
                    <curve>
                      <points>
                        <li>(0, 0.04)</li>
                        <li>(1, 0.06)</li>
                        <li>(2, 0.09)</li>
                        <li>(3, 0.12)</li>
                        <li>(4, 0.16)</li>
                        <li>(5, 0.20)</li>
                        <li>(6, 0.25)</li>
                      </points>
                    </curve>
                  </li>
                  <li Class="VVRace.FocusStrengthOffset_EverflowerResonator">
                    <curve>
                      <points>
                        <li>(0, 0)</li>
                        <li>(1, 0.12)</li>
                        <li>(2, 0.16)</li>
                        <li>(3, 0.20)</li>
                        <li>(4, 0.24)</li>
                        <li>(5, 0.28)</li>
                        <li>(6, 0.32)</li>
                      </points>
                    </curve>
                  </li>
                </offsets>
              </li>
            </value>
          </li>
        </operations>
      </li>
    </operations>
  </Operation>
</Patch>
