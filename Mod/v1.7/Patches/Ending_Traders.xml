<?xml version="1.0" encoding="UTF-8"?>
<Patch>
  <!-- 엔딩: 비비 연방의 기지·캐러밴 상인이 고대 호박 코어를 조건부로 판다.
       연방의 서신을 받은 뒤, 엔딩이 끝나지 않았고 정착지에 코어·제단(청사진/프레임 포함)이 없을 때만 재고에 오른다(VVRace.StockGenerator_ViviEndingRelic). -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/TraderKindDef[defName="VV_Base_Vivi_Standard" or defName="VV_Caravan_Vivi_Honeys" or defName="VV_Caravan_Vivi_Gardening"]/stockGenerators</xpath>
    <value>
      <li Class="VVRace.StockGenerator_ViviEndingRelic">
        <thingDef>VV_AncientAmberCore</thingDef>
        <countRange>1~1</countRange>
        <price>Expensive</price>
      </li>
    </value>
  </Operation>
</Patch>
